{
  "id": "summit-lexicon",
  "version": "0.1.0",
  "updated": "2026-09-13",
  "note": "The published formula behind every derived tag in the graph. Each entry is a case-insensitive regular expression run over the prose of a speaker's own page on the event site (the frozen copy, the Bio paragraph only: the event's Topics list and the boilerplate below it are excluded). A match creates an edge from the person to the tag node and records the MATCHED WORDS on the edge, never the sentence. A tag therefore says one thing: that the page contains these words. It is not a characterisation of the person, and the gate re-runs every pattern against the frozen bytes on every build.",
  "runs_over": "the <h2>Bio</h2> block of sources/frozen/<date>/speakers/<id>.snapshot, tags stripped, whitespace collapsed",
  "flags": "IGNORECASE",
  "types": {
    "Industry":   {"verb": "active_in", "pt": "Setor"},
    "Technology": {"verb": "uses",      "pt": "Tecnologia"},
    "Idea":       {"verb": "advocates", "pt": "Ideia"},
    "Service":    {"verb": "offers",    "pt": "Serviço"},
    "Product":    {"verb": "offers",    "pt": "Produto"}
  },
