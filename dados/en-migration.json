{
  "id": "pt-migracao-en",
  "versao": "1.0.0",
  "nota": "The map from this repository's Portuguese backend vocabulary to English. It is data, and published, because the repository's own rule is that a classification is a published formula or it does not happen. NOTHING HAS BEEN RENAMED YET: applying this map requires changes to three files an agent here may not edit. See `bloqueado` below.",
  "porque": "The data layer has to be language-neutral so that more than one language edition can share it. A Portuguese key is fine while there is one edition and wrong the moment there are two — and this publication intends more. What a reader SEES stays Portuguese; the vocabulary the machinery uses to talk about it becomes English.",
  "aplica_se_a": [
    "dados/**/*.json",
    "api/v1/**/*.json",
    "build/*.py",
    "assets/**/*.js",
    "admin/build/*.mjs"
  ],
  "pastas": {
    "dados": "data",
    "fontes": "sources",
    "fontes/congeladas": "sources/frozen",
    "fontes/transferidas": "sources/transferred",
    "seccoes": "sections",
    "redacao/runs": "newsroom/runs",
    "redacao/correio": "newsroom/mail",
    "redacao/entregas": "newsroom/deliveries",
    "redacao/revisoes": "newsroom/reviews",
    "redacao/decisoes": "newsroom/decisions",
    "redacao/issues": "newsroom/issues"
  },
  "nao_se_aplica": {
    "nota": "These stay Portuguese, and each for a stated reason rather than by omission.",
    "urls_do_leitor": "artigos/, entidades/, empresas/, protagonistas/, instituicoes/, politicas/, casos-de-uso/, codigo-aberto/, diaspora/, eventos/, registo/, grafo/, aviso/, metodo/ — a visitor reads these in the address bar. In a multilingual future they are the PORTUGUESE edition's paths, and a French edition would have its own; translating them now would not help that and would break every published link. And redacao/ itself: redacao/index.html is the newsroom-floor page, served at /redacao/ in Portuguese. Its BACKEND subfolders move to newsroom/; the page does not. The two living side by side is correct rather than untidy — one is a Portuguese edition's address, the other is where the machinery keeps its records.",
    "verbos_da_ontologia": "fala_em, publicada_por and every other edge verb, with their leitura and leitura_inversa. CLAUDE.md rule 6: the graph reads aloud IN PORTUGUESE, and a verb is the sentence a reader hears. The FIELD NAMES around them move; the verbs do not.",
    "tipos_de_entidade": "Pessoa, Organizacao, Instituicao, Evento, Local, Palco, Tema, Tecnologia, Setor, Produto, Servico, Ideia — they appear in reader-facing URLs under entidades/.",
    "valores": "Every value in every file. This map renames the vocabulary, never the content: a name, a title, an excerpt, a tag label and a frozen byte are untouched.",
    "estados": "procurado, rascunho, verificado, publicado, disputada, confirmada, nao_encontrada — a reader sees these words on the page. Note `superseded`, which is English among them and is the one genuine inconsistency; it is the editor's to settle."
  },
  "bloqueado": {
    "nota": "THIS MIGRATION CANNOT BE RUN BY AN AGENT WORKING IN THIS REPOSITORY. build/gates.py and build/entregas.py are in the deny list of .claude/settings.json — an agent that can edit the gate that stops it has no gate — and both hardcode the backend folder names AND the keys below. Renaming without changing them turns the build permanently red through files no agent here may fix.",
    "ficheiros": [
      "build/gates.py",
      "build/entregas.py",
      "dados/aviso.json"
    ],
