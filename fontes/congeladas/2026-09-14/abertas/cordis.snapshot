</div>

<script type="application/json">
{
    "service": "etrans",
    "renderTo": "#etrans-here",
    "languages": {
        "exclude": [
            "en"
        ]
    },
    "renderAs": {
        "icon": false,
        "link": false,
        "button": false
    },
    "config": {
       "targets": {
            "receiver": "#customReceiver"
        },
        "mode": "lc2023"
    },
    "hidden": false,
    "lang": "en"
}
</script>
