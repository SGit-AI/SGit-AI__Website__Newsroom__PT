escription&q;:&q;Explore as iniciativas e projetos de Inteligência Artificial que estão a impulsionar a transformação digital em Portugal.&q;,&q;indexTitle&q;:&q;Nesta página&q;},{&q;schemaId&q;:&q;8dab2215-8884-492d-bfce-3e838f1c24d3&q;,&q;schemaName&q;:&q;FeaturedNewComponent&q;,&q;label&q;:&q;Destaques&q;,&q;title&q;:null,&q;articles&q;:[{&q;title&q;:&q;Novas regras de transparência para a Inteligência Artificia&q;,&q;date&q;:&q;2026-09-01T00:00:00Z&q;,&q;readingTime&q;:5,&q;url&q;:&q;pt/noticias/novas-regras-de-transparencia-ia&q;,&q;buttonText&q;:&q;Saiba mais&q;,&q;newWindow&q;:false,&q;category&q;:[],&q;summary&q;:&q;As obrigações de transparência do Regulamento de IA já são aplicáveis.&q;,&q;image&q;:[{&q;id&q;:&q;f91d00db-0d69-4524-b799-fcec5f31fdd6&q;,&q;mimeType&q;:&q;image/jpeg&q;,&q;url&q;:&q;https://bo.digital.gov.pt/api/assets/etic/f91d00db-0d69-4524-b799-fcec5f31fdd6/&q;,&q;thumbnailUrl&q;:&q;https://bo.digital.gov.pt/api/assets/etic/f91d00db-0d69-4524-b799-fcec5f31fdd6?width=100&a;mode=Max&q;,&q;fileName&q;:&q;Novas regras de transparência para a Inteligência Artificial.jpg&q;,&q;fileHash&q;:&q;oBfvVtcZ9a8PbxnlkRFrYfa4K3OVaUKgwNZmwMiNd9w=&q;,&q;fileType&q;:&q;jpg&q;,&q;metadata&q;:{&q;pixelWidth&q;:1366,&q;pixelHeight&q;:860,&q;imageQuality&q;:79,&q;description&q;:&q;JFIF File&q;}}]},{&q;title&q;:&q;AMALIA: versão multimodal lançada no dia 1 de julho&q;,&q;date&q;:&q;2026-07-02T00:00:00Z&q;,&q;readingTime&q;:3,&q;url&q;:&q;pt/noticias/amalia-versao-multimodal-lancada-no-dia-1-de-julho&q;,&q;buttonText&q;:&q;Saiba mais&q;,&q;newWindow&q;:false,&q;category&q;:[],&q;summary&q;:&q;Assistente Multimodal Automático de Linguagem com Inteligência Artificial.&q;,&q;image&q;:[{&q;id&q;:&q;940d3d36-bb95-4cc0-961d-077f6c008b5d&q;,&q;mimeType&q;:&q;image/jpeg&q;,&q;url&q;:&q;https://bo.digital.gov.pt/api/assets/etic/940d3d36-bb95-4cc0-961d-077f6c008b5d/&q;,&q;thumbnailUrl&q;:&q;https://bo.digital.gov.pt/api/assets/etic/940d3d36-bb95-4cc0-961d-077f6c008b5d?width=100&a;mode=Max&q;,&q;fileName&q;:&q;AMALIA.jpg&q;,&q;fileHash&q;:&q;SCE//iEyctwrKEFcg1KbcCPXLifLBy7wfwUKBxs8riE=&q;,&q;fileType&q;:&q;jpg&q;,&q;metadata&q;:{&q;pixelWidth&q;:1366,&q;pixelHeight&q;:860,&q;imageQuality&q;:79,&q;description&q;:&q;JFIF File&q;,&q;focusX&q;:-0.41044269903605857,&q;focusY&q;:0.06790473490218318}}]},{&q;title&q;:&q;Já está online o IA.gov.pt, o portal de Inteligência Artificial da Administração Pública&q;,&q;date&q;:&q;2026-07-07T00:00:00Z&q;,&q;readingTime&q;:4,&q;url&q;:&q;pt/noticias/ja-esta-online-o-ia-gov-pt-o-portal-de-inteligencia-artificial-da-administracao-publica&q;,&q;buttonText&q;:&q;Saiba mais&q;,&q;newWindow&q;:false,&q;category&q;:[],&q;summary&q;:&q;Portugal lança portal de IA para modernizar a Administração Pública.&q;,&q;image&q;:[{&q;id&q;:&q;35b66f46-dbf1-42e7-bc93-f077f5670de2&q;,&q;mimeType&q;:&q;image/jpeg&q;,&q;url&q;:&q;https://bo.digital.gov.pt/api/assets/etic/35b66f46-dbf1-42e7-bc93-f077f5670de2/&q;,&q;thumbnailUrl&q;:&q;https://bo.digital.gov.pt/api/assets/etic/35b66f46-dbf1-42e7-bc93-f077f5670de2?width=100&a;mode=Max&q;,&q;fileName&q;:&q;ja-esta-online-o-ia-gov-pt-o-portal-de-inteligencia-artificial-da-administracao-publica.jpg&q;,&q;fileHash&q;:&q;j7yi9fX8Dmx9bNi44p6e2oekKsFBHgxnCdBzpg+kKTM=&q;,&q;fileType&q;:&q;jpg&q;,&q;metadata&q;:{&q;pixelWidth&q;:1366,&q;pixelHeight&q;:860,&q;imageQuality&q;:79,&q;description&q;:&q;JFIF File&q;}}]}],&q;css&q;:null},{&q;schemaId&q;:&q;0b89c000-93c3-4bfe-b023-e96405858a73&q;,&q;schemaName&q;:&q;HeroIndexComponent&q;,&q;title&q;:&q;Impacto&q;},{&q;schemaId&q;:&q;d7db7cb2-7baf-49ba-b6be-4bb690e53e25&q;,&q;schemaName&q;:&q;StatsComponent&q;,&q;label&q;:&q;Impacto&q;,&q;title&q;:&q;Impacto em Números&q;,&q;subtitle&q;:&q;A digitalização dos serviços públicos em Portugal traduz-se em números concretos. Estes indicadores refletem o estado atual dos projetos digitais da Administração Pública e são atualizados à medida que os projetos evoluem.&q;,&q;updated&q;:&q;2026-05-12T15:31:32Z&q;,&q;stats&q;:[{&q;figure&q;:&q;60&q;,&q;label&q;:&q;Investigadores envolvidos no projeto AMÁLIA&q;},{&q;figure&q;:&q;32&q;,&q;label&q;:&q;Iniciativas da Agenda Nacional de IA (ANIA)&q;},{&q;figure&q;:&q;22&q;,&q;label&q;:&q;Entidades parceiras do consórcio AI4PA&q;}],&q;css&q;:null},{&q;schemaId&q;:&q;0b89c000-93c3-4bfe-b023-e96405858a73&q;,&q;schemaName&q;:&q;HeroIndexComponent&q;,&q;title&q;:&q;Oportunidade&q;},{&q;schemaId&q;:&q;d4beb0fa-d7b1-47e3-ab02-880dc1c06d08&q;,&q;schemaName&q;:&q;FeaturedSingleComponent&q;,&q;title&q;:&q;Oportunidade&q;,&q;subject&q;:&q;A sua entidade já aderiu ao AI4PA?&q;,&q;description&q;:&q;O AI4PA Portugal EDIH apoia entidades públicas e PMEs na transição digital com Inteligência Artificial e Ciência de Dados, gratuitamente. Inclui formação, acesso a laboratórios, apoio técnico e disseminação de boas práticas.&q;,&q;tags&q;:null,&q;isMobileImageBelowText&q;:null,&q;buttonInvertedColors&q;:false,&q;image&q;:[{&q;id&q;:&q;01fa816e-8760-4a86-8f0e-b4e46c51eca1&q;,&q;mimeType&q;:&q;image/png&q;,&q;url&q;:&q;https://bo.digital.gov.pt/api/assets/etic/01fa816e-8760-4a86-8f0e-b4e46c51eca1/&q;,&q;thumbnailUrl&q;:&q;https://bo.digital.gov.pt/api/assets/etic/01fa816e-8760-4a86-8f0e-b4e46c51eca1?width=100&a;mode=Max&q;,&q;fileName&q;:&q;ai4pa-promo-robot.png&q;,&q;fileHash&q;:&q;jA05vfYmrKbBeOvLmCxi+zJUCPaBRdKWdv1BFBl6EX8=&q;,&q;fileType&q;:&q;png&q;,&q;metadata&q;:{&q;pixelWidth&q;:662,&q;pixelHeight&q;:650,&q;description&q;:&q;PNG File&q;}}],&q;borderRadius&q;:true,&q;url&q;:&q;https://ai4pa.pt/&q;,&q;buttonText&q;:&q;Saiba mais&q;,&q;icon&q;:true,&q;newWindow&q;:true,&q;css&q;:null},{&q;schemaId&q;:&q;0b89c000-93c3-4bfe-b023-e96405858a73&q;,&q;schemaName&q;:&q;HeroIndexComponent&q;,&q;title&q;:&q;Planos de ação&q;},{&q;schemaId&q;:&q;05ea70e9-c5e8-4dbf-b85a-58e450b3e750&q;,&q;schemaName&q;:&q;ImageLinksComponent&q;,&q;label&q;:&q;Planos de Ação&q;,&q;title&q;:&q;Apoios à Inovação e Adoção de IA&q;,&q;description&q;:&q;Portugal e a União Europeia disponibilizam diversos instrumentos de financiamento e iniciativas estratégicas para apoiar a investigação, o desenvolvimento e a adoção de soluções de Inteligência Artificial. Estes apoios contribuem para  reforçar  o ecossistema de inovação, acelerar a transição digital e aumentar a competitividade.&q;,&q;links&q;:[{&q;title&q;:&q;Financiamento Nacional&q;,&q;url&q;:&q;pt/inteligencia-artificial/financiamento-nacional&q;,&q;image&q;:[{&q;id&q;:&q;3a82884f-9ec4-4ee0-af26-f62a063c663a&q;,&q;mimeType&q;:&q;image/jpeg&q;,&q;url&q;:&q;https://bo.digital.gov.pt/api/assets/etic/3a82884f-9ec4-4ee0-af26-f62a063c663a/&q;,&q;thumbnailUrl&q;:&q;https://bo.digital.gov.pt/api/assets/etic/3a82884f-9ec4-4ee0-af26-f62a063c663a?width=100&a;mode=Max&q;,&q;fileName&q;:&q;bandeira-de-portugal.jpg&q;,&q;fileHash&q;:&q;MsIuehkih060lzS7ibvDBS78vBZ47+Azk4v45iPgovY=&q;,&q;fileType&q;:&q;jpg&q;,&q;metadata&q;:{&q;pixelWidth&q;:7200,&q;pixelHeight&q;:4800,&q;created&q;:&q;2016-10-19T08:52:51+00:00&q;,&q;imageQuality&q;:98,&q;description&q;:&q;JFIF File&q;}}]},{&q;title&q;:&q;Financiamento Europeu&q;,&q;url&q;:&q;pt/inteligencia-artificial/financiamento-europeu&q;,&q;image&q;:[{&q;id&q;:&q;7e0801b7-ed2f-4e18-b152-4005dce508c7&q;,&q;mimeType&q;:&q;image/jpeg&q;,&q;url&q;:&q;https://bo.digital.gov.pt/api/assets/etic/7e0801b7-ed2f-4e18-b152-4005dce508c7/&q;,&q;thumbnailUrl&q;:&q;https://bo.digital.gov.pt/api/assets/etic/7e0801b7-ed2f-4e18-b152-4005dce508c7?width=100&a;mode=Max&q;,&q;fileName&q;:&q;bandeira-da-uniao-europeia.jpg&q;,&q;fileHash&q;:&q;95b91HYa8vbuq3HVTRGzdBPX+Zc1ejLWzNRsb7BSHsU=&q;,&q;fileType&q;:&q;jpg&q;,&q;metadata&q;:{&q;pixelWidth&q;:5472,&q;pixelHeight&q;:3648,&q;imageQuality&q;:95,&q;description&q;:&q;JFIF File&q;}}]}],&q;css&q;:null},{&q;schemaId&q;:&q;0b89c000-93c3-4bfe-b023-e96405858a73&q;,&q;schemaName&q;:&q;HeroIndexComponent&q;,&q;title&q;:&q;Plataformas de apoio&q;},{&q;schemaId&q;:&q;b6ecc681-b073-4ed5-943b-a4a9c88b741d&q;,&q;schemaName&q;:&q;ToolsComponent&q;,&q;title&q;:&q;Plataformas de apoio&q;,&q;subject&q;:&q;Use, adapte, implemente&q;,&q;description&q;:&q;Conheça as ferramentas e plataformas que podem ajudar a integrar a interoperabilidade.&q;,&q;toollist&q;:[{&q;title&q;:&q;IA Responsável &q;,&q;subject&q;:&q;GuIA Responsável para a Inteligência Artificial estabelece um framework com cinco dimensões de avaliação: Responsabilização, Transparência, Explicabilidade, Justiça e Ética.&q;,&q;file&q;:null,&q;link&q;:&q;pt/inteligencia-artificial/ia-responsavel&q;,&q;newWindow&q;:true},{&q;title&q;:&q;Infraestruturas Tecnológicas de Transformação Digital e IA &q;,&q;subject&q;:&q;Acelerar a digitalização com base em tecnologias avançadas como a Inteligência Artificial, o High Performance Computing (HPC) e a ciência de dados.&q;,&q;file&q;:null,&q;link&q;:&q;pt/inteligencia-artificial/infraestruturas-tecnologicas-de-transformacao-digital-e-ia&q;,&q;newWindow&q;:true}],&q;pageSize&q;:3,&q;css&q;:null},{&q;schemaId&q;:&q;0b89c000-93c3-4bfe-b023-e96405858a73&q;,&q;schemaName&q;:&q;HeroIndexComponent&q;,&q;title&q;:&q;Iniciativas&q;},{&q;schemaId&q;:&q;eaf7b5e0-9114-441e-812f-df102ccb5210&q;,&q;schemaName&q;:&q;ListMembersComponent&q;,&q;label&q;:&q;Iniciativas&q;,&q;title&q;:&q;Estratégias Nacionais e Europeias&q;,&q;description&q;:&q;&l;p&g;Conhe&a;ccedil;a as iniciativas nacionais e europeias que enquadram e orientam cada &a;aacute;rea dos servi&a;ccedil;os digitais em Portugal.&l;/p&g;&q;,&q;anchor&q;:null,&q;members&q;:null,&q;showMembersPicture&q;:false,&q;cards&q;:[{&q;title&q;:&q;Agenda Nacional de IA (ANIA)&q;,&q;description&q;:&q;Principal instrumento para operacionalizar a AI em Portugal. Conta com 32 iniciativas estratégicas organizadas em três eixos fundamentais.&q;,&q;url&q;:&q;pt/estrategia-digital/agenda-nacional-de-ia&q;},{&q;title&q;:&q;IA Responsável&q;,&q;description&q;:&q;Modernizar serviços públicos com Inteligências Artificial ética e centrada nos cidadãos.&q;,&q;url&q;:&q;pt/inteligencia-artificial/ia-responsavel&q;},{&q;title&q;:&q;Soluções de IA&q;,&q;description&q;:&q;Iniciativas estruturantes, alinhadas com as orientações da Estratégia Digital Nacional e com os objetivos europeus de promover uma IA ética, segura e centrada nas pessoas.&q;,&q;url&q;:&q;pt/inteligencia-artificial/solucoes-de-ia&q;},{&q;title&q;:&q;Estratégia Europeia para a Inteligência Artificial&q;,&q;description&q;:&q;Visão transformadora da IA, assente no desenvolvimento tecnológico responsável, na promoção do bem-estar social e na defesa dos valores fundamentais europeu.&q;,&q;url&q;:&q;pt/inteligencia-artificial/estrategia-europeia-para-a-inteligencia-artificial&q;},{&q;title&q;:&q;Plano de Ação “AI Continent”&q;,&q;description&q;:&q;Visa consolidar a liderança europeia no desenvolvimento e uso responsável da Inteligência Artificial. &q;,&q;url&q;:&q;pt/inteligencia-artificial/plano-de-acao-ai-continent&q;},{&q;title&q;:&q;Regulamento Europeu de IA &q;,&q;description&q;:&q;Estabelece o primeiro quadro jurídico horizontal para o desenvolvimento, colocação no mercado e utilização de sistemas de IA na União Europeia.&q;,&q;url&q;:&q;pt/estrategia-digital/regulamentacao/ai-act&q;}],&q;css&q;:null,&q;pageSize&q;:6}]}}]},&q;extensions&q;:{&q;tracing&q;:{&q;version&q;:1,&q;startTime&q;:&q;2026-09-14T12:31:57.9850085Z&q;,&q;endTime&q;:&q;2026-09-14T12:31:58.37185Z&q;,&q;duration&q;:386841500,&q;parsing&q;:{&q;startOffset&q;:900,&q;duration&q;:432700},&q;validation&q;:{&q;startOffset&q;:435800,&q;duration&q;:13622000},&q;execution&q;:{&q;resolvers&q;:[]}}}},&q;headers&q;:{&q;access-control-allow-methods&q;:[&q;GET, POST, PUT, DELETE, OPTIONS&q;],&q;access-control-max-age&q;:[&q;3600&q;],&q;x-content-type-options&q;:[&q;nosniff&q;],&q;x-xss-protection&q;:[&q;0&q;],&q;cache-control&q;:[&q;no-cache, no-store, max-age=0, must-revalidate&q;],&q;pragma&q;:[&q;no-cache&q;],&q;expires&q;:[&q;0&q;],&q;x-frame-options&q;:[&q;SAMEORIGIN&q;],&q;content-type&q;:[&q;application/json&q;],&q;date&q;:[&q;Mon, 14