  window.dataLayer = window.dataLayer || [];
  function gtag(){window.dataLayer.push(arguments);}
  gtag('consent', 'default', {
    'analytics_storage': 'denied',
    'ad_storage': 'denied',
    'ad_user_data': 'denied',
    'ad_personalization': 'denied',
    'functionality_storage': 'denied',
    'personalization_storage': 'denied',
    'security_storage': 'granted'
  });
  // Restore consent for returning users before any tag fires
  (function() {
    try {
      var gc = function(n) {
        var m = document.cookie.match(new RegExp('(^| )' + n + '=([^;]+)'));
        return m ? decodeURIComponent(m[2]) : null;
      };
      if (gc('hasAcceptedCookies') === 'true') {
        var gv = function(v) { return v === 'true' ? 'granted' : 'denied'; };
        gtag('consent', 'update', {
          'analytics_storage': gv(gc('Analitics_Portal_cookies')),
          'ad_storage': gv(gc('social_network_Portal_cookies')),
          'ad_user_data': gv(gc('social_network_Portal_cookies')),
          'ad_personalization': gv(gc('social_network_Portal_cookies')),
          'functionality_storage': gv(gc('performance_Portal_cookies')),
          'personalization_storage': gv(gc('performance_Portal_cookies')),
          'security_storage': 'granted'
        });
      }
    } catch(e) {}
  })();
