ativo e empresarial e da função acionista e assegurar a gestão integrada do património do Estado, com exceção do património imobiliário, bem como a intervenção em operações patrimoniais do setor público, nos termos da lei.\\n\\nMais informação em [http://www.etf.gov.pt/](http://www.etf.gov.pt/)\",\"extras\":{},\"id\":\"683dc6f11bf8c055ceb0c868\",\"last_modified\":\"2026-08-19T15:08:31.863000+00:00\",\"logo\":\"https://dados.gov.pt/s/avatars/b8/2a4a71a1de4736ae6d306de1d7b4f3-original.jpg\",\"logo_thumbnail\":\"https://dados.gov.pt/s/avatars/b8/2a4a71a1de4736ae6d306de1d7b4f3-100.jpg\",\"members\":[{\"label\":\"Administrador\",\"role\":\"admin\",\"since\":\"2025-06-02T15:44:49.302000+00:00\",\"user\":{\"avatar\":null,\"avatar_thumbnail\":null,\"class\":\"User\",\"email\":\"***@etf.gov.pt\",\"first_name\":\"Cristina\",\"id\":\"683dabd0d55bae8c41b0c868\",\"last_login_at\":null,\"last_name\":\"Isidro da Silva\",\"page\":\"https://dados.gov.pt/users/cristina-paula-lopes-isidro-da-silva\",\"slug\":\"cristina-paula-lopes-isidro-da-silva\",\"uri\":\"https://dados.gov.pt/api/1/users/cristina-paula-lopes-isidro-da-silva/\"}},{\"label\":\"Administrador\",\"role\":\"admin\",\"since\":\"2026-03-26T14:44:36.623000+00:00\",\"user\":{\"avatar\":null,\"avatar_thumbnail\":null,\"class\":\"User\",\"email\":\"***@etf.gov.pt\",\"first_name\":\"Renata Raquel\",\"id\":\"69c5445639a9342260519def\",\"last_login_at\":null,\"last_name\":\"De Souza Moraes Coutinho\",\"page\":\"https://dados.gov.pt/users/renata-raquel-de-souza-moraes-coutinho\",\"slug\":\"renata-raquel-de-souza-moraes-coutinho\",\"uri\":\"https://dados.gov.pt/api/1/users/renata-raquel-de-souza-moraes-coutinho/\"}}],\"metrics\":{\"dataservice_views\":0,\"dataservices\":0,\"dataservices_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"datasets\":5,\"datasets_by_months\":{\"2025-06\":0,