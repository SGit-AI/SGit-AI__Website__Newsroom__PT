dos.gov.pt/s/avatars/c8/ce9c0116054efea82301c049a79336-100.jpg\",\"members\":[{\"label\":\"Administrador\",\"role\":\"admin\",\"since\":\"2021-09-20T13:14:13.270000+00:00\",\"user\":{\"avatar\":null,\"avatar_thumbnail\":null,\"class\":\"User\",\"email\":\"***@cada.pt\",\"first_name\":\"José\",\"id\":\"614879da078190ad9404c402\",\"last_login_at\":null,\"last_name\":\"Raimundo\",\"page\":\"https://dados.gov.pt/users/jose-raimundo\",\"slug\":\"jose-raimundo\",\"uri\":\"https://dados.gov.pt/api/1/users/jose-raimundo/\"}},{\"label\":\"Administrador\",\"role\":\"admin\",\"since\":\"2026-08-20T15:46:52.047000+00:00\",\"user\":{\"avatar\":null,\"avatar_thumbnail\":null,\"class\":\"User\",\"email\":\"***@ama.gov.pt\",\"first_name\":\"António\",\"id\":\"60d362b50781906bd69afc09\",\"last_login_at\":null,\"last_name\":\"Soares\",\"page\":\"https://dados.gov.pt/users/antonio-soares-1\",\"slug\":\"antonio-soares-1\",\"uri\":\"https://dados.gov.pt/api/1/users/antonio-soares-1/\"}}],\"metrics\":{\"dataservice_views\":0,\"dataservices\":0,\"dataservices_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"datasets\":6,\"datasets_by_months\":{\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0,\"2026-07\":0,\"2026-08\":5},\"datasets_followers_by_months\":{\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0,\"2026-07\":0,\"2026-08\":0},\"datasets_reuses_by_months\":{\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0,\"2026-07\":0,\"2026-08\":0},\"followers\":1,\"members\":2,\"resource_downloads\":263,\"reuse_views\":0,\"reuses\":0,\"reuses_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"reuses_followers_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"views\":17},\"name\":\"Comissão de Acesso aos Documentos Administrativos\",\"page\":\"https://dados.gov.pt/organizations/comissao-de-acesso-aos-documentos-administrativos\",\"permissions\":{\"delete\":false,\"edit\":false,\"harvest\":false,\"members\":false,\"private\":false},\"slug\":\"comissao-de-acesso-aos-documentos-administrativos\",\"uri\":\"https://dados.gov.pt/api/1/organizations/comissao-de-acesso-aos-documentos-administrativos/\",\"url\":\"https://www.cada.pt\"},{\"acronym\":\"AML\",\"badges\":[],\"business_number_id\":null,\"created_at\":\"2021-05-21T11:25:22.019000+00:00\",\"deleted\":null,\"description\":\"A Área Metropolitana de Lisboa regista a maior concentração populacional e económica de Portugal. Nos seus dezoito concelhos, que constituem 3,3% do território nacional, residem quase 3 milhões de habitantes, cerca de ¼ da população portuguesa. Ao nível económico concentra cerca de 25% da população ativa, 30% das empresas nacionais, 33% do emprego e contribui com mais de 36% do PIB nacional.\\nA AML assegura a articulação das atuações entre os municípios e os serviços da administração central nas seguintes áreas: Redes de abastecimento público, infraestruturas de saneamento básico, tratamento de águas residuais e resíduos urbanos; Rede de equipamentos de saúde; Rede educativa e de formação profissional; Ordenamento do território, conservação da natureza e recursos naturais; Segurança e proteção civil; Mobilidade e transportes; Redes de equipamentos públicos; Promoção do desenvolvimento económico e social; Rede de equipamentos culturais, desportivos e de lazer.\\n\",\"extras\":{},\"id\":\"60a78a92454ae37e2834077c\",\"last_modified\":\"2026-09-01T16:19:45.690000+00:00\",\"logo\":\"https://dados.gov.pt/s/avatars/f9/91880327da451fa08eb1abfb343180-original.png\",\"logo_thumbnail\":\"https://dados.gov.pt/s/avatars/f9/91880327da451fa08eb1abfb343180-100.png\",\"members\":[{\"label\":\"Administrador\",\"role\":\"admin\",\"since\":\"2025-07-08T17:09:32.616000+00:00\",\"user\":{\"avatar\":\"https://dados.gov.pt/s/avatars/50/f0624945404ee19dc2d434f6f89508-original.jpg\",\"avatar_thumbnail\":\"https://dados.gov.pt/s/avatars/50/f0624945404ee19dc2d434f6f89508-500.jpg\",\"class\":\"User\",\"email\":\"***@aml.pt\",\"first_name\":\"Fernando\",\"id\":\"686d35bc28e85d9248893db7\",\"last_login_at\":null,\"last_name\":\"Ferreira\",\"page\":\"https://dados.gov.pt/users/fernando-jorge-de-almeida-ferreira\",\"slug\":\"fernando-jorge-de-almeida-ferreira\",\"uri\":\"https://dados.gov.pt/api/1/users/fernando-jorge-de-almeida-ferreira/\"}},{\"label\":\"Administrador\",\"role\":\"admin\",\"since\":\"2025-07-08T17:09:36+00:00\",\"user\":{\"avatar\":\"https://dados.gov.pt/s/avatars/7d/0ba95e7d6b48e88d2fef6b1bf3cabf-original.jpg\",\"avatar_thumbnail\":\"https://dados.gov.pt/s/avatars/7d/0ba95e7d6b48e88d2fef6b1bf3cabf-500.jpg\",\"class\":\"User\",\"email\":\"***@aml.pt\",\"first_name\":\"Rita Isabel\",\"id\":\"686d3048e9d8446d1e893db7\",\"last_login_at\":null,\"last_name\":\"Proença Florêncio Isidro Praça\",\"page\":\"https://dados.gov.pt/users/rita-isabel-proenca-florencio-isidro-praca\",\"slug\":\"rita-isabel-proenca-florencio-isidro-praca\",\"uri\":\"https://dados.gov.pt/api/1/users/rita-isabel-proenca-florencio-isidro-praca/\"}}],\"metrics\":{\"dataservice_views\":0,\"dataservices\":0,\"dataservices_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"datasets\":6,\"datasets_by_months\":{\"2025-