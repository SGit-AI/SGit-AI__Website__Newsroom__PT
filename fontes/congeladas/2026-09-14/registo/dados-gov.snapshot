10-27T15:32:34.398000+00:00\",\"user\":{\"avatar\":null,\"avatar_thumbnail\":null,\"class\":\"User\",\"email\":\"***@cm-cascais.pt\",\"first_name\":\"Ana\",\"id\":\"61519c620781900621b37f18\",\"last_login_at\":null,\"last_name\":\"Carvalho\",\"page\":\"https://dados.gov.pt/users/ana-carvalho\",\"slug\":\"ana-carvalho\",\"uri\":\"https://dados.gov.pt/api/1/users/ana-carvalho/\"}}],\"metrics\":{\"dataservice_views\":0,\"dataservices\":0,\"dataservices_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"datasets\":8,\"datasets_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"datasets_followers_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"datasets_reuses_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"followers\":0,\"members\":2,\"resource_downloads\":0,\"reuse_views\":0,\"reuses\":0,\"reuses_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"reuses_followers_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"views\":17},\"name\":\"SFA – Cascais\",\"page\":\"https://dados.gov.pt/organizations/sfa-cascais\",\"permissions\":{\"delete\":false,\"edit\":false,\"harvest\":false,\"members\":false,\"private\":false},\"slug\":\"sfa-cascais\",\"uri\":\"https://dados.gov.pt/api/1/organizations/sfa-cascais/\",\"url\":null},{\"acronym\":\"CMMoura\",\"badges\":[],\"business_number_id\":null,\"created_at\":\"2025-09-16T15:08:24.473000+00:00\",\"deleted\":null,\"description\":\"A Câmara Municipal de Moura tem como missão enquanto entidade autárquica a responsabilidade pela administração e gestão do concelho. O concelho de Moura encontra-se distribuído por 9 freguesias, organizadas administrativamente em uniões de freguesias, respetivamente: União de Freguesias de Moura e Santo Amador (inclui as freguesias urbanas de Santo Agostinho e S. João Batista e a freguesia rural de Santo Amador), Junta de Freguesias de Safara, Junta de Freguesia de Santo Aleixo da Restauração, Junta de Freguesia de Amareleja, Junta de Freguesia de Póvoa de S. Miguel (esta inclui a aldeia da Estrela) e Junta de Freguesia do Sobral da Adiça. \\nÉ uma cidade encantadora, respeitando as suas tradições e em paralelo com o desenvolvimento e modernidade dos seus serviços. O desenvolvimento local é visível em áreas fulcrais como a educação, habitação, ambiente, urbanismo, saneamento básico, cultura e turismo. \\n\",\"extras\":{},\"id\":\"68c97d6822ac328de3e74d41\",\"last_modified\":\"2026-06-09T12:15:41.306000+00:00\",\"logo\":\"https://dados.gov.pt/s/avatars/64/d91f43d07a4fb2803c7cb278424f22-original.jpg\",\"logo_thumbnail\":\"https://dados.gov.pt/s/avatars/64/d91f43d07a4fb2803c7cb278424f22-100.jpg\",\"members\":[{\"label\":\"Administrador\",\"role\":\"admin\",\"since\":\"2025-09-16T15:08:24.474000+00:00\",\"user\":{\"avatar\":null,\"avatar_thumbnail\":null,\"class\":\"User\",\"email\":\"***@cm-moura.pt\",\"first_name\":\"Vera De Jesus\",\"id\":\"68c976a82245c029fce74d41\",\"last_login_at\":null,\"last_name\":\"Óca Clérigo Cardoso\",\"page\":\"https://dados.gov.pt/users/vera-de-jesus-oca-clerigo-cardoso\",\"slug\":\"vera-de-jesus-oca-clerigo-cardoso\",\"uri\":\"https://dados.gov.pt/api/1/users/vera-de-jes