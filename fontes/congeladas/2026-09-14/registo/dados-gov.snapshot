:0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"followers\":0,\"members\":0,\"resource_downloads\":29,\"reuse_views\":0,\"reuses\":0,\"reuses_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"reuses_followers_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"views\":524},\"name\":\"GPEARI - MCTES\",\"page\":\"https://dados.gov.pt/organizations/gpeari-mctes\",\"permissions\":{\"delete\":false,\"edit\":false,\"harvest\":false,\"members\":false,\"private\":false},\"slug\":\"gpeari-mctes\",\"uri\":\"https://dados.gov.pt/api/1/organizations/gpeari-mctes/\",\"url\":null},{\"acronym\":\"CCDR Centro, I. P.\",\"badges\":[{\"kind\":\"public-service\"},{\"kind\":\"certified\"}],\"business_number_id\":null,\"created_at\":\"2018-05-02T10:06:28.486000+00:00\",\"deleted\":null,\"description\":\"A CCDRC, I.P. é um instituto público integrado na administração indireta do Estado, com autonomia administrativa, financeira e património próprio.\\nResponsável por definir e executar estratégias de desenvolvimento regional e articular políticas públicas em áreas como ambiente, economia, cultura, educação, saúde e ordenamento do território.\\nCompete-lhe ainda gerir a política de coesão no âmbito dos programas regionais e de cooperação territorial europeia, promovendo o desenvolvimento da Região Centro e apoiando tecnicamente as autarquias locais.\\n\\nMais informações em https://www.ccdrc.pt/pt/\",\"extras\":{},\"id\":\"5ae97f94c8d8c915d5faa3b0\",\"last_modified\":\"2026-06-30T10:19:28.715000+00:00\",\"logo\":\"https://dados.gov.pt/s/avatars/6d/3e4451b4184965b7c5f409cc0b25a1-original.jpg\",\"logo_thumbnail\":\"https://dados.gov.pt/s/avatars/6d/3e4451b4184965