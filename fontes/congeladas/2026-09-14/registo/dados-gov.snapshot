ifier\":\"Identificador\",\"createdAt\":\"Criado em\",\"size\":\"Tamanho\",\"modifiedAt\":\"Modificado em\",\"type\":\"Tipo\",\"mime\":\"Tipo MIME\",\"extras\":\"Recursos extras\"},\"downloads\":{\"originalFormat\":\"Formato original\",\"copyUrl\":\"Copiar URL\"},\"types\":{\"main\":\"Ficheiros principais\",\"file\":\"Ficheiros principais\",\"documentation\":\"Documentação\"},\"extrasKeys\":{\"check_id\":\"verificação:id\",\"check_available\":\"verificar: disponível\",\"check_status\":\"verificar:status\",\"check_timeout\":\"verificação:tempo limite\",\"check_date\":\"verificar:data\",\"check_headers_content-type\":\"verificar:cabeçalhos:tipo de conteúdo\",\"check_headers_content-length\":\"verificar:cabeçalhos:comprimento do conteúdo\",\"analysis_check_id\":\"análise:verificar_id\",\"analysis_content-length\":\"análise:comprimento do conteúdo\",\"analysis_checksum\":\"análise: checksum\",\"analysis_mime-type\":\"análise:tipo MIME\",\"analysis_last-modified-at\":\"análise:última-modificação-em\",\"analysis_last-modified-detection\":\"análise:detecção de última modificação\",\"analysis_parsing_started_at\":\"análise:análise:iniciada_em\",\"analysis_parsing_finished_at\":\"análise:análise:concluída_em\",\"analysis_parsing_error\":\"análise:análise:erro\",\"analysis_parsing_parsing_table\":\"análise:análise sintática:tabela_de_análise\"},\"extrasValues\":{\"true\":\"verdadeiro\",\"false\":\"falso\",\"empty\":\"—\"}}},\"login\":{\"metadata\":{\"title\":\"Iniciar Sessão - dados.gov.pt\",\"description\":\"Inicie sessão no portal dados.gov.pt para aceder a funcionalidades exclusivas. Partilhe e reutilize dados públicos.\"},\"title\":\"Autenticação\",\"description\":\"Escolha um meio de autenticação para se autenticar no portal e ter acesso aos vários serviços e funcionalidades online.\",\"tabs\":{\"cmd\":\"Chave Móvel Digital (CMD)\",\"eidas\":\"Autenticação europeia (eIDAS)\",\"email\":\"E-mail e palavra-passe\"},\"beforeStart\":{\"title\":\"Antes de começar...\"},\"cmd\":{\"intro\":\"Precisa do código PIN da sua Chave Móvel Digital - CMD e do telemóvel que lhe está associado.\",\"noAccountQuestion\":\"Não tem Chave Móvel Digital?\",\"discoverHowToCreate\":\"Descubra como criar conta\",\"loginAs\":\"Entrar como\",\"citizenNational\":\"Pessoa com nacionalidade portuguesa\",\"citizenForeign\":\"Pessoa com nacionalidade estrangeira\",\"submit\":\"Entrar com Chave Móvel Digital\"},\"eidas\":{\"intro\":\"Precisa de ter um meio de autenticação digital disponibilizado pelo seu país de origem na União Europeia (UE). Este meio de autenticação está disponível para a qualquer cidadã/o da UE.\",\"noAccountQuestion\":\"Não tem Autenticação Europeia?\",\"discoverHowToCreate\":\"Descubra como criar conta\",\"documentsPart1\":\"Precisa \",\"documentsBold1\":\"fornecer documentos\",\"documentsPart2\":\" que foram emitidos por uma entidade pública de \",\"documentsBold2\":\"outro Estado-Membro\",\"documentsPart3\":\" da UE? Agora já é possível recupera-los diretamente do portal emissor entrando com a sua autenticação Europeia.\",\"submit\":\"Autenticar com eIDAS\"},\"email\":{\"beforeStartDescription\":\"Apenas utilizadores antigos, que tenham criado conta com email e palavra-passe, conseguem autenticar-se desta forma.\",\"requiredFieldsNote\":\"Os campos marcados com um asterisco ( * ) são obrigatórios.\",\"emailLabel\":\"Endereço de e-mail *\",\"emailPlaceholder\":\"Introduza aqui o texto\",\"passwordLabel\":\"Palavra-passe *\",\"passwordPlaceholder\":\"Introduza aqui a palavra-passe\",\"rememberPassword\":\"Lembrar palavra-passe\",\"forgotPassword\":\"Esqueceu-se da palavra-passe?\",\"recoverPassword\":\"Recuperar palavra-passe\",\"submit\":\"Autenticar\",\"submitLoading\":\"A autenticar...\"},\"recovery\":{\"title\":\"Recuperar palavra-passe\",\"description\":\"Introduza o seu endereço de e-mail e enviaremos instruções para redefinir a sua palavra-passe.\",\"emailLabel\":\"Endereço de e-mail *\",\"emailPlaceholder\":\"Introduza aqui o texto\",\"submit\":\"Redefinir palavra-passe\",\"submitLoading\":\"A enviar...\",\"back\":\"Voltar ao início de sessão\",\"success\":\"Se o endereço de e-mail estiver associado a uma conta, receberá um e-mail com instruções para redefinir a sua palavra-passe.\",\"errorRequest\":\"Erro ao enviar pedido. Tente novamente.\",\"errorConnection\":\"Erro de ligação. Tente novamente.\"},\"migration\":{\"title\":\"Migração obrigatória\",\"description\":\"O login por email e palavra-passe vai ser descontinuado. Para continuar a aceder ao portal, é necessário migrar a sua conta para a Chave Móvel Digital (CMD) ou autenticação europeia (eIDAS).\",\"howToTitle\":\"Como migrar?\",\"howToDescription\":\"Autentique-se com a Chave Móvel Digital (separador \\\"CMD\\\") ou com a autenticação europeia (separador \\\"eIDAS\\\"). O sistema detetará a sua conta existente e guiá-lo-á pelo processo de migração. Os seus dados (conjuntos de dados, organizações, reutilizações) serão mantidos.\",\"migrateCmd\":\"Migrar com CMD\",\"migrateEidas\":\"Migrar com eIDAS\",\"loading\":\"A carregar...\",\"linkTitle\":\"Associar conta à Chave Móvel Digital\",\"linkDescription\":\"Para associar a sua Chave Móvel Digital a uma conta existente no portal, precisa de verificar a propriedade dessa conta.\",\"accountFound\":\"Identificámos uma conta que corresponde aos seus dados\",\"hasAccount\":\"Já possui uma conta no portal?\",\"accountFoundDescription\":\"Já possui uma conta no sistema ou deseja criar uma nova conta?\",\"noAccountDescription\":\"Se já utilizava o portal com email e palavra-passe, pode associar essa conta à sua Chave Móvel Digital, mantendo todos os seus dados e permissões. Caso contrário, será criada uma nova conta.\",\"existingAccount\":\"Já possuo uma conta\",\"existingAccountDescription\":\"Inicie sessão com o email e a palavra-passe da sua conta para a associar à Chave Móvel Digital\",\"newAccount\":\"Criar nova conta\",\"creatingAccount\":\"A criar a nova conta...\",\"newAccountDescription\":\"Será criada uma nova conta associada à sua Chave Móvel Digital\",\"back\":\"Voltar\",\"errorNotFound\":\"Nenhuma conta encontrada com esses dados.\",\"errorSearch\":\"Erro ao procurar conta.\",\"errorSendCode\":\"Erro ao enviar o código.\",\"errorResendCode\":\"Erro ao reenviar o código.\",\"errorInvalidCode\":\"Código inválido.\",\"errorCreateAccount\":\"Erro ao criar conta.\",\"errorMaximumAttempts\":\"Número máximo de tentativas excedido. A vinculação foi bloqueada nesta sessão.\",\"errorInvalidCredentials\":\"Credenciais inválidas. Verifique o email e a palavra-passe e tente novamente.\",\"signInTitle\":\"Inicie sessão na sua conta\",\"email\":\"Email\",\"emailExample\":\"exemplo@email.com\",\"password\":\"Palavra-passe\",\"passwordPlaceholder\":\"Introduza a palavra-passe\",\"checking\":\"A verificar...\",\"linkAccount\":\"Associar conta\",\"searchTitle\":\"Encontre a sua conta\",\"searching\":\"A procurar...\",\"searchAccount\":\"Procurar conta\",\"confirmTitle\":\"Esta conta é sua?\",\"firstName\":\"Nome\",\"verifyTitle\":\"Verifique a sua identidade\",\"verifyCodeTitle\":\"Introduza o código\",\"verificationCode\":\"Código de verificação\",\"verify\":\"Verificar\",\"resendCode\":\"Reenviar código\",\"successTitle\":\"Conta associada com sucesso!\",\"successNewTitle\":\"Nova conta criada!\",\"signInDescription\":\"Introduza o email e a palavra-passe da sua conta do portal. Se as credenciais estiverem corretas, a conta será associada à sua Chave Móvel Digital.\",\"forgotPassword\":\"Não se lembra da palavra-passe? Verificar por código de email\",\"searchDescription\":\"Introduza o email ou o nome associado a sua conta anterior.\",\"byEmail\":\"Por email\",\"byName\":\"Por nome\",\"createNewAccount\":\"Criar conta nova\",\"confirmDescription\":\"Encontramos uma conta existente no portal com os seguintes dados. Confirme se esta conta lhe pertence.\",\"confirmYes\":\"Sim, esta conta é minha\",\"confirmNo\":\"Não, criar conta nova\",\"verifyDescription\":\"Para confirmar que esta conta lhe pertence, escolha um dos métodos abaixo.\",\"sendCode\":\"Enviar código para o meu email\",\"passwordMethodDescription\":\"Inicie sessão com o email e a palavra-passe da sua conta\",\"codeDescription\":\"Enviamos um código de 6 dígitos para {{email}}. Verifique a sua caixa de entrada.\",\"successDescription\":\"A sua conta foi associada à Chave Móvel Digital. Os seus dados e permissões foram mantidos. Será redirecionado em breve...\",\"successNewDescription\":\"Foi criada uma nova conta associada à sua Chave Móvel Digital. Será redirecionado em breve...\",\"previousAccountEmail\":\"Email da conta anterior\",\"firstNamePlaceholder\":\"Introduza o nome\",\"lastName\":\"Apelido\",\"lastNamePlaceholder\":\"Introduza o apelido\",\"knowPassword\":\"Sei a minha palavra-passe\"},\"terms\":{\"title\":\"Termos e condições\",\"readCarefully\":\"Deve ler atentamente os\",\"link\":\"Termos e condições para o tratamento dos seus dados\",\"checkbox\":\"Declaro que li e aceito os termos e condições para o tratamento dos meus dados pessoais no acesso e utilização da Área Reservada do dados.gov.pt.\"},\"help\":{\"title\":\"Tem dúvidas?\",\"description\":\"Se precisar de ajuda, fale connosco através do nosso formulário.\",\"link\":\"Formulário de contacto\"},\"cmdModal\":{\"title\":\"O que precisa para criar uma conta?\",\"item1\":\"Para cidadãs/ãos nacionais e estrangeiras/os com Chave Móvel Digital (CMD) ativa.\",\"item2Before\":\"Precisa do código PIN da sua CMD e do telemóvel que lhe está associado. Se ainda não o fez, pode\",\"item2Link\":\"ativar a Chave Móvel Digital em Autenticação.gov.\",\"item3\":\"O registo com CMD permite a realização de todos os serviços online disponibilizados neste portal.\",\"createNational\":\"Criar conta como cidadão nacional\",\"createForeign\":\"Criar conta como cidadão estrangeiro\"},\"eidasModal\":{\"title\":\"O que precisa para criar uma conta?\",\"item1\":\"Ter um mecanismo de identificação eletrónica emitida por outr