\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"followers\":0,\"members\":0,\"resource_downloads\":0,\"reuse_views\":0,\"reuses\":0,\"reuses_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"reuses_followers_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"views\":269},\"name\":\"Dados Abertos da Justiça \",\"page\":\"https://dados.gov.pt/organizations/dados-abertos-da-justica\",\"permissions\":{\"delete\":false,\"edit\":false,\"harvest\":false,\"members\":false,\"private\":false},\"slug\":\"dados-abertos-da-justica\",\"uri\":\"https://dados.gov.pt/api/1/organizations/dados-abertos-da-justica/\",\"url\":null},{\"acronym\":\"TicAPP\",\"badges\":[],\"business_number_id\":null,\"created_at\":\"2021-04-13T09:43:32.332000+00:00\",\"deleted\":null,\"description\":\"O Centro de Competências Digitais da Administração Pública, designado por TicAPP, é uma unidade orgânica integrada na Agência para a Modernização Administrativa, I.P. (AMA).\\n\\nO TicAPP tem como missão apoiar as diferentes áreas governativas, no seu processo de transformação digital, através de recursos humanos especializados em tecnologias emergentes neste domínio, desenvolvendo projetos transversais à Administração Pública e melhorando, em simultâneo, a contratação de serviços externos nas áreas das tecnologias de informação e comunicação, com os correspondentes ganhos em eficiência e eficácia.\\n\\n\",\"extras\":{},\"id\":\"607559b4454ae380c7a15bc3\",\"last_modified\":\"2026-06-09T12:16:06.549000+00:00\",\"logo\":\"https://dados.gov.pt/s/avatars/de/276900201e44d7aad2dc22c67d1e25-original.png\",\"logo_thumbnail\":\"https://dados.gov.pt/s/avatars/de/276900201e44d7aad2dc22c67d1e25-100.png\",\"members\":[{\"label\":\