ds\":771,\"reuse_views\":0,\"reuses\":0,\"reuses_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"reuses_followers_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"views\":30854},\"name\":\"Instituto dos Registos e do Notariado\",\"page\":\"https://dados.gov.pt/organizations/instituto-dos-registos-e-do-notariado\",\"permissions\":{\"delete\":false,\"edit\":false,\"harvest\":false,\"members\":false,\"private\":false},\"slug\":\"instituto-dos-registos-e-do-notariado\",\"uri\":\"https://dados.gov.pt/api/1/organizations/instituto-dos-registos-e-do-notariado/\",\"url\":null},{\"acronym\":\"Arquivo.pt\",\"badges\":[{\"kind\":\"public-service\"},{\"kind\":\"certified\"}],\"business_number_id\":null,\"created_at\":\"2021-04-27T12:56:39.856000+00:00\",\"deleted\":null,\"description\":\"O Arquivo.pt permite pesquisar e aceder a páginas da web preservadas desde 1996.\\n\\nO Arquivo.pt é um serviço público gerido pela Fundação para a Ciência e a Tecnologia (FCT) que arquiva continuamente os conteúdos de websites de interesse para a comunidade portuguesa.\\n\\nO Arquivo.pt disponibiliza acesso aos dados abertos resultantes destes arquivos históricos, permitindo por exemplo, aceder à informação oficial publicada em websites da Administração Pública e dos sucessivos Governos.\\n\\nEm 2021, o Arquivo.pt disponibilizava acesso aberto a mais de 10 000 milhões de ficheiros (721 TB) oriundos de 27 milhões de websites.\\n \\nOs dados abertos preservados pelo Arquivo.pt podem ser explorados automaticamente através de API (https://arquivo.pt/api).\\n\\n\\n\\n\",\"extras\":{},\"id\":\"6087fbf7454ae34be8d6ce4e\",\"last_modified\":\"2026-09-11T10:18:48.595000+00:00\",\"logo\":\"https://dados.gov.pt/s/avatars/4d/371c6f310f45da9542656aa55361cb-original.png\",\"logo_thumbnail\":\"https://dados.gov.pt/s/avatars/4d/371c6f310f45da9542656aa55361cb-100.png\",\"members\":[{\"label\":\"Administrador\",\"role\":\"admin\",\"since\":\"2021-04-27T12:56:39.857000+00:00\",\"user\":{\"avatar\":\"https://dados.gov.pt/s/avatars/42/8a7936cef0446fa5093a1af12d8487-original.jpg\",\"avatar_thumbnail\":\"https://dados.gov.pt/s/avatars/42/8a7936cef0446fa5093a1af12d8487-500.jpg\",\"class\":\"User\",\"email\":\"***@arquivo.pt\",\"first_name\":\"Arquivo\",\"id\":\"6087f754454ae335abab6644\",\"last_login_at\":null,\"last_name\":\"PT\",\"page\":\"https://dados.gov.pt/users/daniel-gomes\",\"slug\":\"daniel-gomes\",\"uri\":\"https://dados.gov.pt/api/1/users/daniel-gomes/\"}},{\"label\":\"Editor\",\"role\":\"editor\",\"since\":\"2021-07-27T10:54:26.160000+00:00\",\"user\":{\"avatar\":null,\"avatar_thumbnail\":null,\"class\":\"User\",\"email\":\"***@gmail.com\",\"first_name\":\"Paulo\",\"id\":\"60ffd789078190ec99adc2d3\",\"last_login_at\":null,\"last_name\":\"Cabrita\",\"page\":\"https://dados.gov.pt/users/paulo-cabrita\",\"slug\":\"paulo-cabrita\",\"uri\":\"https://dados.gov.pt/api/1/users/paulo-cabrita/\"}},{\"label\":\"Editor\",\"role\":\"editor\",\"since\":\"2021-07-27T10:54:36.781000+00:00\",\"user\":{\"avatar\":null,\"avatar_thumbnail\":null,\"class\":\"User\",\"email\":\"***@fccn.pt\",\"first_name\":\"Vasco\",\"id\":\"60ffd787078190ec8d3c532a\",\"last_login_at\":null,\"last_name\":\"Rato\",\"page\":\"https://dados.gov.pt/users/vasco-rato\",\"slug\":\"vasco-rato\",\"uri\":\"https://dados.gov.pt/api/1/users/vasco-rato/\"}},{\"label\":\"Administrador\",\"role\":\"admin\",\"since\":\"2021-07-27T10:54:54.112000+00:00\",\"user\":{\"avatar\":null,\"avatar_thumbnail\":null,\"class\":\"User\",\"email\":\"***@fccn.pt\",\"first_name\":\"Pedro\",\"id\":\"60ffd796078190eccfa06489\",\"last_login_at\":null,\"last_name\":\"Gomes\",\"page\":\"https://dados.gov.pt/users/pedro-gomes-1\",\"slug\":\"pedro-go