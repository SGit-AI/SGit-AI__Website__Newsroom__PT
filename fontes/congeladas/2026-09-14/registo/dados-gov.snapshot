5-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"datasets_followers_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"datasets_reuses_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"followers\":3,\"members\":2,\"resource_downloads\":2710,\"reuse_views\":0,\"reuses\":0,\"reuses_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"reuses_followers_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"views\":761},\"name\":\"Comunidade Intermunicipal do Alto Tâmega e Barroso\",\"page\":\"https://dados.gov.pt/organizations/comunidade-intermunicipal-do-alto-tamega-e-barroso\",\"permissions\":{\"delete\":false,\"edit\":false,\"harvest\":false,\"members\":false,\"private\":false},\"slug\":\"comunidade-intermunicipal-do-alto-tamega-e-barroso\",\"uri\":\"https://dados.gov.pt/api/1/organizations/comunidade-intermunicipal-do-alto-tamega-e-barroso/\",\"url\":\"https://cimat.pt\"},{\"acronym\":\"SRMP_GRA\",\"badges\":[],\"business_number_id\":null,\"created_at\":\"2023-10-09T16:32:19.930000+00:00\",\"deleted\":null,\"description\":\"\\\"A SRMP exerce competência no âmbito da definição e execução da política regional em matéria de oceanografia, pescas e aquicultura, valorização e preservação do meio marinho, bem como outros assuntos relacionados com o mar, designadamente o ordenamento e gestão da orla costeira e das áreas marinhas protegidas e o ordenamento do espaço marítimo. \\n\\nTendo por base uma visão global de promoção de um oceano saudável, através de uma economia azul sustentável, assume particular relevo a estratégia regional para o Mar dos Açores, bem como o Plano de Ordenamento do Espaço Marítimo dos Açores, enquanto elementos estruturantes para desenvolver e potenciar a economia do mar.\\\"\",\"extras\":{},\"id\":\"65241d0361cc3d5344dcda63\",\"last_modified\":\"2026-06-09T12:15:55.868000+00:00\",\"logo\":\"https://dados.gov.pt/s/avatars/4b/5f747df8a349cb9f09114604ca6e09-original.png\",\"logo_thumbnail\":\"https://dados.gov.pt/s/avatars/4b/5f747df8a349cb9f09114604ca6e09-100.png\",\"members\":[{\"label\":\"Administrador\",\"role\":\"admin\",\"since\":\"2023-10-09T16:32:40.696000+00:00\",\"user\":{\"avatar\":null,\"avatar_thumbnail\":null,\"class\":\"User\",\"email\":\"***@azores.gov.pt\",\"first_name\":\"Paulo\",\"id\":\"65115f3db457c8f96380f35f\",\"last_login_at\":null,\"last_name\":\"Miranda\",\"page\":\"https://dados.gov.pt/users/paulo-miranda\",\"slug\":\"paulo-miranda\",\"uri\":\"https://dados.gov.pt/api/1/users/paulo-miranda/\"}}],\"metrics\":{\"dataservice_views\":0,\"dataservices\":0,\"dataservices_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"datasets\":42,\"datasets_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":10,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"datasets_followers_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"datasets_reuses_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"followers\":1,\"members\":1,\"resource_downloads\":0,\"reuse_views\":0,\"reuses\":0,\"reuses_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"reuses_followers_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"views\":75},\"name\":\"Secretaria Regional do Mar e das Pescas / Governo dos Açores\",\"page\":\"https://dados.gov.pt/organizations/secretaria-regional-do-mar-e-das-pescas-governo-dos-acores\",\"permissions\":{\"delete\":false,\"edit\":false,\"harvest\":false,\"members\":false,\"private\":false},\"slug\":\"secretaria-regional-do-mar-e-das-pescas-governo-dos-acores\",\"uri\":\"https://dados.gov.pt/api/1/organizations/secretaria-regional-do-mar-e-das-pescas-governo-dos-acores/\",\"url\":\"https://portal.azores.gov.pt/web/srmp\"},{\"acronym\":\"INFARMED\",\"badges\":[{\"kind\":\"public-service\"},{\"kind\":\"certified\"}],\"business_number_id\":null,\"created_at\":\"2018-05-22T11:52:43.288000+00:00\",\"deleted\":null,\"description\":\"O INFARMED, I. P. presta e recebe colaboração dos serviços e organismos da administração directa e indirecta ou autónoma do Estado, no âmbito das suas atribuições. No âmbito das suas atribuições, o INFARMED I.P., pode, nos termos previstos na lei, estabelecer parcerias ou associar-se com outras entidades do setor público ou privado, com ou sem fins lucrativos, designadamente associações empresariais, universidades ou instituições e serviços integrados no Serviço Nacional de Saúde.\\n\\nDecorrente da publicação da nova lei orgânica, INFARMED, I.P. adquiriu novas competências em matéria de autorização do PVP (preço de venda ao público) dos medicamentos sujeitos a receita médica e não sujeitos a receita médica comparticipados, por transferência de competências desta matéria do Ministério da Economia para o Ministério da Saúde.\",\"extras\":{},\"id\":\"5b03f67bc8d8c939b9576395\",\"last_modified\":\"2026-06-09T12:16:22.457000+00:00\",\"logo\":\"https://dados.gov.pt/s/avatars/7c/0a511e78594bc397b06665de1e45a9-original.jpg\",\"logo_thumbnail\":\"https://dados.gov.pt/s/avatars/7c/0a511e78594bc397b06665de1e45a9-100.jpg\",\"members\":[],\"metrics\":{\"dataservice_views\":0,\"dataservices\":0,\"dataservices_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"datasets\":41,\"datasets_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"datasets_followers_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"datasets_reuses_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"followers\":0,\"members\":0,\"resource_downloads\":915,\"reuse_views\":0,\"reuses\":0,\"reuses_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"reuses_followers_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"views\":576},\"name\":\"INFARMED\",\"page\":\"https://dados.gov.pt/organizations/infarmed\",\"permissions\":{\"delete\":false,\"edit\":false,\"harvest\":false,\"members\":false,\"private\":false},\"slug\":\"infarmed\",\"uri\":\"https://dados.gov.pt/api/1/organizations/infarmed/\",\"url\":\"http://www.infarmed.pt/\"},{\"acronym\":\"INEM\",\"badges\":[{\"kind\":\"public-service\"},{\"kind\":\"certified\"}],\"business_number_id\":null,\"created_at\":\"2018-05-22T11:52:43.564000+00:00\",\"deleted\":null,\"description\":\"O INEM – Instituto Nacional de Emergência Médica é o organismo do Ministério da Saúde responsável por coordenar o funcionamento, no território de Portugal Continental, do Sistema Integrado de Emergência Médica (SIEM), de forma a garantir aos sinistrados ou vítimas de doença súbita a pronta e correcta prestação de cuidados de saúde.\\n\\nA prestação de cuidados de emergência no local da ocorrência, o transporte assistido das vítimas para o hospital adequado e a articulação entre os vários intervenientes no SIEM – (hospitais, corpos de bombeiros, polícia de segurança pública, cruz vermelha portuguesa), é a missão do INEM.\\n\\nO INEM, através do Número Europeu de Emergência 112, coordena vários serviços e meios para responder com eficácia, a qualquer situação de emergência médica.\",\"extras\":{},\"id\":\"5b03f67bc8d8c939b9576396\",\"last_modified\":\"2026-06-09T12:16:22.206000+00:00\",\"logo\":\"https://dados.gov.pt/s/avatars/b1/2ff16aa1a24eb090802de6b98b480c-original.jpg\",\"logo_thumbnail\":\"https://dados.gov.pt/s/avatars/b1/2ff16aa1a24eb090802de6b98b480c-100.jpg\",\"members\":[],\"metrics\":{\"dataservice_views\":0,\"dataservices\":0,\"dataservices_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"datasets\":34,\"datasets_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},