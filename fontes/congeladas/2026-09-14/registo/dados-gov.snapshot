{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"datasets_followers_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"datasets_reuses_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"followers\":0,\"members\":1,\"resource_downloads\":62,\"reuse_views\":263,\"reuses\":6,\"reuses_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"reuses_followers_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"views\":125},\"name\":\"Redes Energéticas Nacionais\",\"page\":\"https://dados.gov.pt/organizations/redes-energeticas-nacionais\",\"permissions\":{\"delete\":false,\"edit\":false,\"harvest\":false,\"members\":false,\"private\":false},\"slug\":\"redes-energeticas-nacionais\",\"uri\":\"https://dados.gov.pt/api/1/organizations/redes-energeticas-nacionais/\",\"url\":\"https://datahub.ren.pt\"},{\"acronym\":\"IGF\",\"badges\":[],\"business_number_id\":null,\"created_at\":\"2022-03-15T19:19:19.716000+00:00\",\"deleted\":null,\"description\":\"A IGF-Autoridade de Auditoria é um serviço do Ministério das Finanças integrado na administração direta do Estado, dotado de autonomia administrativa, que funciona na direta dependência do Ministro das Finanças.\\n\\nA sua intervenção abrange todas as entidades do setor público administrativo, incluindo autarquias locais, entidades equiparadas e demais formas de organização territorial autárquica e empresarial, bem como dos setores privado e cooperativo, neste caso quando sujeitos de relações financeiras ou tributárias com o Estado ou com a União Europeia, ou quando se mostre indispensável ao controlo indireto de quaisquer entidades abrangidas pela sua ação.\",\"extras\":{},\"id\":\"6230e6b70781900a2a578f59\",\"last_modified\":\"2026-06-09T12:16:00.809000+00:00\",\"logo\":\"https://dados.gov.pt/s/avatars/d9/13be7f64da4a31b9668734144f4245-original.png\",\"logo_thumbnail\":\"https://dados.gov.pt/s/avatars/d9/13be7f64da4a31b9668734144f4245-100.png\",\"members\":[{\"label\":\"Administrador\",\"role\":\"admin\",\"since\":\"2022-03-15T19:19:19.716000+00:00\",\"user\":{\"avatar\":\"https://dados.gov.pt/s/avatars/76/58a528a2154ab6b5d045988d148d25-original.png\",\"avatar_thumbnail\":\"https://dados.gov.pt/s/avatars/76/58a528a2154ab6b5d045988d148d25-500.png\",\"class\":\"User\",\"email\":\"***@igf.gov.pt\",\"first_name\":\"Inspeção-Geral de Finanças\",\"id\":\"6230e321078190f9cd33e9f6\",\"last_login_at\":null,\"last_name\":\"Autoridade de Auditoria\",\"page\":\"https://dados.gov.pt/users/inspecao-geral-de-financas-autoridade-de-auditoria\",\"slug\":\"inspecao-geral-de-financas-autoridade-de-auditoria\",\"uri\":\"https://dados.gov.pt/api/1/users/inspecao-geral-de-financas-autoridade-de-auditoria/\"}}],\"metrics\":{\"dataservice_views\":0,\"dataservices\":0,\"dataservices_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"datasets\":6,\"datasets_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":1,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"datasets_followers_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"20