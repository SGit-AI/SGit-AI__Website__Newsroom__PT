":0},\"reuses_followers_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"views\":2836},\"name\":\"Ministério da Defesa Nacional\",\"page\":\"https://dados.gov.pt/organizations/ministerio-da-defesa-nacional\",\"permissions\":{\"delete\":false,\"edit\":false,\"harvest\":false,\"members\":false,\"private\":false},\"slug\":\"ministerio-da-defesa-nacional\",\"uri\":\"https://dados.gov.pt/api/1/organizations/ministerio-da-defesa-nacional/\",\"url\":\"https://www.defesa.gov.pt/\"},{\"acronym\":\"INSA\",\"badges\":[{\"kind\":\"certified\"},{\"kind\":\"public-service\"}],\"business_number_id\":null,\"created_at\":\"2018-05-22T11:52:43.859000+00:00\",\"deleted\":null,\"description\":\"O Instituto Nacional de Saúde Doutor Ricardo Jorge (Instituto Ricardo Jorge) é um organismo público integrado na administração indireta do Estado, sob a tutela do Ministério da Saúde, dotado de autonomia científica, técnica, administrativa, financeira e património próprio.\\n\\nFundado em 1899 pelo médico e humanista Ricardo Jorge (Porto, 1858 – Lisboa, 1939), como braço laboratorial do sistema de saúde português, o Instituto Ricardo Jorge desenvolve uma tripla missão como laboratório do Estado no setor da saúde, laboratório nacional de referência e observatório nacional de saúde.\\n\\nO Instituto Ricardo Jorge dispõe de unidades operativas na sua sede em Lisboa, em centros no Porto (Centro de Saúde Pública Doutor Gonçalves Ferreira) e em Águas de Moura (Centro de Estudos de Vectores e Doenças Infecciosas Doutor Francisco Cambournac).\",\"extras\":{},\"id\":\"5b03f67bc8d8c939b9576399\",\"last_modified\":\"2026-06-09T12:16:21.199000+00:00\",\"logo\":\"https://dados.gov.pt/s/avatars/82/ce3f0a62e14304bad5aa15be962673-original.jpg\",\"logo_thumbnail\":\"https://dados.gov.pt/s/avatars/82/ce3f0a62e14304bad5aa15be962673-100.jpg\",\"members\":[],\"metrics\":{\"dataservice_views\":0,\"dataservices\":0,\"dataservices_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"datasets\":25,\"datasets_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"datasets_followers_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"datasets_reuses_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"followers\":1,\"members\":0,\"resource_downloads\":496,\"reuse_views\":0,\"reuses\":0,\"reuses_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"reuses_followers_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"views\":791},\"name\":\"Instituto Nacional de Saúde Dr. Ricardo Jorge (INSA), IP\",\"page\":\"https://dados.gov.pt/organizations/insa\",\"permissions\":{\"delete\":false,\"edit\":false,\"harvest\":false,\"members\":false,\"private\":false},\"slug\":\"insa\",\"uri\":\"https://dados.gov.pt/api/1/organizations/insa/\",\"url\":\"http://www.insa.pt/\"},{\"acronym\":\"ANEPC\",\"badges\":[],\"business_number_id\":null,\"created_at\":\"2021-06-23T17:47:59.587000+00:00\",\"deleted\":null,\"description\":\"A ANEPC é a autoridade nacional em matéria de emergência e proteção civil, sendo um serviço central, da administração direta do Estado, dotado de autonomia administrativa e financeira e património próprio.\\n \\nA ANEPC tem por missão planear, coordenar e executar as políticas de emergência e de proteção civil, designadamente na prevenção e na resposta a acidentes graves e catástrofes, de proteção e socorro de populações, coordenação dos agentes de proteção civil, nos termos legalmente previstos, e assegurar o planeamento e coordenação das necessidades nacionais na área do planeamento civil de emergência, com vista a fazer face a situações de crise ou de guerra.\",\"extras\":{},\"id\":\"60d365bf078190799dd5ffe2\",\"last_modified\":\"2026-09-11T16:28:47.895000+00:00\",\"logo\":\"https://dados.gov.pt/s/avatars/56/99745a680c4e3aa0b2e6ea6e60db23-original.png\",\"logo_thumbnail\":\"https://dados.gov.pt/s/avatars/56/99745a680c4e3aa0b2e6ea6e60db23-100.png\",\"members\":[{\"label\":\"Administrador\",\"role\":\"admin\",\"since\":\"2021-09-21T10:50:37.713000+00:00\",\"user\":{\"avatar\":\"https://dados.gov.pt/s/avatars/bf/ec4a95fad74d138c2dc36098acfe80-original.jpg\",\"avatar_thumbnail\":\"https://dados.gov.pt/s/avatars/bf/ec4a95fad74d138c2dc36098acfe80-500.jpg\",\"class\":\"User\",\"email\":\"***@prociv.pt\",\"first_name\":\"Autoridade Nacional de Emergência e\",\"id\":\"611b6ad80781909a31fb2ce6\",\"last_login_at\":null,\"last_name\":\"Proteção Civil\",\"page\":\"https://dados.gov.pt/users/autoridade-nacional-de-emergencia-protecao-civil\",\"slug\":\"autoridade-nacional-de-emergencia-protecao-civil\",\"uri\":\"https://dados.gov.pt/api/1/users/autoridade-nacional-de-emergencia-protecao-civil/\"}},{\"label\":\"Administrador\",\"role\":\"admin\",\"since\":\"2024-02-21T14:36:59.656000+00:00\",\"user\":{\"avatar\":null,\"avatar_thumbnail\":null,\"class\":\"User\",\"email\":\"***@prociv.pt\",\"first_name\":\"Pedro\",\"id\":\"6504275445a8cdcffe5a4044\",\"last_login_at\":null,\"last_name\":\"Barbosa\",\"page\":\"https://dados.gov.pt/users/pedro-barbosa\",\"sl