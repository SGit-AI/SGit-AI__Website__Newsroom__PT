cial\",\"cartografia-tematica\",\"cos\",\"cos2018\",\"cos2018v4-s2\",\"cos2025\",\"cos2025v1-s2\",\"dgt\",\"dgt-prr\",\"hvd\",\"infofeatureaccessservice\",\"infomapaccessservice\",\"observacao-da-terra-e-do-ambiente\",\"ocupacao-do-solo\",\"ogc-api\",\"planeamento-e-cadastro\",\"portugal-continental\",\"smos\",\"snig-dgterritorio-gov-pt\",\"uso-do-solo\"],\"temporal_coverage\":null,\"title\":\"Carta de Uso e Ocupação do Solo (COS) - Série 2 - (2018v4 - 2025v1)\",\"uri\":\"https://dados.gov.pt/api/1/datasets/carta-de-uso-e-ocupacao-do-solo-cos-serie-2-2018v4-2025v1/\"},{\"access_audiences\":[],\"access_type\":\"open\",\"access_type_reason\":null,\"access_type_reason_category\":null,\"acronym\":null,\"archived\":null,\"authorization_request_url\":null,\"badges\":[],\"contact_points\":[],\"created_at\":\"2026-09-01T18:16:02.617000+00:00\",\"deleted\":null,\"description\":\"$21\",\"description_short\":\"Este conjunto de dados identifica os websites e os canais em redes sociais das corporações de bombeiros em Portugal e fornece um link para o histórico preservado no Arquivo.pt, no caso de existir u...\",\"extras\":{},\"featured\":false,\"frequency\":\"punctual\",\"frequency_date\":null,\"harvest\":null,\"id\":\"6a9716623e7b76ae5cbe7d23\",\"internal\":{\"created_at_internal\":\"2026-09-01T18:16:02.617000+00:00\",\"last_modified_internal\":\"2026-09-09T17:33:06.939000+00:00\"},\"last_modified\":\"2026-09-09T17:33:06.939000+00:00\",\"last_update\":\"2026-09-01T18:18:00.489000+00:00\",\"license\":\"cc-by\",\"license_title\":\"Creative Commons Attribution 4.0 - CC BY 4.0\",\"metrics\":{\"dataservices\":0,\"discussions\":0,\"discussions_open\":0,\"followers\":0,\"followers_by_months\":0,\"resources_downloads\":62,\"reuses\":0,\"reuses_by_months\":0,\"views\":2721},\"organization\":{\"acronym\":\"Arquivo.pt\",\"badges\":[{\"kind\":\"public-service\"},{\"kind\":\"certified\"}],\"class\":\"Organization\",\"id\":\"6087fbf7454ae34be8d6ce4e\",\"logo\":\"https://dados.gov.pt/s/avatars/4d/371c6f310f45da9542656aa55361cb-original.png\",\"logo_thumbnail\":\"https://dados.gov.pt/s/avatars/4d/371c6f310f45da9542656aa55361cb-100.png\",\"name\":\"Arquivo.pt - pesquise páginas do passado\",\"page\":\"https://dados.gov.pt/organizations/arquivo-pt-pesquise-paginas-do-passado\",\"permissions\":{\"delete\":false,\"edit\":false,\"harvest\":false,\"members\":false,\"private\":false},\"slug\":\"arquivo-pt-pesquise-paginas-do-passado\",\"uri\":\"https://dados.gov.pt/api/1/organizations/arquivo-pt-pesquise-paginas-do-passado/\"},\"owner\":null,\"page\":\"https://dados.gov.pt/datasets/bombeiros-em-portugal-websites-e-historico-preservado-no-arquivo-pt\",\"permissions\":{\"delete\":false,\"edit\":false,\"edit_resources\":false},\"private\":false,\"quality\":{\"all_resources_available\":true,\"dataset_description_quality\":true,\"has_open_format\":true,\"has_resources\":true,\"license\":true,\"resources_documentation\":true,\"score\":1,\"spatial\":true,\"temporal_coverage\":true,\"update_frequency\":true,\"update_fulfilled_in_time\":true},\"resources\":[{\"checksum\":{\"type\":\"sha1\",\"value\":\"7c7d6b40cf41c383ab295c32007feabbdd0c59ed\"},\"created_at\":\"2026-09-01T18:18:00.451000+00:00\",\"description\":\"Este conjunto de dados identifica os websites e os canais em redes sociais das corporações de bombeiros em Portugal e fornece um link para o histórico preservado no Arquivo.pt, no caso de existir um.As listas de websites do Arquivo.pt têm por objetivo mostrar a riqueza deste tipo de informação e promover a sua preservação.Os endereços dos websites oficiais das entidades foram identificados no final de agosto de 2026. Verificou-se que alguns endereços anteriormente utilizados deixaram de estar ativos. No entanto, é sempre possível pesquisar no Arquivo.pt para verificar se alguns conteúdos da Web do passado ficaram gravados. Um facto notório é a utilização generalizada do Facebook que, em muitos casos, passou a ser o principal canal oficial. A preservação digital dos conteúdos publicados em plataformas fechadas como o Facebook é extramamente limitada.\",\"extras\":{},\"filesize\":258862,\"filetype\":\"file\",\"format\":\"pdf\",\"harvest\":null,\"id\":\"cdc70864-af1a-4e00-9de3-95eeaa801dd8\",\"internal\":{\"created_at_internal\":\"2026-09-01T18:18:00.451000+00:00\",\"last_modified_internal\":\"2026-09-01T18:18:00.489000+00:00\"},\"last_modified\":\"2026-09-01T18:18:00.489000+00:00\",\"latest\":\"https://dados.gov.pt/api/1/datasets/r/cdc70864-af1a-4e00-9de3-95eeaa801dd8\",\"metrics\":{\"views\":26},\"mime\":\"application/pdf\",\"preview_url\":null,\"schema\":null,\"title\":\"Bombeiros em Portugal_ websites e histórico preservado no Arquivo.pt - Bombeiros em Portugal - 2026\",\"type\":\"main\",\"url\":\"https://dados.gov.pt/s/resources/bombeiros-em-portugal-websites-e-historico-preservado-no-arquivo-pt/20260901-181800-50f3e68c/bombeiros-em-portugal-websites-e-historico-preservado-no-arquivo.pt-bombeiros-em-portugal-2026.pdf\"},{\"checksum\":{\"type\":\"sha1\",\"value\":\"25a8188b83b6bd7a4793ac225374ced6bddc8603\"},\"created_at\":\"2026-09-01T18:18:00.272000+00:00\",\"description\":\"Este conjunto de dados identifica os websites e os canais em redes sociais das corporações de bombeiros em Portugal e fornece um link para o histórico preservado no Arquivo.pt, no caso de existir um.As listas de websites do Arquivo.pt têm por objetivo mostrar a riqueza deste tipo de informação e promover a sua preservação.Os endereços dos websites oficiais das entidades foram identificados no final de agosto de 2026. Verificou-se que alguns endereços anteriormente utilizados deixaram de estar ativos. No entanto, é sempre possível pesquisar no Arquivo.pt para verificar se alguns conteúdos da Web do passado ficaram gravados. Um facto notório é a utilização generalizada do Facebook que, em muitos casos, passou a ser o principal canal oficial. A preservação digital dos conteúdos publicados em plataformas fechadas como o Facebook é extramamente limitada.\",\"extras\":{},\"filesize\":135384,\"filetype\":\"file\",\"format\":\"csv\",\"harvest\":null,\"id\":\"9e65385c-db9e-4791-baf4-2235719b5d9d\",\"internal\":{\"created_at_internal\":\"2026-09-01T18:18:00.272000+00:00\",\"last_modified_internal\":\"2026-09-01T18:18:00.353000+00:00\"},\"last_modified\":\"2026-09-01T18:18:00.353000+00:00\",\"latest\":\"https://dados.gov.pt/api/1/datasets/r/9e65385c-db9e-4791-baf4-2235719b5d9d\",\"metrics\":{\"views\":21},\"mime\":\"text/csv\",\"preview_url\":null,\"schema\":null,\"title\":\"Bombeiros em Portugal_ websites e histórico preservado no Arquivo.pt - Bombeiros em Portugal - 2026\",\"type\":\"main\",\"url\":\"https://dados.gov.pt/s/resources/bombeiros-em-portugal-websites-e-historico-preservado-no-arquivo-pt/20260901-181800-a336ac61/bombeiros-em-portugal-websites-e-historico-preservado-no-arquivo.pt-bombeiros-em-portugal-2026.csv\"},{\"checksum\":{\"type\":\"sha1\",\"value\":\"1d558e2b3cbe628232217592a502dcea86222805\"},\"created_at\":\"2026-09-01T18:18:00.155000+00:00\",\"description\":\"Este conjunto de dados identifica os websites e os canais em redes sociais das corporações de bombeiros em Portugal e fornece um link para o histórico preservado no Arquivo.pt, no caso de existir um.As listas de websites do Arquivo.pt têm por objetivo mostrar a riqueza deste tipo de informação e promover a sua preservação.Os endereços dos websites oficiais das entidades foram identificados no final de agosto de 2026. Verificou-se que alguns endereços anteriormente utilizados deixaram de estar ativos. No entanto, é sempre possível pesquisar no Arquivo.pt para verificar se alguns conteúdos da Web do passado ficaram gravados. Um facto notório é a utilização generalizada do Facebook que, em muitos casos, passou a ser o principal canal oficial. A preservação digital dos conteúdos publicados em plataformas fechadas como o Facebook é extramamente limitada.\",\"extras\":{},\"filesize\":48497,\"filetype\":\"file\",\"format\":\"ods\",\"harvest\":null,\