817},\"name\":\"Direcção-Geral das Autarquias Locais\",\"page\":\"https://dados.gov.pt/organizations/direccao-geral-das-autarquias-locais\",\"permissions\":{\"delete\":false,\"edit\":false,\"harvest\":false,\"members\":false,\"private\":false},\"slug\":\"direccao-geral-das-autarquias-locais\",\"uri\":\"https://dados.gov.pt/api/1/organizations/direccao-geral-das-autarquias-locais/\",\"url\":\"http://www.portalautarquico.dgal.gov.pt\"},{\"acronym\":\"ICNF\",\"badges\":[{\"kind\":\"certified\"},{\"kind\":\"public-service\"}],\"business_number_id\":null,\"created_at\":\"2023-10-06T17:07:35.554000+00:00\",\"deleted\":null,\"description\":\"O **Instituto da Conservação da Natureza e das Florestas, I. P.**, é um instituto público integrado na administração indireta do Estado, dotado de autonomia administrativa e financeira, com jurisdição sobre todo o território nacional. É simultaneamente Autoridade Nacional para a Conservação da Natureza e biodiversidade e Autoridade Florestal Nacional.\",\"extras\":{},\"id\":\"652030c73a3c081c67ff8d22\",\"last_modified\":\"2026-07-16T10:31:01.627000+00:00\",\"logo\":\"https://dados.gov.pt/s/avatars/fe/45fd7d612740428e8d8b8d0d91d68e-original.png\",\"logo_thumbnail\":\"https://dados.gov.pt/s/avatars/fe/45fd7d612740428e8d8b8d0d91d68e-100.png\",\"members\":[{\"label\":\"Administrador\",\"role\":\"admin\",\"since\":\"2023-10-11T11:58:06.874000+00:00\",\"user\":{\"avatar\":null,\"avatar_thumbnail\":null,\"class\":\"User\",\"email\":\"***@icnf.pt\",\"first_name\":\"Teresa\",\"id\":\"65266d0d695b72ab63220cf9\",\"last_login_at\":null,\"last_name\":\"Pimenta\",\"page\":\"https://dados.gov.pt/users/teresa-pimenta\",\"slug\":\"teresa-pimenta\",\"uri\":\"https://dados.gov.pt/api/1/users/teresa-pimenta/\"}}],\"metrics\":{\"dataservice_views\":0,\"dataservices\":0,\"dataservices_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-0