os-abertos\":\"Sobre dados abertos\",\"licencas\":\"Licenças\",\"desenvolvimento\":\"Desenvolvimento\",\"tutorial-api\":\"Tutorial API\",\"referencia-api\":\"Referência API\",\"acesso-via-sparql\":\"Acesso via SPARQL\",\"aprender\":\"Aprender\",\"minicursos\":\"Minicursos\",\"login\":\"Autenticação\",\"reset-password\":\"Redefinir palavra-passe\",\"migrate-account\":\"Migrar conta\"},\"close\":\"Fechar\",\"cancel\":\"Cancelar\",\"publish\":\"Publicar\",\"publishSelection\":{\"dataset\":\"Um conjunto de dados\",\"api\":\"Uma API\",\"reuse\":\"Uma reutilização\",\"harvester\":\"Um harvester\",\"organization\":\"Uma organização\"},\"listingError\":{\"title\":\"Não foi possível carregar\",\"subtitle\":\"Ocorreu um erro ao contactar o servidor. Tente novamente dentro de momentos.\"},\"apiError\":{\"serverErrorTitle\":\"Serviço indisponível\",\"serverErrorDescription\":\"Ocorreu um erro no servidor. Tente novamente dentro de momentos.\",\"networkErrorTitle\":\"Sem ligação\",\"networkErrorDescription\":\"Não foi possível contactar o servidor. Verifique a sua ligação à Internet.\",\"sessionExpiredTitle\":\"Sessão expirada\",\"sessionExpiredDescription\":\"Inicie sessão novamente para continuar.\",\"pageErrorTitle\":\"Não foi possível carregar esta página\",\"pageErrorSubtitle\":\"O serviço pode estar temporariamente indisponível.\",\"pageErrorDescription\":\"Tente novamente dentro de instantes. Se o problema persistir, contacte o suporte.\",\"pageErrorReference\":\"Referência: {{digest}}\",\"backToHome\":\"Voltar à página inicial\"},\"retry\":\"Tentar novamente\",\"discussions\":{\"title\":\"Título *\",\"message\":\"Mensagem *\",\"cancel\":\"Cancelar\",\"update\":\"Atualizar\",\"updating\":\"A atualizar...\",\"deleteWarning\":\"Essa ação é irreversível.\",\"deleteDiscussionWarning\":\"Essa ação é irreversível. Todos os comentários nesta discussão também serão apagados.\",\"emailNotification\":\"Notificação por e-mail\",\"automaticEmail\":\"Enviar um e-mail automático (opçõe