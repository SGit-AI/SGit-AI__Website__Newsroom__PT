"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"datasets_reuses_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":1,\"2026-06\":0},\"followers\":9,\"members\":5,\"resource_downloads\":2748,\"reuse_views\":0,\"reuses\":0,\"reuses_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"reuses_followers_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"views\":894},\"name\":\"Agência para o Desenvolvimento e Coesão, IP\",\"page\":\"https://dados.gov.pt/organizations/agencia-para-o-desenvolvimento-e-coesao-ip\",\"permissions\":{\"delete\":false,\"edit\":false,\"harvest\":false,\"members\":false,\"private\":false},\"slug\":\"agencia-para-o-desenvolvimento-e-coesao-ip\",\"uri\":\"https://dados.gov.pt/api/1/organizations/agencia-para-o-desenvolvimento-e-coesao-ip/\",\"url\":\"https://www.adcoesao.pt/\"},{\"acronym\":\"DGAEP\",\"badges\":[{\"kind\":\"public-service\"},{\"kind\":\"certified\"}],\"business_number_id\":null,\"created_at\":\"2023-10-10T13:44:23.043000+00:00\",\"deleted\":null,\"description\":\"A DGAEP é o organismo da Administração Pública com responsabilidades no domínio da gestão dos recursos humanos. A sua lei orgânica, Decreto Regulamentar n.º 27/2012, de 29 de fevereiro, estabelece-lhe como missão apoiar a definição das políticas para a Administração Pública nos domínios da organização e da gestão, dos regimes de emprego e da gestão de recursos humanos, assegurar a informação e dinamização das medidas adotadas e contribuir para a avaliação da sua execução.\\n\\nÉ um serviço transversal da Administração Direta do Estado, e integrado na área de governo das Finanças, dotado de autonomia administrativa, com funções de estudo, conceção, coordenação e apoio técnico ao governo na definição das políticas que respeitam à Administração Pública.\\n\\nVisite-nos em [dgaep.gov.pt](https://www.dgaep.gov.pt/). Saiba mais sobre a nossa missão e o modo como nos organizamos.\",\"extras\":{},\"id\":\"65254727955372c3a8c5efc2\",\"last_modified\":\"2026-06-09T12:15:55.341000+00:00\",\"logo\":\"https://dados.gov.pt/s/avatars/a3/7c51de19bb48a6a7e3dfc32115eadd-original.png\",\"logo_thumbnail\":\"https://dados.gov.pt/s/avatars/a3/7c51de19bb48a6a7e3dfc32115eadd-100.png\",\"members\":[{\"label\":\"Administrador\",\"role\":\"admin\",\"since\":\"2023-10-10T13:44:23.043000+00:00\",\"user\":{\"avatar\":null,\"avatar_thumbnail\":null,\"class\":\"User\",\"email\":\"***@dgaep.gov.pt\",\"first_name\":\"Miguel\",\"id\":\"65254619955372c3a8c5efc1\",\"last_login_at\":null,\"last_name\":\"Santos\",\"page\":\"https://dados.gov.pt/users/miguel-santos\",\"slug\":\"miguel-santos\",\"uri\":\"https://dados.gov.pt/api/1/users/miguel-santos/\"}},{\"label\":\"Administrador\",\"role\":\"admin\",\"since\":\"2026-03-06T18:07:46.372000+00:00\",\"user\":{\"avatar\":null,\"avatar_thumbnail\":null,\"class\":\"User\",\"email\":\"***@dgaep.gov.pt\",\"first_name\":\"Eliana Filipa\",\"id\":\"6996eee536b882129139ca0b\",\"last_login_at\":null,\"last_name\":\"Amaral Pereira Durão\",\"page\":\"https://dados.gov.pt/users/eliana-filipa-amaral-pereira-durao\",\"slug\":\"eliana-filipa-amaral-pereira-durao\",\"uri\":\"https://dados.gov.pt/api/1/users/eliana-filipa-amaral-pereira-durao/\"}}],\"metrics\":{\"dataservice_views\":0,\"dataservices\":0,\"dataservices_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"datasets\":12,\"datasets_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":3,\"2025-10\":0,\"