":\"5ae9d0c0c8d8c9146d44cc85\",\"last_modified\":\"2026-06-17T02:15:12.585000+00:00\",\"logo\":\"https://dados.gov.pt/s/avatars/40/17c25b873b40d9ba11d674415da164-original.gif\",\"logo_thumbnail\":\"https://dados.gov.pt/s/avatars/40/17c25b873b40d9ba11d674415da164-100.gif\",\"members\":[],\"metrics\":{\"dataservice_views\":0,\"dataservices\":0,\"dataservices_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"datasets\":10,\"datasets_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"datasets_followers_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"datasets_reuses_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"followers\":0,\"members\":0,\"resource_downloads\":0,\"reuse_views\":0,\"reuses\":0,\"reuses_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"reuses_followers_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"views\":379},\"name\":\"DGAJ\",\"page\":\"https://dados.gov.pt/organizations/dgaj\",\"permissions\":{\"delete\":false,\"edit\":false,\"harvest\":false,\"members\":false,\"private\":false},\"slug\":\"dgaj\",\"uri\":\"https://dados.gov.pt/api/1/organizations/dgaj/\",\"url\":null},{\"acronym\":\"igac\",\"badges\":[{\"kind\":\"public-service\"},{\"kind\":\"certified\"}],\"business_number_id\":null,\"created_at\":\"2018-05-02T10:06:40.550000+00:00\",\"deleted\":null,\"description\":\"A Inspeção-geral das Atividades Culturais é um serviço central da administração direta do Estado dotado de autonomia administrativa, que funciona sob a tutela de um membro do Governo responsável pela área da cultura, que tem como objetivos:\\n\\n* Assegurar o cumprimento da legislação da área da Cultura, nomeadamente através da divulgação de normas e da realização de ações de verificação e de inspeção\\n* Assegurar o cumprimento da legislação sobre espetáculos e licenciamento de recintos que tenham por finalidade principal a atividade artística, nomeadamente através da divulgação de normas e da realização de ações de verificação e de inspeção\\n* Superintender no exercício das atividades de edição, reprodução, distribuição, venda, aluguer ou troca de videogramas\\n* Assegurar o cumprimento da legislação sobre os direitos de autor e direitos conexos\\n* Assegurar atividades de inspeção superior e auditoria junto das instituições dependentes ou tuteladas por um membro do Governo responsável pela área da cultura\",\"extras\":{},\"id\":\"5ae97fa0c8d8c915d5faa3bd\",\"last_modified\":\"2026-06-19T13:52:56.766000+00:00\",\"logo\":\"https://dados.gov.pt/s/avatars/b8/6b48aed84f42efaf9c509a20cbde56-original.png\",\"logo_thumbnail\":\"https://dados.gov.pt/s/avatars/b8/6b48aed84f42efaf9c509a20cbde56-100.png\",\"members\":[{\"label\":\"Administrador\",\"role\":\"admin\",\"since\":\"2022-08-03T16:46:15.391000+00:00\",\"user\":{\"avatar\":null,\"avatar_thumbnail\":null,\"class\":\"User\",\"email\":\"***@igac.pt\",\"first_name\":\"IGAC \",\"id\":\"62ea497307819083cb09ee44\",\"last_login_at\":null,\"last_name\":\"Admin\",\"page\":\"https://dados.gov.pt/users/dario-vieira\",\"slug\":\"dario-vieira\",\"uri\":\"https://dados.gov.pt/api/1/users/dario-vieira/\"}},{\"label\":\"Editor\",\"rol