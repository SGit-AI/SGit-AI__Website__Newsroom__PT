o de águas residuais e resíduos sólidos urbanos para os Municipios de Alvaiázere, Ansião, Castanheira de Pera, Figueiró dos Vinhos, Góis, Pampilhosa da Serra, Penela, Pedrogão Grande, Lousã e Vila Nova de Poiares.\",\"extras\":{},\"id\":\"68dfdb96e367f4d214514095\",\"last_modified\":\"2026-06-09T12:15:15.978000+00:00\",\"logo\":\"https://dados.gov.pt/s/avatars/32/a7625a770843ebb941804a5bd10bda-original.png\",\"logo_thumbnail\":\"https://dados.gov.pt/s/avatars/32/a7625a770843ebb941804a5bd10bda-100.png\",\"members\":[{\"label\":\"Administrador\",\"role\":\"admin\",\"since\":\"2025-10-03T14:20:06.093000+00:00\",\"user\":{\"avatar\":null,\"avatar_thumbnail\":null,\"class\":\"User\",\"email\":\"***@gmail.com\",\"first_name\":\"Filipe André\",\"id\":\"68dfd9f14247bebd7d514095\",\"last_login_at\":null,\"last_name\":\"Subtil De Matos\",\"page\":\"https://dados.gov.pt/users/filipe-andre-subtil-de-matos\",\"slug\":\"filipe-andre-subtil-de-matos\",\"uri\":\"https://dados.gov.pt/api/1/users/filipe-andre-subtil-de-matos/\"}},{\"label\":\"Administrador\",\"role\":\"admin\",\"since\":\"2025-10-03T14:22:57.255000+00:00\",\"user\":{\"avatar\":null,\"avatar_thumbnail\":null,\"class\":\"User\",\"email\":\"***@gmail.com\",\"first_name\":\"Daniel\",\"id\":\"68dfb84cf28785b7a4514095\",\"last_login_at\":null,\"last_name\":\"Boliqueime\",\"page\":\"https://dados.gov.pt/users/daniel-da-silva-boliqueime\",\"slug\":\"daniel-da-silva-boliqueime\",\"uri\":\"https://dados.gov.pt/api/1/users/daniel-da-silva-boliqueime/\"}}],\"metrics\":{\"dataservice_views\":0,\"dataservices\":0,\"dataservices_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"datasets\":18,\"datasets_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":9,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"202