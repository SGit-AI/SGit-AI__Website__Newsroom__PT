d\":null,\"description\":\"A IP tem por objeto a conceção, projeto, construção, financiamento, conservação, exploração, requalificação, alargamento e modernização das redes rodoviária e ferroviária nacionais, incluindo-se nesta última o comando e controlo da circulação. \",\"extras\":{},\"id\":\"5eecd85a454ae353c2a1e2bc\",\"last_modified\":\"2026-08-14T23:48:13.523000+00:00\",\"logo\":\"https://dados.gov.pt/s/avatars/fe/6af8dc6e3341f5908bc9cd6f55959d-original.png\",\"logo_thumbnail\":\"https://dados.gov.pt/s/avatars/fe/6af8dc6e3341f5908bc9cd6f55959d-100.png\",\"members\":[{\"label\":\"Administrador\",\"role\":\"admin\",\"since\":\"2023-03-08T15:49:25.068000+00:00\",\"user\":{\"avatar\":null,\"avatar_thumbnail\":null,\"class\":\"User\",\"email\":\"***@gmail.com\",\"first_name\":\"JoãO Carlos\",\"id\":\"6408ad910781901d1bde6ddb\",\"last_login_at\":null,\"last_name\":\"Neto Mendes\",\"page\":\"https://dados.gov.pt/users/joao-carlos-neto-mendes\",\"slug\":\"joao-carlos-neto-mendes\",\"uri\":\"https://dados.gov.pt/api/1/users/joao-carlos-neto-mendes/\"}},{\"label\":\"Administrador\",\"role\":\"admin\",\"since\":\"2023-03-08T16:04:38.723000+00:00\",\"user\":{\"avatar\":null,\"avatar_thumbnail\":null,\"class\":\"User\",\"email\":\"***@infraestruturasdeportugal.pt\",\"first_name\":\"João\",\"id\":\"6408aed407819022093b1ab7\",\"last_login_at\":null,\"last_name\":\"Gachet Alves\",\"page\":\"https://dados.gov.pt/users/joao-gachet-alves\",\"slug\":\"joao-gachet-alves\",\"uri\":\"https://dados.gov.pt/api/1/users/joao-gachet-alves/\"}},{\"label\":\"Administrador\",\"role\":\"admin\",\"since\":\"2023-03-08T16:04:44.035000+00:00\",\"user\":{\"avatar\":null,\"avatar_thumbnail\":null,\"class\":\"User\",\"email\":\"***@infraestruturasdeportugal.pt\",\"first_name\":\"Catarina\",\"id\":\"6408b1920781902cb1e2a716\",\"last_login_at\":null,\"last_name\":\"Pereira Coutinho\",\"page\":\"https://dados.gov.pt/users/catarina-pereira-coutinho\",\"slug\":\"catarina-pereira-coutinho\",\"uri\":\"ht