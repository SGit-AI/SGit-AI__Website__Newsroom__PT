":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0,\"2026-07\":0,\"2026-08\":0,\"2026-09\":0},\"followers\":1,\"members\":2,\"resource_downloads\":626,\"reuse_views\":12,\"reuses\":1,\"reuses_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"reuses_followers_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"views\":306},\"name\":\"Direção-Geral da Política de Justiça\",\"page\":\"https://dados.gov.pt/organizations/direcao-geral-da-politica-de-justica\",\"permissions\":{\"delete\":false,\"edit\":false,\"harvest\":false,\"members\":false,\"private\":false},\"slug\":\"direcao-geral-da-politica-de-justica\",\"uri\":\"https://dados.gov.pt/api/1/organizations/direcao-geral-da-politica-de-justica/\",\"url\":null},{\"acronym\":\"dgal\",\"badges\":[{\"kind\":\"public-service\"},{\"kind\":\"certified\"}],\"business_number_id\":null,\"created_at\":\"2018-05-02T10:06:30.667000+00:00\",\"deleted\":null,\"description\":\"A Direção-Geral das Autarquias Locais (DGAL) é um serviço central da administração direta do Estado integrado no Ministério da Administração Interna.\\n\\nTrata-se de um serviço do Estado que, desde 1974, foi assumindo diferentes designações - Direção-Geral da Administração Autárquica, Direção-Geral da Ação Regional e Local, Direção-Geral da Ação Regional, Gabinete de Apoio às Autarquias Locais e Direção-Geral da Administração Local, até passar a adotar a designação atual em 1998.\\n\\nMais em - [http://www.portalautarquico.dgal.gov.pt](http://www.portalautarquico.dgal.gov.pt).\",\"extras\":{},\"id\":\"5ae97f96c8d8c915d5faa3b3\",\"last_modified\":\"2026-06-09T12:16:45.098000+00:00\",\"logo\":\"https://dados.gov.pt/s/avatars/cd/4cbe72f07c44c8b7202603d9bef866-original.jpg\",\"log