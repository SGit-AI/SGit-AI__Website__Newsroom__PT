:0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0,\"2026-07\":0},\"datasets_reuses_by_months\":{\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":1,\"2026-06\":0,\"2026-07\":0},\"followers\":6,\"members\":0,\"resource_downloads\":3313,\"reuse_views\":0,\"reuses\":0,\"reuses_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"reuses_followers_by_months\":{\"2025-06\":0,\"2025-07\":0,\"2025-08\":0,\"2025-09\":0,\"2025-10\":0,\"2025-11\":0,\"2025-12\":0,\"2026-01\":0,\"2026-02\":0,\"2026-03\":0,\"2026-04\":0,\"2026-05\":0,\"2026-06\":0},\"views\":8316},\"name\":\"Administração Central do Sistema de Saúde (ACSS), I.P\",\"page\":\"https://dados.gov.pt/organizations/acss\",\"permissions\":{\"delete\":false,\"edit\":false,\"harvest\":false,\"members\":false,\"private\":false},\"slug\":\"acss\",\"uri\":\"https://dados.gov.pt/api/1/organizations/acss/\",\"url\":\"http://www.acss.min-saude.pt/\"},{\"acronym\":\"LNEG\",\"badges\":[{\"kind\":\"certified\"},{\"kind\":\"public-service\"}],\"business_number_id\":null,\"created_at\":\"2023-10-31T17:30:52.391000+00:00\",\"deleted\":null,\"description\":\"O Laboratório Nacional de Energia e Geologia (LNEG) é uma instituição de I\u0026amp;D orientada para responder às necessidades da sociedade e das empresas. Apostando numa investigação sustentável e para a sustentabilidade através da geração do conhecimento do nosso território.\\n\\nA par do que melhor se faz internacionalmente, garante ter nas suas áreas de competência uma resposta adequada às necessidades do setor empresarial. Fazemos Ciência em Energia e Geologia com vista à sua aplicação em soluções avançadas que permitam alavancar a nossa Economia.\",\"extras\":{},\"id\":