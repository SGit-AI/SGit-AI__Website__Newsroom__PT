  <body>
    <!-- Metricool tracking pixel — deferred until after window.onload so it never blocks LCP or eats bandwidth on first paint -->
    <img aria-hidden="true" data-deferred-tracker="true" data-src="https://tracker.metricool.com/c3po.jpg?hash=4c824e9344097ca76a273471126b5e20" alt="" width="1" height="1" style="position:absolute;width:1px;height:1px;opacity:0;pointer-events:none;" />
    <script>
      window.addEventListener('load', function () {
        document.querySelectorAll('img[data-deferred-tracker]').forEach(function (img) {
          var src = img.getAttribute('data-src');
          if (src) img.src = src;
        });
      });
    </script>
    <!-- Static hero: raw HTML, rendered before React parses/mounts, so Chrome
         credits this H1 paint as LCP. Hidden on non-homepage routes by the
         one-liner script directly below (and by App.tsx on client-side nav). -->
    <script>
      /* Hide the static hero when a non-homepage route was requested (direct
         hit to /agenda, /tickets, etc.). This is not a router / CTA script —
         it only toggles display of a decorative block. React re-toggles on
         client-side route changes via a useEffect in App.tsx. */
      (function(){var p=location.pathname;if(p!=='/'&&p!=='/index.html'){var h=document.getElementById('hero-static');if(h)h.style.display='none';}})();

      /* "20% Off" chip → persist SPECIAL20 promo, show toast, then hand off to /tickets?ref=SPECIAL20.
         The promo stays in localStorage until we clear it, so the site can auto-apply on return visits. */
      (function(){
        var btn = document.getElementById('hm-promo-apply');
        var toast = document.getElementById('hm-promo-toast');
        if (!btn) return;
        btn.addEventListener('click', function(e){
          e.preventDefault();
          e.stopPropagation();
          try {
            localStorage.setItem('ss_promo_code', 'SPECIAL20');
            localStorage.setItem('ss_promo_code_at', String(Date.now()));
          } catch (_) {}
          if (toast) {
            toast.classList.add('is-visible');
          }
          if (window.dataLayer) {
            window.dataLayer.push({ event: 'promo_apply_click', promo_code: 'SPECIAL20', source: 'mobile_hero' });
          }
          setTimeout(function(){
            window.location.href = '/tickets?ref=SPECIAL20';
          }, 900);
        });
      })();

      /* Mobile hero daily variant tracking. We ship one new mobile hero per
         day this week and compare day-over-day, so we just stamp the variant
         id on the document and report impressions/clicks to the dataLayer. */
      (function(){
        try {
          if (!window.matchMedia('(max-width: 767px)').matches) return;
          var hero = document.querySelector('#hero-static .hero-mobile');
          if (!hero) return;
          var v = hero.getAttribute('data-hero-variant') || 'unknown';
          document.documentElement.setAttribute('data-hero-variant', v);

          if (window.dataLayer) {
            window.dataLayer.push({ event: 'hero_variant_shown', variant: v, surface: 'mobile' });
          }
          var push = function(source){
            if (window.dataLayer) {
              window.dataLayer.push({ event: 'hero_variant_cta_click', variant: v, surface: 'mobile', source: source });
            }
          };
          var cta = hero.querySelector('.hm-cta');
          if (cta) cta.addEventListener('click', function(){ push('primary_cta'); });
          var tap = hero.querySelector('.hm-tap-anywhere');
          if (tap) tap.addEventListener('click', function(){ push('tap_anywhere'); });
        } catch (_) {}
      })();

      /* Scroll cue — ads now land on the homepage, so nudge people into the
         content below the fold instead of bouncing on the first screen. */
      (function(){
        var btn = document.getElementById('hm-scroll-cue');
        if (!btn) return;
        btn.addEventListener('click', function(e){
          e.preventDefault();
          e.stopPropagation();
          var hero = document.getElementById('hero-static');
          var top = hero ? hero.getBoundingClientRect().bottom + window.scrollY : window.innerHeight;
          window.scrollTo({ top: top, behavior: 'smooth' });
          if (window.dataLayer) window.dataLayer.push({ event: 'hero_scroll_cue_click', surface: 'mobile' });
        });
      })();


      /* Lazy-attach the hero video on desktop only, after the poster paints,
         so it never blocks LCP and mobile devices never download the MP4. */
      (function(){
        try {
          var p = location.pathname;
          if (p !== '/' && p !== '/index.html') return;
          var rm = window.matchMedia('(prefers-reduced-motion: reduce)');
          if (rm.matches) return;
          var v = document.querySelector('#hero-static .hero-video');
          if (!v) return;
          var start = function(){
            if (v.dataset.loaded) return;
            v.dataset.loaded = '1';
            var src = document.createElement('source');
            src.src = '/__l5e/assets-v1/fc52f4b0-f8a0-4f53-9785-0d8d002c4fb5/hero-event-video.mp4';
            src.type = 'video/mp4';
            v.appendChild(src);
            v.load();
            v.addEventListener('playing', function(){ v.classList.add('is-ready'); }, { once: true });
            var pl = v.play();
            if (pl && pl.catch) pl.catch(function(){});
          };
          if ('requestIdleCallback' in window) {
            requestIdleCallback(start, { timeout: 1500 });
          } else {
            setTimeout(start, 800);
          }
        } catch(e){}
      })();
    </script>
    <div id="root"></div>


    
      <noscript>
      <div style="max-width:840px;margin:0 auto;padding:40px 20px;font-family:system-ui,sans-serif;line-height:1.55">

  <h1>Frequently Asked Questions — Startup Summit Lisbon 2026</h1>
  <p>Everything you need to know about tickets, venue, agenda, travel and logistics.</p>
  
  <section>
    <h2>What is Startup Summit Lisbon 2026?</h2>
    <p>Startup Summit Lisbon 2026 is a founder-first European startup conference on September 17–18, 2026 at Beato Innovation District in Lisbon, Portugal. It is targeting 2,000+ founders, investors and operators, with 150+ speakers planned, 200+ startup booths planned across three stages — designed for high-signal founder-investor matchmaking rather than scale.</p>
  </section>

  <section>
    <h2>When is Startup Summit Lisbon 2026?</h2>
    <p>September 17 and 18, 2026. Doors open at 8:30 AM each day. There is also a Welcome Drinks pre-event on Wednesday 16 September.</p>
  </section>

  <section>
    <h2>Where is Startup Summit held?</h2>
    <p>Beato Innovation District — Av. Infante Dom Henrique 143, 1950-406 Lisbon, Portugal. A major Lisbon innovation hub, about 10 minutes from Lisbon Humberto Delgado Airport (LIS).</p>
  </section>

  <section>
    <h2>Who should attend Startup Summit?</h2>
    <p>Startup founders (pre-seed to Series B), angel investors, VCs, family offices, corporate innovation teams, startup operators, ecosystem builders, and university entrepreneurship students. See /why-attend for the full audience breakdown.</p>
  </section>

  <section>
    <h2>What ticket types are available?</h2>
    <p>Five passes: General Pass (from €49), Founder Pass (from €99), Startup Booth Package (from €199), Investor Pass (from €199) and VIP Experience Pass (from €249). All passes include access to every summit talk — tiers differ by networking access, visibility and premium experiences. See /tickets for the current release.</p>
  </section>

  <section>
    <h2>How does ticket pricing work?</h2>
    <p>Prices follow a phased release model — Super Early Bird, Early Bird, Standard and Final Release. The earlier you buy, the more you save. Each release is capped.</p>
  </section>

  <section>
    <h2>Can I get a refund?</h2>
    <p>Tickets are non-refundable but fully transferable. You can transfer your ticket to another person by contacting info@startupsummit.io.</p>
  </section>

  <section>
    <h2>Are startup booths available?</h2>
    <p>Yes. The Startup Booth Package starts at €199 and includes an exhibition booth, 2 Startup Summit passes, pitching eligibility and access to the Founder Social. See /startup-booths to book a startup booth.</p>
  </section>

  <section>
    <h2>Can investors attend Startup Summit?</h2>
    <p>Yes. The Investor Pass is designed for angels, VCs, family offices and corporate investment teams, with access to the investor lounge, 1:1 investor office hours, founder speed networking and 200+ startup booths. See /tickets for the Investor Pass details.</p>
  </section>

  <section>
    <h2>Can I sponsor Startup Summit Lisbon 2026?</h2>
    <p>Yes. We offer Title, Lead, Stage, Networking, Exhibitor and Media Partner tiers for brands that want visibility in front of our target audience of 2,000+ founders, investors and operators. See /sponsors or email sponsors@startupsummit.io to sponsor Startup Summit Lisbon 2026.</p>
  </section>

  <section>
    <h2>Can I apply to speak at Startup Summit?</h2>
    <p>Yes. We accept speaker applications from founders, investors and operators with strong, original perspectives. Apply at /speaker/apply.</p>
  </section>

  <section>
    <h2>Can I become a Startup Summit ambassador?</h2>
    <p>Yes. The Startup Summit Ambassador Program is open to founders, operators, community leaders and ecosystem connectors. Ambassadors share a personal referral link and earn rewards on every ticket sold through that link. Apply at /ambassador.</p>
  </section>

  <section>
    <h2>Do you offer visa invitation letters?</h2>
    <p>Yes. Portugal is in the Schengen Area, so EU/EEA citizens travel visa-free. US, UK, Canadian, Australian and Japanese passport holders can enter visa-free for up to 90 days. If you need an official invitation letter for a Schengen visa application, email visa@startupsummit.io after purchasing your ticket.</p>
  </section>

  <section>
    <h2>What networking experiences are included?</h2>
    <p>Depending on your pass, you'll have access to speed networking sessions, 1:1 investor office hours, the Founder Social, the Closing Celebration and the VIP Sunset Cruise. The whole agenda is designed so the right people meet the right people.</p>
  </section>

  <section>
    <h2>Is food provided?</h2>
    <p>Yes. Full-day catering is included with all passes, with food trucks, a beer hall, the Praça Café and outdoor seating across Beato Innovation District.</p>
  </section>

  <section>
    <h2>Who organises Startup Summit Lisbon 2026?</h2>
    <p>Startup Summit Lisbon 2026 is the flagship event of StartUp Events, which has brought founder-focused conferences to London, Madrid, Berlin and cities across Europe since 2019. Founded by Ricardo Pascual. The event is designed for founders, investors, operators, startup teams and ecosystem partners looking for practical content, useful networking and startup visibility in Lisbon.</p>
  </section>
  <p>Still have questions? <a href="/contact">Contact the Startup Summit team</a> or
  <a href="/tickets">buy Startup Summit Lisbon 2026 tickets</a> ·
  <a href="/startup-booths">book a startup booth</a> ·
  <a href="/sponsors">sponsor Startup Summit Lisbon 2026</a> ·
  <a href="/ambassador">apply to become a Startup Summit ambassador</a>.</p>

      </div>
    </noscript>
  </body>
</html>
