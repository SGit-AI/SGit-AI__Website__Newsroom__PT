  <script defer src="/~flock.js" data-proxy-url="/~api/analytics"></script></head>

  <body>
    <!-- Metricool tracking pixel — deferred until after window.onload so it never blocks LCP or eats bandwidth on first paint -->
    <img aria-hidden="true" data-deferred-tracker="true" data-src="https://tracker.metricool.com/c3po.jpg?hash=4c824e9344097ca76a273471126b5e20" alt="" width="1" height="1" style="position:absolute;width:1px;height:1px;opacity:0;pointer-events:none;" />
    <script>
      window.addEventListener('load', function () {
        document.querySelectorAll('img[data-deferred-tracker]').forEach(function (img) {
          var src = img.getAttribute('data-src');
          if (src) img.src = src;
        });
      });
    </script>
    <!-- Static hero: raw HTML, rendered before React parses/mounts, so Chrome
         credits this H1 paint as LCP. Hidden on non-homepage routes by the
         one-liner script directly below (and by App.tsx on client-side nav). -->
    <script>
      /* Hide the static hero when a non-homepage route was requested (direct
         hit to /agenda, /tickets, etc.). This is not a router / CTA script —
         it only toggles display of a decorative block. React re-toggles on
         client-side route changes via a useEffect in App.tsx. */
      (function(){var p=location.pathname;if(p!=='/'&&p!=='/index.html'){var h=document.getElementById('hero-static');if(h)h.style.display='none';}})();

      /* "20% Off" chip → persist SPECIAL20 promo, show toast, then hand off to /tickets?ref=SPECIAL20.
         The promo stays in localStorage until we clear it, so the site can auto-apply on return visits. */
      (function(){
        var btn = document.getElementById('hm-promo-apply');
        var toast = document.getElementById('hm-promo-toast');
        if (!btn) return;
        btn.addEventListener('click', function(e){
          e.preventDefault();
          e.stopPropagation();
          try {
            localStorage.setItem('ss_promo_code', 'SPECIAL20');
            localStorage.setItem('ss_promo_code_at', String(Date.now()));
          } catch (_) {}
          if (toast) {
            toast.classList.add('is-visible');
          }
          if (window.dataLayer) {
            window.dataLayer.push({ event: 'promo_apply_click', promo_code: 'SPECIAL20', source: 'mobile_hero' });
          }
          setTimeout(function(){
            window.location.href = '/tickets?ref=SPECIAL20';
          }, 900);
        });
      })();

      /* Mobile hero daily variant tracking. We ship one new mobile hero per
         day this week and compare day-over-day, so we just stamp the variant
         id on the document and report impressions/clicks to the dataLayer. */
      (function(){
        try {
          if (!window.matchMedia('(max-width: 767px)').matches) return;
          var hero = document.querySelector('#hero-static .hero-mobile');
          if (!hero) return;
          var v = hero.getAttribute('data-hero-variant') || 'unknown';
          document.documentElement.setAttribute('data-hero-variant', v);

          if (window.dataLayer) {
            window.dataLayer.push({ event: 'hero_variant_shown', variant: v, surface: 'mobile' });
          }
          var push = function(source){
            if (window.dataLayer) {
              window.dataLayer.push({ event: 'hero_variant_cta_click', variant: v, surface: 'mobile', source: source });
            }
          };
          var cta = hero.querySelector('.hm-cta');
          if (cta) cta.addEventListener('click', function(){ push('primary_cta'); });
          var tap = hero.querySelector('.hm-tap-anywhere');
          if (tap) tap.addEventListener('click', function(){ push('tap_anywhere'); });
        } catch (_) {}
      })();

      /* Scroll cue — ads now land on the homepage, so nudge people into the
         content below the fold instead of bouncing on the first screen. */
      (function(){
        var btn = document.getElementById('hm-scroll-cue');
        if (!btn) return;
        btn.addEventListener('click', function(e){
          e.preventDefault();
          e.stopPropagation();
          var hero = document.getElementById('hero-static');
          var top = hero ? hero.getBoundingClientRect().bottom + window.scrollY : window.innerHeight;
          window.scrollTo({ top: top, behavior: 'smooth' });
          if (window.dataLayer) window.dataLayer.push({ event: 'hero_scroll_cue_click', surface: 'mobile' });
        });
      })();


      /* Lazy-attach the hero video on desktop only, after the poster paints,
         so it never blocks LCP and mobile devices never download the MP4. */
      (function(){
        try {
          var p = location.pathname;
          if (p !== '/' && p !== '/index.html') return;
          var rm = window.matchMedia('(prefers-reduced-motion: reduce)');
          if (rm.matches) return;
          var v = document.querySelector('#hero-static .hero-video');
          if (!v) return;
          var start = function(){
            if (v.dataset.loaded) return;
            v.dataset.loaded = '1';
            var src = document.createElement('source');
            src.src = '/__l5e/assets-v1/fc52f4b0-f8a0-4f53-9785-0d8d002c4fb5/hero-event-video.mp4';
            src.type = 'video/mp4';
            v.appendChild(src);
            v.load();
            v.addEventListener('playing', function(){ v.classList.add('is-ready'); }, { once: true });
            var pl = v.play();
            if (pl && pl.catch) pl.catch(function(){});
          };
          if ('requestIdleCallback' in window) {
            requestIdleCallback(start, { timeout: 1500 });
          } else {
            setTimeout(start, 800);
          }
        } catch(e){}
      })();
    </script>
    <div id="root"></div>


    
      <noscript>
      <div style="max-width:840px;margin:0 auto;padding:40px 20px;font-family:system-ui,sans-serif;line-height:1.55">

  <h1>Speakers — Startup Summit Lisbon 2026</h1>
  <p><strong>September 17–18, 2026 · Beato Innovation District, Lisbon</strong></p>
  <p>Startup Summit Lisbon 2026 will feature 150+ speakers from 40+ countries —
  founders, investors, operators and category leaders across the Unicorn Stage,
  Impact Stage and Workshop Rooms. 70 confirmed speakers are listed
  below, with more announced weekly.</p>

  <h2>Confirmed speakers</h2>
  <ul style="list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:24px">
  
    <li id="andreia-gaudencio" style="border:1px solid #e5e5e5;border-radius:12px;overflow:hidden;background:#FFCF00;color:#000">
      <a href="/speakers/andreia-gaudencio" style="display:block;text-decoration:none;color:inherit">
        <img src="https://vnhlwqsbozhgewgxwjik.supabase.co/storage/v1/object/public/speaker-headshots/applications/backfill/andreia-gaudencio.jpg" alt="Speaker portrait of Andreia Gaudêncio, CNCA Project Internal Leader at BSC AI Factory" width="480" height="480" loading="lazy" decoding="async" style="width:100%;height:auto;aspect-ratio:1/1;object-fit:cover;object-position:center top;display:block" />
        <div style="padding:14px">
          <h3 style="margin:0 0 4px;font-size:18px;font-weight:700;line-height:1.15">Andreia Gaudêncio</h3>
          <p style="margin:0;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.06em">CNCA Project Internal Leader</p>
          <p style="margin:0 0 8px;font-size:12px;opacity:0.75">BSC AI Factory</p>
          <p style="margin:0;font-size:13px;line-height:1.45">Andreia Gaudêncio has a PhD in biomedical engineering and is currently the CNCA Project Internal Leader for the BSC AI Factory project — a European initiative offering free access to an incubation program, computational resources, data- and software-related services, and technical support.\n\nWithin Data and AI technical support, Andreia works hands-on with startups, SMEs, and researchers to harness High-Performance Computing (HPC) and AI for accelerating innovation, guiding teams through the Deucalion and MareNostrum supercomputers and the project's data-related services.</p>
          
        </div>
      </a>
    </li>

    <li id="paulo-andrez" style="border:1px solid #e5e5e5;border-radius:12px;overflow:hidden;background:#FFCF00;color:#000">
      <a href="/speakers/paulo-andrez" style="display:block;text-decoration:none;color:inherit">
        <img src="https://img1.wsimg.com/isteam/ip/6685a3b4-9cd6-4f4a-9967-066ceb7c6eda/NEF_6456.jpg/:/cr=t:5.5%25,l:0%25,w:100%25,h:89%25/rs=w:400,h:533,cg:true" alt="Speaker portrait of Paulo Andrez, Angel Investor &amp; Author at Zero Risk Startup" width="480" height="480" loading="lazy" decoding="async" style="width:100%;height:auto;aspect-ratio:1/1;object-fit:cover;object-position:center top;display:block" />
        <div style="padding:14px">
          <h3 style="margin:0 0 4px;font-size:18px;font-weight:700;line-height:1.15">Paulo Andrez</h3>
          <p style="margin:0;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.06em">Angel Investor & Author</p>
          <p style="margin:0 0 8px;font-size:12px;opacity:0.75">Zero Risk Startup</p>
          <p style="margin:0;font-size:13px;line-height:1.45">Paulo is a seasoned entrepreneur turned angel investor, bestselling author of Zero Risk Startup (Forbes Books), and President Emeritus of the European Business Angel Network.</p>
          <p style="margin:8px 0 0;font-size:12px"><a href="https://linkedin.com/in/pauloandrez" rel="nofollow" style="color:#000;text-decoration:underline">LinkedIn</a></p>
        </div>
      </a>
    </li>

    <li id="luis-valente" style="border:1px solid #e5e5e5;border-radius:12px;overflow:hidden;background:#FFCF00;color:#000">
      <a href="/speakers/luis-valente" style="display:block;text-decoration:none;color:inherit">
        <img src="https://startupsummit.io/images/speakers/luis-valente.jpeg" alt="Speaker portrait of Luis Valente, CEO &amp; Co-Founder at iLoF" width="480" height="480" loading="lazy" decoding="async" style="width:100%;height:auto;aspect-ratio:1/1;object-fit:cover;object-position:center top;display:block" />
        <div style="padding:14px">
          <h3 style="margin:0 0 4px;font-size:18px;font-weight:700;line-height:1.15">Luis Valente</h3>
          <p style="margin:0;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.06em">CEO & Co-Founder</p>
          <p style="margin:0 0 8px;font-size:12px;opacity:0.75">iLoF</p>
          <p style="margin:0;font-size:13px;line-height:1.45">Forbes 30 Under 30 entrepreneur, strategist, and business manager with a Computer Science background, driven to solve complex problems. My entrepreneurial journey began at 18, and since them have been founding ventures focused on demand prediction, lean operations, and growth design. Believing in technology's power to democratize personalized medicine, I co-founded iLoF - a deep tech company using AI to build a cloud-based library of disease biomarkers. On a mission to accelerate adequate treatments for millions living with complex, heterogeneous diseases globally.</p>
          <p style="margin:8px 0 0;font-size:12px"><a href="https://www.linkedin.com/in/luisvalente28/" rel="nofollow" style="color:#000;text-decoration:underline">LinkedIn</a></p>
        </div>
      </a>
    </li>

