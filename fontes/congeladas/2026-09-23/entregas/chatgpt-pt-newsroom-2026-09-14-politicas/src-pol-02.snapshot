    <circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline>
</svg></i-feather><span translate="no">45</span><span>&nbsp;minuto(s)</span></span><!----></div><!----></div></app-post-metadata></div><p class="mt-1 mb-6 text-neutral-700 text-[18px]"> Consulte aqui o documento que aprova a Agenda Nacional de IA. </p><app-tag-list><div class="flex gap-2 flex-wrap"><app-tag-single _nghost-sc38=""><p _ngcontent-sc38="" class="h-full text-primary text-xxs px-3 py-[1px] border-[#5F93FC] border-2 rounded-md uppercase font-semibold pointer-events-none flex items-center"> Estratégia Digital Nacional
