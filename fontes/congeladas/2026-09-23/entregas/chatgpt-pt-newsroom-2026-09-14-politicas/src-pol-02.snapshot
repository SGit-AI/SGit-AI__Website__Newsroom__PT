ocale=pt&q;,&q;responseType&q;:&q;json&q;},&q;document-detail:pt:documentos/resolucao-do-conselho-de-ministros-2-2026&q;:&q;{\&q;data\&q;:{\&q;queryDocumentsContents\&q;:[{\&q;id\&q;:\&q;ceeaa167-df17-4e85-80ab-63106fc4fe4e\&q;,\&q;created\&q;:\&q;2025-12-31T12:22:03Z\&q;,\&q;lastModified\&q;:\&q;2026-07-08T14:10:36Z\&q;,\&q;data\&q;:{\&q;title\&q;:\&q;Resolução do Conselho de Ministros n.º 2/2026\&q;,\&q;tags\&q;:[\&q;Estratégia Digital Nacional\&q;,\&q;Transformação Digital\&q;,\&q;Agenda Nacional de IA\&q;,\&q;Inteligência Artificial\&q;,\&q;Inovação\&q;],\&q;slug\&q;:\&q;pt/documentos/resolucao-do-conselho-de-ministros-2-2026\&q;,\&q;teaser\&q;:\&q;Consulte aqui o documento que aprova a Agenda Nacional de IA.\&q;,\&q;newImage\&q;:[{\&q;id\&q;:\&q;42d8c329-7b15-49b6-b0ef-74199b254aa6\&q;,\&q;mimeType\&q;:\&q;image/jpeg\&q;,\&q;url\&q;:\&q;https://bo.digital.gov.pt/api/assets/etic/42d8c329-7b15-49b6-b0ef-74199b254aa6/\&q;,\&q;thumbnailUrl\&q;:\&q;https://bo.digital.gov.pt/api/assets/etic/42d8c329-7b15-49b6-b0ef-74199b254aa6?width=100&a;mode=Max\&q;,\&q;fileName\&q;:\&q;Resolução do Conselho de Ministros.jpg\&q;,\&q;fileHash\&q;:\&q;5PF6C9hUqMDA6d85d3meLUar3/HzukD15Sw1H5O+oTc=\&q;,\&q;fileType\&q;:\&q;jpg\&q;,\&q;metadata\&q;:{\&q;pixelWidth\&q;:1200,\&q;pixelHeight\&q;:657,\&q;created\&q;:\&q;2018-03-05T00:00:00\&q;,\&q;imageQuality\&q;:100,\&q;description\&q;:\&q;JFIF File\&q;}}],\&q;newImageMobile\&q;:null,\&q;pdf\&q;:[{\&q;id\&q;:\&q;6c8282d1-dd2d-438a-a60c-b8582c4858bb\&q;,\&q;mimeType\&q;:\&q;application/pdf\&q;,\&q;url\&q;:\&q;https://bo.digital.gov.pt/api/assets/etic/6c8282d1-dd2d-438a-a60c-b8582c4858bb/\&q;,\&q;thumbnailUrl\&q;:null,\&q;fileName\&q;:\&q;RCM n.º 2-2026.pdf\&q;,\&q;fileHash\&q;:\&q;k+bMLuwl7Iwdw9+pu68uXc4RMVnnFl67QSGYmUyTkDk=\&q;,\&q;fileType\&q;:\&q;pdf\&q;,\&q;metadata\&q;:{}}],\&q;newAuthor\&q;:\&q;CONSELHO DE MINISTROS\&q;,\&q;category\&q;:[{\&q;id\&q;:\&q;de5509e2-7817-47ce-a49a-e2f7fee5d4bd\&q;,\&q;status\&q;:\&q;PUBLISHED\&q;,\&q;data\&q;:{\&q;id\&q;:{\&q;iv\&q;:\&q;legislacao\&q;},\&q;title\&q;:\&q;Legislação\&q;}}],\&q;newDate\&q;:\&q;2026-01-08T09:18:08Z\&q;,\&q;readingTime\&q;:{\&q;iv\&q;:45},\&q;body\&q;:\&q;&l;p&g;A Resolu&a;ccedil;&a;atilde;o do Conselho de Ministros n.&a;ordm; 2/2026 aprova a Agenda Nacional de Intelig&a;ecirc;ncia Artificial (ANIA), integrando a A&a;ccedil;&a;atilde;o #20 do Plano de A&a;ccedil;&a;atilde;o 2026-2027 da Estrat&a;eacute;gia Digital Nacional. A ANIA assume-se como o principal instrumento para operacionalizar a ambi&a;ccedil;&a;atilde;o de Portugal na &a;aacute;rea da IA, promovendo crescimento econ&a;oacute;mico, aumento da produtividade e melhoria dos servi&a;ccedil;os p&a;uacute;blicos, aproveitando as vantagens estrat&a;eacute;gicas do pa&a;iacute;s, como infraestrutura digital, talento qualificado e um ecossistema de startups din&a;acirc;mico.&l;/p&g;\\n&l;p&g;A Agenda organiza-se em quatro eixos&a;nbsp;&a;ndash; Infraestrutura e Dados, Inova&a;ccedil;&a;atilde;o e Ado&a;ccedil;&a;atilde;o, Talento e Compet&a;ecirc;ncias, e Responsabilidade e &a;Eacute;tica &a;ndash; e assenta em princ&a;iacute;pios de inova&a;ccedil;&a;atilde;o respons&a;aacute;vel, foco estrat&a;eacute;gico, lideran&a;ccedil;a do Estado, centralidade das pessoas, orienta&a;ccedil;&a;atilde;o a produtos e avan&a;ccedil;o baseado em resultados comprovados. A sua implementa&a;ccedil;&a;atilde;o envolve 32 iniciativas que mobilizam universidades, centros de investiga&a;ccedil;&a;atilde;o, empresas e Administra&a;ccedil;&a;atilde;o P&a;uacute;blica, alinhando Portugal com a estrat&a;eacute;gia europeia ApplyAI e refor&a;ccedil;ando a competitividade e inclus&a;atilde;o digital do pa&a;iacute;s.&l;/p&g;\\n&l;p&g;Esta agenda est&a;aacute; alinhada com o AI Continent Action Plan e a estrat&a;eacute;gia Apply AI, posicionando o pa&a;iacute;s para contribuir para as metas e objetivos da Uni&a;atilde;o Europeia nesta &a;aacute;rea.&l;/p&g;\&q;,\&q;additionalContents\&q;:{\&q;label\&q;:\&q;Conteúdos adicionais\&q;,\&q;title\&q;:null,\&q;contents\&q;:[{\&q;title\&q;:\&q;Agenda Nacional de IA.\&q;,\&q;summary\&q;:\&q;Consulte o documento da Agenda Nacional de IA.\&q;,\&q;url\&q;:\&q;pt/documentos/agenda-nacional-de-ia\&q;,\&q;newWindow\&q;:false,\&q;externalLink\&q;:false,\&q;image\&q;:[{\&q;id\&q;:\&q;1c7bfb0e-a0f5-42bf-ab9b-9a9f9721643e\&q;,\&q;mimeType\&q;:\&q;image/jpeg\&q;,\&q;url\&q;:\&q;https://bo.digital.gov.pt/api/assets/etic/1c7bfb0e-a0f5-42bf-ab9b-9a9f9721643e/\&q;,\&q;thumbnailUrl\&q;:\&q;https://bo.digital.gov.pt/api/assets/etic/1c7bfb0e-a0f5-42bf-ab9b-9a9f9721643e?width=100&a;mode=Max\&q;,\&q;fileName\&q;:\&q;Agenda Nacional de IA (ANIA).jpg\&q;,\&q;fileHash\&q;:\&q;klM/M59397gKNyRAz/45Q0kjLfsbOa77i4kNoCH2dfs=\&q;,\&q;fileType\&q;:\&q;jpg\&q;,\&q;metadata\&q;:{\&q;pixelWidth\&q;:800,\&q;pixelHeight\&q;:533,\&q;imageQuality\&q;:74,\&q;description\&q;:\&q;JFIF File\&q;}}]}]},\&q;seo\&q;:{\&q;title\&q;:\&q;Resolução do Conselho de Ministros n.º 2/2026\&q;,\&q;description\&q;:\&q;Consulte aqui o documento que aprova a Agenda Nacional de IA.\&q;,\&q;image\&q;:null}}}]},\&q;extensions\&q;:{\&q;tracing\&q;:{\&q;version\&q;:1,\&q;startTime\&q;:\&q;2026-09-23T16:56:17.500623Z\&q;,\&q;endTime\&q;:\&q;2026-09-23T16:56:17.6835126Z\&q;,\&q;duration\&q;:182889600,\&q;parsing\&q;:{\&q;startOffset\&q;:1000,\&q;duration\&q;:54800},\&q;validation\&q;:{\&q;startOffset\&q;:56900,\&q;duration\&q;:1384500},\&q;execution\&q;:{\&q;resolvers\&q;:[]}}}}&q;,&q;page-data:pt&q;:&q;{\&q;id\&q;:\&q;60ad7cf4-9d79-4eaf-ae5b-4fb577c00502\&q;,\&q;created\&q;:\&q;2022-09-29T15:02:58.000Z\&q;,\&q;lastModified\&q;:\&q;2025-12-16T23:23:42.000Z\&q;,\&q;name\&q;:\&q;documents-detail\&q;,\&q;title\&q;:\&q;Detalhe Documento\&q;,\&q;slug\&q;:\&q;pt/detalhe-documento\&q;,\&q;parent\&q;:{\&q;id\&q;:\&q;f518f4fa-1c40-4854-a952-725d4248e988\&q;,\&q;name\&q;:\&q;Documentos\&q;,\&q;title\&q;:\&q;Documentos\&q;,\&q;slug\&q;:\&q;pt/documentos\&q;,\&q;parent\&q;:{\&q;id\&q;:\&q;fd40d3dd-4e70-4561-90be-fb03669b98ae\&q;,\&q;name\&q;:\&q;homepage\&q;,\&q;title\&q;:\&q;Início\&q;,\&q;slug\&q;:\&q;pt\&q;,\&q;parent\&q;:null}},\&q;tags\&q;:[\&q;documentos\&q;],\&q;isDynamic\&q;:true,\&q;isMenuFloating\&q;:null,\&q;sections\&q;:[{\&q;schemaId\&q;:\&q;6d79bbaa-c67e-43e5-ad22-5624c280cec7\&q;,\&q;schemaName\&q;:\&q;BreadcrumbComponent\&q;,\&q;showSharing\&q;:true,\&q;showBreadcrumb\&q;:true,\&q;css\&q;:null},{\&q;schemaId\&q;:\&q;3690f15d-3460-48fd-a783-28ed29e067f3\&q;,\&q;schemaName\&q;:\&q;DynamicContentComponent\&q;,\&q;type\&q;:\&q;Document\&q;,\&q;css\&q;:null}],\&q;seo\&q;:{\&q;title\&q;:\&q;Documentos\&q;,\&q;description\&q;:\&q;Este é o ponto de passagem para quem quer aceder aos documentos disponíveis em tic.gov.\&q;},\&q;extras\&q;:{\&q;documentsDetail\&q;:{\&q;title\&q;:\&q;Resolução do Conselho de Ministros n.º 2/2026\&q;,\&q;author\&q;:\&q;CONSELHO DE MINISTROS\&q;,\&q;readingTime\&q;:45,\&q;date\&q;:\&q;2026-01-08T09:18:08.000Z\&q;,\&q;category\&q;:{\&q;id\&q;:\&q;de5509e2-7817-47ce-a49a-e2f7fee5d4bd\&q;,\&q;name\&q;:\&q;legislacao\&q;,\&q;title\&q;:\&q;Legislação\&q;,\&q;status\&q;:\&q;PUBLISHED\&q;},\&q;tags\&q;:[\&q;Estratégia Digital Nacional\&q;,\&q;Transformação Digital\&q;,\&q;Agenda Nacional de IA\&q;,\&q;Inteligência Artificial\&q;,\&q;Inovação\&q;],\&q;body\&q;:\&q;&l;p&g;A Resolu&a;ccedil;&a;atilde;o do Conselho de Ministros n.&a;ordm; 2/2026 aprova a Agenda Nacional de Intelig&a;ecirc;ncia Artificial (ANIA), integrando a A&a;ccedil;&a;atilde;o #20 do Plano de A&a;ccedil;&a;atilde;o 2026-2027 da Estrat&a;eacute;gia Digital Nacional. A ANIA assume-se como o principal instrumento para operacionalizar a ambi&a;ccedil;&a;atilde;o de Portugal na &a;aacute;rea da IA, promovendo crescimento econ&a;oacute;mico, aumento da produtividade e melhoria dos servi&a;ccedil;os p&a;uacute;blicos, aproveitando as vantagens estrat&a;eacute;gicas do pa&a;iacute;s, como infraestrutura digital, talento qualificado e um ecossistema de startups din&a;acirc;mico.&l;/p&g;\\n&l;p&g;A Agenda organiza-se em quatro eixos&a;nbsp;&a;ndash; Infraestrutura e Dados, Inova&a;ccedil;&a;atilde;o e Ado&a;ccedil;&a;atilde;o, Talento e Compet&a;ecirc;ncias, e Responsabilidade e &a;Eacute;tica &a;ndash; e assenta em princ&a;iacute;pios de inova&a;ccedil;&a;atilde;o respons&a;aacute;vel, foco estrat&a;eacute;gico, lideran&a;ccedil;a do Estado, centralidade das pessoas, orienta&a;ccedil;&a;atilde;o a produtos e avan&a;ccedil;o baseado em resultados comprovados. A sua implementa&a;ccedil;&a;atilde;o envolve 32 iniciativas que mobilizam universidades, centros de investiga&a;ccedil;&a;atilde;o, empresas e Administra&a;ccedil;&a;atilde;o P&a;uacute;blica, alinhando Portugal com a estrat&a;eacute;gia europeia ApplyAI e refor&a;ccedil;ando a competitividade e inclus&a;atilde;o digital do pa&a;iacute;s.&l;/p&g;\\n&l;p&g;Esta agenda est&a;aacute; alinhada com o AI Continent Action Plan e a estrat&a;eacute;gia Apply AI, posicionando o pa&a;iacute;s para contribuir para as metas e objetivos da Uni&a;atilde;o Europeia nesta &a;aacute;rea.&l;/p&g;\&q;,\&q;slug\&q;:\&q;pt/documentos/resolucao-do-conselho-de-ministros-2-2026\&q;,\&q;created\&q;:\&q;2025-12-31T12:22:03.000Z\&q;,\&q;lastModified\&q;:\&q;2026-07-08T14:10:36.000Z\&q;,\&q;teaser\&q;:\&q;Consulte aqui o documento que aprova a Agenda Nacional de IA.\&q;,\&q;image\&q;:[{\&q;id\&q;:\&q;42d8c329-7b15-49b6-b0ef-74199b254aa6\&q;,\&q;mimeType\&q;:\&q;image/jpeg\&q;,\&q;url\&q;:\&q;https://bo.digital.gov.pt/api/assets/etic/42d8c329-7b15-49b6-b0ef-74199b254aa6/\&q;,\&q;thumbnailUrl\&q;:\&q;https://bo.digital.gov.pt/api/assets/etic/42d8c329-7b15-49b6-b0ef-74199b254aa6?width=100&a;mode=Max\&q;,\&q;fileName\&q;:\&q;Resolução do Conselho de Ministros.jpg\&q;,\&q;fileHash\&q;:\&q;5PF6C9hUqMDA6d85d3meLUar3/HzukD15Sw1H5O+oTc=\&q;,\&q;fileType\&q;:\&q;jpg\&q;,\&q;metadata\&q;:{\&q;pixelWidth\&q;:1200,\&q;pixelHeight\&q;:657,\&q;created\&q;:\&q;2018-03-05T00:00:00\&q;,\&q;imageQuality\&q;:100,\&q;description\&q;:\&q