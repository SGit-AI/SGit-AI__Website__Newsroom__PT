ional-de-cibersegurança&q;,&q;teaser&q;:&q;A conferência anual do Centro Nacional de Cibersegurança decorre entre 16 e 18 de junho, no Centro de Congressos da Alfândega do Porto. O evento gratuito, mediante inscrição prévia, decorre em formato presencial. A edição deste ano inclui uma sessão dedicada à cloud soberana e à Estratégia Digital Nacional.&q;,&q;newAuthor&q;:&q;Centro Nacional de Cibersegurança (CNCS)&q;,&q;features&q;:{&q;iv&q;:null},&q;signUpUrl&q;:null,&q;newDate&q;:&q;2026-06-16T11:00:00Z&q;,&q;newEndDate&q;:&q;2026-06-18T17:00:00Z&q;,&q;location&q;:&q;Online&q;,&q;newImage&q;:[{&q;id&q;:&q;e6488e39-5159-4934-92a3-a46fdc7f68c4&q;,&q;mimeType&q;:&q;image/jpeg&q;,&q;url&q;:&q;https://bo.digital.gov.pt/api/assets/etic/e6488e39-5159-4934-92a3-a46fdc7f68c4/&q;,&q;thumbnailUrl&q;:&q;https://bo.digital.gov.pt/api/assets/etic/e6488e39-5159-4934-92a3-a46fdc7f68c4?width=100&a;mode=Max&q;,&q;fileName&q;:&q;C-Days.jpg&q;,&q;fileHash&q;:&q;pvgSOrEvczJWbYZg4ltYS9jWIDMh5yDXjjMpij9JZH8=&q;,&q;fileType&q;:&q;jpg&q;,&q;metadata&q;:{&q;pixelWidth&q;:1366,&q;pixelHeight&q;:860,&q;imageQuality&q;:79,&q;description&q;:&q;JFIF File&q;}}],&q;newImageMobile&q;:[{&q;id&q;:&q;e6488e39-5159-4934-92a3-a46fdc7f68c4&q;,&q;mimeType&q;:&q;image/jpeg&q;,&q;url&q;:&q;https://bo.digital.gov.pt/api/assets/etic/e6488e39-5159-4934-92a3-a46fdc7f68c4/&q;,&q;thumbnailUrl&q;:&q;https://bo.digital.gov.pt/api/assets/etic/e6488e39-5159-4934-92a3-a46fdc7f68c4?width=100&a;mode=Max&q;,&q;fileName&q;:&q;C-Days.jpg&q;,&q;fileHash&q;:&q;pvgSOrEvczJWbYZg4ltYS9jWIDMh5yDXjjMpij9JZH8=&q;,&q;fileType&q;:&q;jpg&q;,&q;metadata&q;:{&q;pixelWidth&q;:1366,&q;pixelHeight&q;:860,&q;imageQuality&q;:79,&q;description&q;:&q;JFIF File&q;}}],&q;category&q;:[],&q;readingTime&q;:{&q;iv&q;:2},&q;pageSize&q;:{&q;iv&q;:15},&q;signLanguageInfoMessage&q;:null,&q;languageInfoMessage&q;:null,&q;generalInfo&q;:null,&q;documentationInfo&q;:null}},{&q;id&q;:&q;eefc65e6-37ec-4995-91d2-3b3244cd4663&q;,&q;created&q;:&q;2025-02-07T16:4