\&q;:null,\&q;generalInfo\&q;:null,\&q;documentationInfo\&q;:null}},{\&q;id\&q;:\&q;eefc65e6-37ec-4995-91d2-3b3244cd4663\&q;,\&q;created\&q;:\&q;2025-02-07T16:40:09Z\&q;,\&q;lastModified\&q;:\&q;2026-05-06T04:15:33Z\&q;,\&q;data\&q;:{\&q;title\&q;:\&q;Inovação Pública: Estratégias Digitais e Inteligência Artificial na Administração Pública e PMEs\&q;,\&q;scheduleTitle\&q;:null,\&q;timelineTitle\&q;:null,\&q;showScheduleTags\&q;:{\&q;iv\&q;:null},\&q;slug\&q;:\&q;pt/agenda/evento-inovacao-publica-estrategias-digitais-e-inteligencia-artificial-na-ap-e-pmes-viseu\&q;,\&q;teaser\&q;:\&q;O evento decorre no dia 26 de fevereiro, entre as 9h30 e as 17h30, no Museu do Quartzo, em Viseu. \&q;,\&q;newAuthor\&q;:\&q;AI4PA EDIH, C.M. Viseu\&q;,\&q;features\&q;:{\&q;iv\&q;:null},\&q;signUpUrl\&q;:null,\&q;newDate\&q;:\&q;2025-02-26T09:30:00Z\&q;,\&q;newEndDate\&q;:\&q;2025-02-26T17:30:00Z\&q;,\&q;location\&q;:\&q;Museu do Quartzo - Rua de Santa Luzia, 3515-371 Vila Nova do Campo, Viseu\&q;,\&q;newImage\&q;:[{\&q;id\&q;:\&q;f8c9e5c9-92c9-4e1c-bdb2-95e27faa31a3\&q;,\&q;mimeType\&q;:\&q;image/jpeg\&q;,\&q;url\&q;:\&q;https://bo.digital.gov.pt/api/assets/etic/f8c9e5c9-92c9-4e1c-bdb2-95e27faa31a3/\&q;,\&q;thumbnailUrl\&q;:\&q;https://bo.digital.gov.pt/api/assets/etic/f8c9e5c9-92c9-4e1c-bdb2-95e27faa31a3?width=100&a;mode=Max\&q;,\&q;fileName\&q;:\&q;Site_ AI4PA_1200x454.jpg\&q;,\&q;fileHash\&q;:\&q;MdAQm7Dl1vQac5Pb/yJMx+erhzDFPQoM0hRR0BlTstI=\&q;,\&q;fileType\&q;:\&q;jpg\&q;,\&q;metadata\&q;:{\&q;pixelWidth\&q;:1200,\&q;pixelHeight\&q;:455,\&q;imageQuality\&q;:88,\&q;description\&q;:\&q;JFIF File\&q;}}],\&q;newImageMobile\&q;:null,\&q;category\&q;:[{\&q;id\&q;:\&q;a8518c22-2c88-4afa-97bd-632206fa5e47\&q;,\&q;status\&q;:\&q;PUBLISHED\&q;,\&q;data\&q;:{\&q;id\&q;:{\&q;iv\&q;:\&q;formacoes-e-workshops\&q;},\&q;title\&q;:\&q;Formações e Workshops\&q;}}],\&q;readingTime\&q;:{\&q;iv\&q;:5},\&q;pageSize\&q;:{\&q;iv\&q;:14},\&q;signLanguageInfoMessage\&q;:null,\&q;languageInfoMessage\&q;:null,\&q;generalInfo\&q;:null,\&q;documentationInfo\&q;:null}}]},\&q;extensions\&q;:{\&q;tracing\&q;:{\&q;version\&q;:1,\&q;startTime\&q;:\&q;2026-09-23T16:56:13.6690299Z\&q;,\&q;endTime\&q;:\&q;2026-09-23T16:56:13.8565943Z\&q;,\&q;duration\&q;:187564400,\&q;parsing\&q;:{\&q;startOffset\&q;:1400,\&q;duration\&q;:122000},\&q;validation\&q;:{\&q;startOffset\&q;:125000,\&q;duration\&q;:3500300},\&q;execution\&q;:{\&q;resolvers\&q;:[]}}}}&q;,&q;page-data:pt&q;:&q;{\&q;id\&q;:\&q;1376c006-6661-4568-9fae-a7dd378640b1\&q;,\&q;created\&q;:\&q;2022-09-21T22:33:14.000Z\&q;,\&q;lastModified\&q;:\&q;2025-12-16T23:23:42.000Z\&q;,\&q;name\&q;:\&q;news-detail\&q;,\&q;title\&q;:\&q;Detalhe Notícia\&q;,\&q;slug\&q;:\&q;pt/noticias/:slug\&q;,\&q;parent\&q;:{\&q;id\&q;:\&q;45bf6ca4-cbc1-4756-9f7c-f8f9458cb5d9\&q;,\&q;name\&q;:\&q;Noticias\&q;,\&q;title\&q;:\&q;Notícias\&q;,\&q;slug\&q;:\&q;pt/noticias\&q;,\&q;parent\&q;:{\&q;id\&q;:\&q;fd40d3dd-4e70-4561-90be-fb03669b98ae\&q;,\&q;name\&q;:\&q;homepage\&q;,\&q;title\&q;:\&q;Início\&q;,\&q;slug\&q;:\&q;pt\&q;,\&q;parent\&q;:null}},\&q;tags\&q;:[\&q;noticias\&q;],\&q;isDynamic\&q;:true,\&q;isMenuFloating\&q;:false,\&q;sections\&q;:[{\&q;schemaId\&q;:\&q;6d79bbaa-c67e-43e5-ad22-5624c280cec7\&q;,\&q;schemaName\&q;:\&q;BreadcrumbComponent\&q;,\&q;showSharing\&q;:true,\&q;showBreadcrumb\&q;:true,\&q;css\&q;:null},{\&q;schemaId\&q;:\&q;3690f15d-3460-48fd-a783-28ed29e067f3\&q;,\&q;schemaName\&q;:\&q;DynamicContentComponent\&q;,\&q;type\&q;:\&q;NewsArticle\&q;,\&q;css\&q;:null},{\&q;schemaId\&q;:\&q;3f4d3254-f642-46c5-a2a0-9a4ed5581378\&q;,\&q;schemaName\&q;:\&q;HtmlComponent\&q;,\&q;htmlFullWidth\&q;:null,\&q;alignment\&q;:null,\&q;content\&q;:\&q;&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;A proposta surge num contexto de crescimento da procura por capacidade computacional, impulsionada&a;nbsp;pela expans&a;atilde;o da intelig&a;ecirc;ncia artificial, e da necessidade de assegurar infraestruturas adequadas ao desenvolvimento e &a;agrave; utiliza&a;ccedil;&a;atilde;o destas tecnologias. Entre as medidas previstas encontram-se o aumento da capacidade dos centros de dados europeus, a cria&a;ccedil;&a;atilde;o de um quadro comum para avaliar a soberania dos servi&a;ccedil;os de&a;nbsp;Cloud&a;nbsp;e&a;nbsp;de Intelig&a;ecirc;ncia Artificial&a;nbsp;e mecanismos destinados a facilitar a ado&a;ccedil;&a;atilde;o destas tecnologias pelo setor p&a;uacute;blico.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;O CADA integra o&a;nbsp;&l;/span&g;&l;a href=\\\&q;https://digital.gov.pt/pt/noticias/pacote-para-reforco-da-soberania-tecnologica-da-europa\\\&q;&g;&l;strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;Pacote Europeu de Soberania Tecnol&a;oacute;gica&l;/span&g;&l;/strong&g;&l;/a&g;&l;span data-contrast=\\\&q;none\\\&q;&g;, apresentado pela Comiss&a;atilde;o Europeia na mesma data, que inclui tamb&a;eacute;m o&a;nbsp;&l;/span&g;&l;a href=\\\&q;https://digital-strategy.ec.europa.eu/pt/library/proposal-chips-act-20\\\&q;&g;&l;strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;Chips&a;nbsp;Act&a;nbsp;2.0&l;/span&g;&l;/strong&g;&l;/a&g;&l;span data-contrast=\\\&q;none\\\&q;&g;, a Estrat&a;eacute;gia Europeia de C&a;oacute;digo Aberto e um roteiro para a digitaliza&a;ccedil;&a;atilde;o e a intelig&a;ecirc;ncia artificial no setor da energia.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:0}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:0}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;Aumentar a capacidade europeia de computa&a;ccedil;&a;atilde;o&l;/span&g;&l;/strong&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;auto\\\&q;&g;O aumento da capacidade computacional &a;eacute; considerado pela Comiss&a;atilde;o uma condi&a;ccedil;&a;atilde;o necess&a;aacute;ria para acompanhar a evolu&a;ccedil;&a;atilde;o da intelig&a;ecirc;ncia artificial&a;nbsp;(IA)&a;nbsp;e assegurar recursos adequados a empresas, investigadores e entidades p&a;uacute;blicas.&a;nbsp;A Comiss&a;atilde;o estabelece&a;nbsp;como&a;nbsp;objetivo, pelo menos, triplicar a capacidade dos centros de dados da Uni&a;atilde;o Europeia&a;nbsp;nos pr&a;oacute;ximos cinco a sete anos.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;Neste contexto, a expans&a;atilde;o&a;nbsp;das&a;nbsp;infraestruturas&a;nbsp;de&a;nbsp;Cloud&a;nbsp;dever&a;aacute; complementar o desenvolvimento das&a;nbsp;&l;/span&g;&l;a href=\\\&q;https://digital-strategy.ec.europa.eu/pt/policies/ai-factories\\\&q;&g;&l;strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;AI&a;nbsp;Factories&l;/span&g;&l;/strong&g;&l;/a&g;&l;span data-contrast=\\\&q;none\\\&q;&g;&a;nbsp;e das&a;nbsp;&l;/span&g;&l;a href=\\\&q;https://commission.europa.eu/topics/competitiveness/competitiveness-coordination-tool-projects/ai-gigafactories_en?prefLang=pt\\\&q;&g;&l;strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;AI&a;nbsp;Gigafactories&l;/span&g;&l;/strong&g;&l;/a&g;&l;span data-contrast=\\\&q;none\\\&q;&g;, permitindo disponibilizar recursos computacionais a diferentes escalas e para&a;nbsp;m&a;uacute;ltiplas&a;nbsp;utiliza&a;ccedil;&a;otilde;es.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;A proposta prev&a;ecirc; igualmente medidas destinadas a facilitar o desenvolvimento de centros de dados na Uni&a;atilde;o Europeia, incluindo mecanismos para acelerar determinados projetos e criar condi&a;ccedil;&a;otilde;es mais favor&a;aacute;veis &a;agrave; instala&a;ccedil;&a;atilde;o de infraestruturas consideradas estrat&a;eacute;gicas.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;A efici&a;ecirc;ncia energ&a;eacute;tica constitui outra das dimens&a;otilde;es&a;nbsp;cr&a;iacute;ticas&a;nbsp;no desenvolvimento desta capacidade. O aumento da computa&a;ccedil;&a;atilde;o associada &a;agrave;&a;nbsp;IA&a;nbsp;intensifica&a;nbsp;a procura de energia,&a;nbsp;tornando relevante a ado&a;ccedil;&a;atilde;o de solu&a;ccedil;&a;otilde;es que&a;nbsp;promovam centros de dados mais eficientes no uso da&a;nbsp;energia&a;nbsp;e da &a;aacute;gua, incentivem a reutiliza&a;ccedil;&a;atilde;o de calor residual e melhorem a integra&a;ccedil;&a;atilde;o&a;nbsp;destas&a;nbsp;infraestruturas&a;nbsp;no sistema&a;nbsp;energ&a;eacute;tico.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:0}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:0}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;Quadro&a;nbsp;europeu para avaliar a soberania dos servi&a;ccedil;os de&a;nbsp;Cloud&a;nbsp;e IA&l;/span&g;&l;/strong&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;Uma das principais componentes do CADA &a;eacute; a cria&a;ccedil;&a;atilde;o de um&a;nbsp;&l;/span&g;&l;strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;quadro europeu de avalia&a;ccedil;&a;atilde;o da soberania dos servi&a;ccedil;os de&a;nbsp;Cloud&a;nbsp;e&a;nbsp;de&a;nbsp;IA&l;/span&g;&l;/strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;A proposta pretende estabelecer crit&a;eacute;rios comuns para avaliar diferentes dimens&a;otilde;es da soberania dos servi&a;ccedil;os, incluindo a localiza&a;ccedil;&a;atilde;o e a prote&a;ccedil;&a;atilde;o dos dados, o controlo operacional, as depend&a;ecirc;ncias tecnol&a;oacute;gicas e a exposi&a;ccedil;&a;atilde;o a jurisdi&a;ccedil;&a;otilde;es de pa&a;iacute;ses terceiros.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;O objetivo &a;eacute; disponibilizar um referencial comum que permita avaliar e comparar diferentes solu&a;ccedil;&a;otilde;es de&a;nbsp;Cloud&a;nbsp;e&a;nbsp;de Intelig&a;ecirc;ncia Artificial, em particular no contexto da Administra&a;ccedil;&a;atilde;o P&a;uacute;blica e de setores considerados cr&a;iacute;ticos.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;A abordagem proposta considera, assim, que a soberania dos servi&a;ccedil;os digitais envolve n&a;atilde;o apenas a localiza&a;ccedil;&a;atilde;o dos dados, mas tamb&a;eacute;m aspetos relacionados com o controlo das infraestruturas e dos servi&a;ccedil;os, as depend&a;ecirc;ncias tecnol&a;oacute;gicas e as condi&a;ccedil;&a;otilde;es jur&a;iacute;dicas aplic&a;aacute;veis.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:0}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:0}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;Cloud&a;nbsp;e Intelig&a;ecirc;ncia&a;nbsp;Artificial&a;nbsp;no setor p&a;uacute;blico&l;/span&g;&l;/strong&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;O CADA prev&a;ecirc; ainda mecanismos destinados a facilitar a ado&a;ccedil;&a;atilde;o de tecnologias de&a;nbsp;Cloud&a;nbsp;e Intelig&a;ecirc;ncia&a;nbsp;Artificial&a;nbsp;pelo setor p&a;uacute;blico.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;A Comiss&a;atilde;o pretende promover uma utiliza&a;ccedil;&a;atilde;o mais coordenada destas tecnologias nos Estados-Membros, tendo em conta aspetos como a seguran&a;ccedil;a, a soberania, a interoperabilidade e as depend&a;ecirc;ncias tecnol&a;oacute;gicas.&a;nbsp;Prev&a;ecirc; igualmente um quadro comum de contrata&a;ccedil;&a;atilde;o p&a;uacute;blica, destinado a refor&a;ccedil;ar a coordena&a;ccedil;&a;atilde;o entre administra&a;ccedil;&a;otilde;es e a mobilizar o seu poder de compra na aquisi&a;ccedil;&a;atilde;o de servi&a;ccedil;os de&a;nbsp;Cloud&a;nbsp;e IA.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;A proposta atribui tamb&a;eacute;m um papel relevante ao&a;nbsp;&l;/span&g;&l;strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;c&a;oacute;digo aberto&l;/span&g;&l;/strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;&a;nbsp;enquanto instrumento para&a;nbsp;refor&a;ccedil;ar a resili&a;ecirc;ncia,&a;nbsp;reduzir depend&a;ecirc;ncias&a;nbsp;tecnol&a;oacute;gicas e&a;nbsp;promover a&a;nbsp;interoperabilidade&a;nbsp;e a reutiliza&a;ccedil;&a;atilde;o de solu&a;ccedil;&a;otilde;es e componentes.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;Esta dimens&a;atilde;o articula-se com a Estrat&a;eacute;gia Europeia de C&a;oacute;digo Aberto, inclu&a;iacute;da no Pacote Europeu de Soberania Tecnol&a;oacute;gica.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:0}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:0}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;Portugal refor&a;ccedil;a a capacidade nacional de&a;nbsp;Cloud&a;nbsp;e centros de dados&l;/span&g;&l;/strong&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;A proposta europeia surge num momento em que Portugal est&a;aacute; igualmente a implementar medidas destinadas a desenvolver a capacidade das suas infraestruturas digitais e a refor&a;ccedil;ar a soberania e a resili&a;ecirc;ncia tecnol&a;oacute;gica.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;O&a;nbsp;&l;/span&g;&l;a href=\\\&q;https://digital.gov.pt/pt/estrategia-digital/plano-nacional-nuvem-soberana\\\&q;&g;&l;strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;Plano Nacional de Nuvem Soberana (PNNS)&l;/span&g;&l;/strong&g;&l;/a&g;&l;span data-contrast=\\\&q;none\\\&q;&g;&a;nbsp;foi aprovado pela&a;nbsp;&l;/span&g;&l;a href=\\\&q;https://diariodarepublica.pt/dr/detalhe/resolucao-conselho-ministros/102-2026-1126675659\\\&q;&g;&l;span data-contrast=\\\&q;none\\\&q;&g;Resolu&a;ccedil;&a;atilde;o do Conselho de Ministros n.&a;ordm; 102/2026, de 27 de maio&l;/span&g;&l;/a&g;&l;span data-contrast=\\\&q;none\\\&q;&g;. O plano estabelece uma estrat&a;eacute;gia para refor&a;ccedil;ar a soberania e a resili&a;ecirc;ncia digital do Estado, incluindo medidas relacionadas com o controlo e a prote&a;ccedil;&a;atilde;o de dados, sistemas e infraestruturas da Administra&a;ccedil;&a;atilde;o P&a;uacute;blica.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;O PNNS estabelece ainda um modelo de qualifica&a;ccedil;&a;atilde;o dos processos da Administra&a;ccedil;&a;atilde;o P&a;uacute;blica, considerando diferentes n&a;iacute;veis de criticidade e os correspondentes requisitos&a;nbsp;t&a;eacute;cnicos..&a;nbsp;A implementa&a;ccedil;&a;atilde;o envolve, entre outras entidades, a Ag&a;ecirc;ncia para a Reforma Tecnol&a;oacute;gica do Estado&a;nbsp;(ARTE), o Centro Nacional de&a;nbsp;Ciberseguran&a;ccedil;a, a ESPAP e a IP Telecom, com responsabilidades distintas na qualifica&a;ccedil;&a;atilde;o dos processos, na defini&a;ccedil;&a;atilde;o dos requisitos de soberania e seguran&a;ccedil;a, na contrata&a;ccedil;&a;atilde;o e no desenvolvimento da oferta nacional de nuvem soberana.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;Portugal disp&a;otilde;e tamb&a;eacute;m de um&a;nbsp;&l;/span&g;&l;a href=\\\&q;https://digital.gov.pt/pt/estrategia-digital/plano-nacional-de-centros-de-dados\\\&q;&g;&l;strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;Plano Nacional de Centros de Dados (PNCD)&l;/span&g;&l;/strong&g;&l;/a&g;&l;span data-contrast=\\\&q;none\\\&q;&g;, aprovado pela&a;nbsp;&l;/span&g;&l;a href=\\\&q;https://diariodarepublica.pt/dr/detalhe/resolucao-conselho-ministros/70-2026-1084345989\\\&q;&g;&l;span data-contrast=\\\&q;none\\\&q;&g;Resolu&a;ccedil;&a;atilde;o do Conselho de Ministros n.&a;ordm; 70/2026, de 13 de abril&l;/span&g;&l;/a&g;&l;span data-contrast=\\\&q;none\\\&q;&g;.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;O PNCD considera a capacidade computacional um ativo estrat&a;eacute;gico para a competitividade econ&a;oacute;mica, a transforma&a;ccedil;&a;atilde;o digital da Administra&a;ccedil;&a;atilde;o P&a;uacute;blica e a soberania digital. O plano estabelece medidas destinadas a promover o desenvolvimento de centros de dados no pa&a;iacute;s e a melhorar as condi&a;ccedil;&a;otilde;es para a instala&a;ccedil;&a;atilde;o destas infraestruturas.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;Entre as medidas previstas est&a;atilde;o a cria&a;ccedil;&a;atilde;o de zonas pr&a;eacute;-instaladas para centros de dados, a simplifica&a;ccedil;&a;atilde;o dos processos de licenciamento, o refor&a;ccedil;o da coordena&a;ccedil;&a;atilde;o institucional e a cria&a;ccedil;&a;atilde;o de um ponto &a;uacute;nico de contacto para investidores atrav&a;eacute;s da AICEP.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:0}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:0}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;Converg&a;ecirc;ncia entre as prioridades europeias e nacionais&l;/span&g;&l;/strong&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;As prioridades definidas no CADA apresentam pontos de contacto com as medidas previstas nos instrumentos nacionais, nomeadamente no que respeita ao desenvolvimento da capacidade computacional, &a;agrave;s infraestruturas digitais e &a;agrave; soberania tecnol&a;oacute;gica.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;Esta converg&a;ecirc;ncia n&a;atilde;o significa, contudo, que as iniciativas nacionais decorram da proposta europeia. O Plano Nacional de Nuvem Soberana e o Plano Nacional de Centros de Dados foram desenvolvidos e aprovados no &a;acirc;mbito das respetivas pol&a;iacute;ticas nacionais.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;A evolu&a;ccedil;&a;atilde;o do CADA poder&a;aacute;, ainda assim, assumir relev&a;acirc;ncia para Portugal, designadamente nas mat&a;eacute;rias relacionadas com a utiliza&a;ccedil;&a;atilde;o de servi&a;ccedil;os de&a;nbsp;Cloud&a;nbsp;e&a;nbsp;de&a;nbsp;Intelig&a;ecirc;ncia&a;nbsp;Artificial&a;nbsp;pela Administra&a;ccedil;&a;atilde;o P&a;uacute;blica, a avalia&a;ccedil;&a;atilde;o da soberania desses servi&a;ccedil;os e o desenvolvimento de capacidade computacional.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;A articula&a;ccedil;&a;atilde;o entre as pol&a;iacute;ticas nacionais e europeias poder&a;aacute; contribuir para uma maior coer&a;ecirc;ncia das abordagens adotadas nestas &a;aacute;reas, &a;agrave; medida que o quadro legislativo europeu for definido.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:0}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:0}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;Uma proposta&a;nbsp;da Comiss&a;atilde;o Europeia&l;/span&g;&l;/strong&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;O&a;nbsp;&l;/span&g;&l;a href=\\\&q;https://digital-strategy.ec.europa.eu/pt/policies/cloud-and-ai-development-act\\\&q;&g;&l;strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;Cloud&a;nbsp;and&a;nbsp;AI&a;nbsp;Development&a;nbsp;Act&l;/span&g;&l;/strong&g;&l;/a&g;&l;strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;&a;nbsp;&l;/span&g;&l;/strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;&a;nbsp;&a;eacute;&a;nbsp;uma proposta da Comiss&a;atilde;o Europeia que ser&a;aacute; apreciada no &a;acirc;mbito do processo legislativo ordin&a;aacute;rio, envolvendo o Parlamento Europeu e o Conselho.&a;nbsp;O procedimento legislativo&a;nbsp;&l;/span&g;&l;strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;2026/0138(COD)&l;/span&g;&l;/strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;&a;nbsp;encontra-se em curso e o conte&a;uacute;do da proposta poder&a;aacute; ser alterado durante as negocia&a;ccedil;&a;otilde;es entre as institui&a;ccedil;&a;otilde;es europeias.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;A proposta constitui, contudo, um desenvolvimento relevante da abordagem europeia &a;agrave; capacidade de computa&a;ccedil;&a;atilde;o, aos servi&a;ccedil;os de&a;nbsp;Cloud&a;nbsp;e &a;agrave; intelig&a;ecirc;ncia artificial. O enquadramento proposto procura articular o desenvolvimento de infraestruturas, a inova&a;ccedil;&a;atilde;o tecnol&a;oacute;gica, a efici&a;ecirc;ncia energ&a;eacute;tica, a utiliza&a;ccedil;&a;atilde;o de solu&a;ccedil;&a;otilde;es digitais pelo setor p&a;uacute;blico e a avalia&a;ccedil;&a;atilde;o da soberania dos servi&a;ccedil;os.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;Para Portugal, o acompanhamento deste processo ser&a;aacute; relevante no contexto da implementa&a;ccedil;&a;atilde;o do Plano Nacional de Nuvem Soberana e do Plano Nacional de Centros de Dados. A evolu&a;ccedil;&a;atilde;o do quadro europeu poder&a;aacute; contribuir para&a;nbsp;o&a;nbsp;estabelecimento&a;nbsp;de&a;nbsp;refer&a;ecirc;ncias comuns num dom&a;iacute;nio&a;nbsp;estrat&a;eacute;gico&a;nbsp;para a transforma&a;ccedil;&a;atilde;o digital da Administra&a;ccedil;&a;atilde;o P&a;uacute;blica, a competitividade econ&a;oacute;mica e o desenvolvimento da intelig&a;ecirc;ncia artificial.&l;/span&g;&l;/p&g;\&q;,\&q;css\&q;:null,\&q;isDetailSection\&q;:true},{\&q;schemaId\&q;:\&q;028343d6-580e-4a5f-a6a7-1c40243e6bee\&q;,\&q;schemaName\&q;:\&q;SeeAlsoComponent\&q;,\&q;label\&q;:\&q;Outros pontos de interesse\&q;,\&q;tags\&q;:[\&q;news\&q;],\&q;css\&q;:null}],\&q;seo\&q;:{\&q;title\&q;:\&q;Notícias\&q;,\&q;description\&q;:\&q;Conheça, ponto por ponto, tudo o que acontece sobre a digitalização e modernização da Administração Pública, em Portugal.\&q;},\&q;extras\&q;:{\&q;newsDetail\&q;:{\&q;title\&q;:\&q;Cloud and AI Development Act: a nova proposta europeia para Cloud, IA e soberania digital\&q;,\&q;slug\&q;:\&q;pt/noticias/cloud-and-ai-development-act\&q;,\&q;teaser\&q;:\&q;Comissão Europeia propõe reforçar os centros de dados, os serviços de Cloud e de IA.\&q;,\&q;image\&q;:[{\&q;id\&q;:\&q;e21db9d0-b281-4c6a-a8be-51784df2fcfa\&q;,\&q;mimeType\&q;:\&q;image/jpeg\&q;,\&q;url\&q;:\&q;https://bo.digital.gov.pt/api/assets/etic/e21db9d0-b281-4c6a-a8be-51784df2fcfa/\&q;,\&q;thumbnailUrl\&q;:\&q;https://bo.digital.gov.pt/api/assets/etic/e21db9d0-b281-4c6a-a8be-51784df2fcfa?width=100&a;mode=Max\&q;,\&q;fileName\&q;:\&q;Cloud and AI Development Act_PT.jpg\&q;,\&q;fileHash\&q;:\&q;wD37KKfZLCPkPsnc/qSGre3jW+kHt5jpha384MIaysI=\&q;,\&q;fileType\&q;:\&q;jpg\&q;,\&q;metadata\&q;:{\&q;pixelWidth\&q;:1366,\&q;pixelHeight\&q;:860,\&q;imageQuality\&q;:79,\&q;description\&q;:\&q;JFIF File\&q;}}],\&q;date\&q;:\&q;2026-09-17T00:00:00.000Z\&q;,\&q;readingTime\&q;:6,\&q;imageMobile\&q;:[{\&q;id\&q;:\&q;e21db9d0-b281-4c6a-a8be-51784df2fcfa\&q;,\&q;mimeType\&q;:\&q;image/jpeg\&q;,\&q;url\&q;:\&q;https://bo.digital.gov.pt/api/assets/etic/e21db9d0-b281-4c6a-a8be-51784df2fcfa/\&q;,\&q;thumbnailUrl\&q;:\&q;https://bo.digital.gov.pt/api/assets/etic/e21db9d0-b281-4c6a-a8be-51784df2fcfa?width=100&a;mode=Max\&q;,\&q;fileName\&q;:\&q;Cloud and AI Development Act_PT.jpg\&q;,\&q;fileHash\&q;:\&q;wD37KKfZLCPkPsnc/qSGre3jW+kHt5jpha384MIaysI=\&q;,\&q;fileType\&q;:\&q;jpg\&q;,\&q;metadata\&q;:{\&q;pixelWidth\&q;:1366,\&q;pixelHeight\&q;:860,\&q;imageQuality\&q;:79,\&q;description\&q;:\&q;JFIF File\&q;}}],\&q;body\&q;:\&q;&l;p&g;&l;span class=\\\&q;TextRun SCXW89048346 BCX8\\\&q; lang=\\\&q;PT-PT\\\&q; xml:lang=\\\&q;PT-PT\\\&q; data-contrast=\\\&q;none\\\&q;&g;&l;span class=\\\&q;NormalTextRun SCXW89048346 BCX8\\\&q;&g;A Comiss&a;atilde;o Europeia apresentou,&a;nbsp;&l;/span&g;&l;span class=\\\&q;NormalTextRun SCXW89048346 BCX8\\\&q;&g;no dia&l;/span&g;&l;span class=\\\&q;NormalTextRun SCXW89048346 BCX8\\\&q;&g;&a;nbsp;3 de junho de 2026, a proposta&a;nbsp;&l;/span&g;&l;/span&g;&l;a class=\\\&q;Hyperlink SCXW89048346 BCX8\\\&q; href=\\\&q;https://digital-strategy.ec.europa.eu/pt/library/proposal-cloud-and-ai-development-act-cada\\\&q; target=\\\&q;_blank\\\&q; rel=\\\&q;noreferrer noopener\\\&q;&g;&l;span class=\\\&q;TextRun Underlined SCXW89048346 BCX8\\\&q; lang=\\\&q;PT-PT\\\&q; xml:lang=\\\&q;PT-PT\\\&q; data-contrast=\\\&q;none\\\&q;&g;&l;span class=\\\&q;NormalTextRun SCXW89048346 BCX8\\\&q; data-ccp-charstyle=\\\&q;Hyperlink\\\&q;&g;Cloud&l;/span&g;&l;span class=\\\&q;NormalTextRun SCXW89048346 BCX8\\\&q; data-ccp-charstyle=\\\&q;Hyperlink\\\&q;&g;&a;nbsp;&l;/span&g;&l;span class=\\\&q;NormalTextRun SCXW89048346 BCX8\\\&q; data-ccp-charstyle=\\\&q;Hyperlink\\\&q;&g;and&l;/span&g;&l;span class=\\\&q;NormalTextRun SCXW89048346 BCX8\\\&q; data-ccp-charstyle=\\\&q;Hyperlink\\\&q;&g;&a;nbsp;AI&a;nbsp;&l;/span&g;&l;span class=\\\&q;NormalTextRun SCXW89048346 BCX8\\\&q; data-ccp-charstyle=\\\&q;Hyperlink\\\&q;&g;Development&l;/span&g;&l;span class=\\\&q;NormalTextRun SCXW89048346 BCX8\\\&q; data-ccp-charstyle=\\\&q;Hyperlink\\\&q;&g;&a;nbsp;&l;/span&g;&l;span class=\\\&q;NormalTextRun SCXW89048346 BCX8\\\&q; data-ccp-charstyle=\\\&q;Hyperlink\\\&q;&g;Act&l;/span&g;&l;span class=\\\&q;NormalTextRun SCXW89048346 BCX8\\\&q; data-ccp-charstyle=\\\&q;Hyperlink\\\&q;&g;&a;nbsp;(CADA)&l;/span&g;&l;/span&g;&l;/a&g;&l;span class=\\\&q;TextRun SCXW89048346 BCX8\\\&q; lang=\\\&q;PT-PT\\\&q; xml:lang=\\\&q;PT-PT\\\&q; data-contrast=\\\&q;none\\\&q;&g;&l;span class=\\\&q;NormalTextRun SCXW89048346 BCX8\\\&q;&g;,&a;nbsp;&l;/span&g;&l;span class=\\\&q;NormalTextRun SCXW89048346 BCX8\\\&q;&g;que estabelece um novo enquadramento europeu para aumentar a capacidade de computa&a;ccedil;&a;atilde;o em nuvem e de intelig&a;ecirc;ncia artificial&l;/span&g;&l;span class=\\\&q;NormalTextRun SCXW89048346 BCX8\\\&q;&g;,&a;nbsp;&l;/span&g;&l;span class=\\\&q;NormalTextRun SCXW89048346 BCX8\\\&q;&g;promover o investimento em infraestruturas digitais e contribuir para a soberania tecnol&a;oacute;gica da Uni&a;atilde;o Europeia.&l;/span&g;&l;/span&g;&l;span class=\\\&q;EOP Selected SCXW89048346 BCX8\\\&q; data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\&q;,\&q;htmlFullWidth\&q;:null,\&q;alignment\&q;:null,\&q;category\&q;:{\&q;id\&q;:\&q;4fa18209-2ee3-4fb4-b02a-1a8133cff737\&q;,\&q;name\&q;:\&q;transformacao-digital\&q;,\&q;title\&q;:\&q;Transformação Digital\&q;,\&q;status\&q;:\&q;PUBLISHED\&q;},\&q;tags\&q;:[\&q;Inteligência Artificial\&q;,\&q;IA\&q;,\&q;Cloud\&q;,\&q;Nuvem Soberana\&q;,\&q;Soberania Digital\&q;,\&q;União Europeia\&q;],\&q;additionalContents\&q;:null,\&q;sectionNews\&q;:[{\&q;schemaId\&q;:\&q;3f4d3254-f642-46c5-a2a0-9a4ed5581378\&q;,\&q;schemaName\&q;:\&q;HtmlComponent\&q;,\&q;htmlFullWidth\&q;:null,\&q;alignment\&q;:null,\&q;content\&q;:\&q;&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;A proposta surge num contexto de crescimento da procura por capacidade computacional, impulsionada&a;nbsp;pela expans&a;atilde;o da intelig&a;ecirc;ncia artificial, e da necessidade de assegurar infraestruturas adequadas ao desenvolvimento e &a;agrave; utiliza&a;ccedil;&a;atilde;o destas tecnologias. Entre as medidas previstas encontram-se o aumento da capacidade dos centros de dados europeus, a cria&a;ccedil;&a;atilde;o de um quadro comum para avaliar a soberania dos servi&a;ccedil;os de&a;nbsp;Cloud&a;nbsp;e&a;nbsp;de Intelig&a;ecirc;ncia Artificial&a;nbsp;e mecanismos destinados a facilitar a ado&a;ccedil;&a;atilde;o destas tecnologias pelo setor p&a;uacute;blico.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;O CADA integra o&a;nbsp;&l;/span&g;&l;a href=\\\&q;https://digital.gov.pt/pt/noticias/pacote-para-reforco-da-soberania-tecnologica-da-europa\\\&q;&g;&l;strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;Pacote Europeu de Soberania Tecnol&a;oacute;gica&l;/span&g;&l;/strong&g;&l;/a&g;&l;span data-contrast=\\\&q;none\\\&q;&g;, apresentado pela Comiss&a;atilde;o Europeia na mesma data, que inclui tamb&a;eacute;m o&a;nbsp;&l;/span&g;&l;a href=\\\&q;https://digital-strategy.ec.europa.eu/pt/library/proposal-chips-act-20\\\&q;&g;&l;strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;Chips&a;nbsp;Act&a;nbsp;2.0&l;/span&g;&l;/strong&g;&l;/a&g;&l;span data-contrast=\\\&q;none\\\&q;&g;, a Estrat&a;eacute;gia Europeia de C&a;oacute;digo Aberto e um roteiro para a digitaliza&a;ccedil;&a;atilde;o e a intelig&a;ecirc;ncia artificial no setor da energia.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:0}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:0}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;Aumentar a capacidade europeia de computa&a;ccedil;&a;atilde;o&l;/span&g;&l;/strong&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;auto\\\&q;&g;O aumento da capacidade computacional &a;eacute; considerado pela Comiss&a;atilde;o uma condi&a;ccedil;&a;atilde;o necess&a;aacute;ria para acompanhar a evolu&a;ccedil;&a;atilde;o da intelig&a;ecirc;ncia artificial&a;nbsp;(IA)&a;nbsp;e assegurar recursos adequados a empresas, investigadores e entidades p&a;uacute;blicas.&a;nbsp;A Comiss&a;atilde;o estabelece&a;nbsp;como&a;nbsp;objetivo, pelo menos, triplicar a capacidade dos centros de dados da Uni&a;atilde;o Europeia&a;nbsp;nos pr&a;oacute;ximos cinco a sete anos.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;Neste contexto, a expans&a;atilde;o&a;nbsp;das&a;nbsp;infraestruturas&a;nbsp;de&a;nbsp;Cloud&a;nbsp;dever&a;aacute; complementar o desenvolvimento das&a;nbsp;&l;/span&g;&l;a href=\\\&q;https://digital-strategy.ec.europa.eu/pt/policies/ai-factories\\\&q;&g;&l;strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;AI&a;nbsp;Factories&l;/span&g;&l;/strong&g;&l;/a&g;&l;span data-contrast=\\\&q;none\\\&q;&g;&a;nbsp;e das&a;nbsp;&l;/span&g;&l;a href=\\\&q;https://commission.europa.eu/topics/competitiveness/competitiveness-coordination-tool-projects/ai-gigafactories_en?prefLang=pt\\\&q;&g;&l;strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;AI&a;nbsp;Gigafactories&l;/span&g;&l;/strong&g;&l;/a&g;&l;span data-contrast=\\\&q;none\\\&q;&g;, permitindo disponibilizar recursos computacionais a diferentes escalas e para&a;nbsp;m&a;uacute;ltiplas&a;nbsp;utiliza&a;ccedil;&a;otilde;es.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;A proposta prev&a;ecirc; igualmente medidas destinadas a facilitar o desenvolvimento de centros de dados na Uni&a;atilde;o Europeia, incluindo mecanismos para acelerar determinados projetos e criar condi&a;ccedil;&a;otilde;es mais favor&a;aacute;veis &a;agrave; instala&a;ccedil;&a;atilde;o de infraestruturas consideradas estrat&a;eacute;gicas.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;A efici&a;ecirc;ncia energ&a;eacute;tica constitui outra das dimens&a;otilde;es&a;nbsp;cr&a;iacute;ticas&a;nbsp;no desenvolvimento desta capacidade. O aumento da computa&a;ccedil;&a;atilde;o associada &a;agrave;&a;nbsp;IA&a;nbsp;intensifica&a;nbsp;a procura de energia,&a;nbsp;tornando relevante a ado&a;ccedil;&a;atilde;o de solu&a;ccedil;&a;otilde;es que&a;nbsp;promovam centros de dados mais eficientes no uso da&a;nbsp;energia&a;nbsp;e da &a;aacute;gua, incentivem a reutiliza&a;ccedil;&a;atilde;o de calor residual e melhorem a integra&a;ccedil;&a;atilde;o&a;nbsp;destas&a;nbsp;infraestruturas&a;nbsp;no sistema&a;nbsp;energ&a;eacute;tico.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:0}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:0}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;Quadro&a;nbsp;europeu para avaliar a soberania dos servi&a;ccedil;os de&a;nbsp;Cloud&a;nbsp;e IA&l;/span&g;&l;/strong&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;Uma das principais componentes do CADA &a;eacute; a cria&a;ccedil;&a;atilde;o de um&a;nbsp;&l;/span&g;&l;strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;quadro europeu de avalia&a;ccedil;&a;atilde;o da soberania dos servi&a;ccedil;os de&a;nbsp;Cloud&a;nbsp;e&a;nbsp;de&a;nbsp;IA&l;/span&g;&l;/strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;A proposta pretende estabelecer crit&a;eacute;rios comuns para avaliar diferentes dimens&a;otilde;es da soberania dos servi&a;ccedil;os, incluindo a localiza&a;ccedil;&a;atilde;o e a prote&a;ccedil;&a;atilde;o dos dados, o controlo operacional, as depend&a;ecirc;ncias tecnol&a;oacute;gicas e a exposi&a;ccedil;&a;atilde;o a jurisdi&a;ccedil;&a;otilde;es de pa&a;iacute;ses terceiros.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;O objetivo &a;eacute; disponibilizar um referencial comum que permita avaliar e comparar diferentes solu&a;ccedil;&a;otilde;es de&a;nbsp;Cloud&a;nbsp;e&a;nbsp;de Intelig&a;ecirc;ncia Artificial, em particular no contexto da Administra&a;ccedil;&a;atilde;o P&a;uacute;blica e de setores considerados cr&a;iacute;ticos.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;A abordagem proposta considera, assim, que a soberania dos servi&a;ccedil;os digitais envolve n&a;atilde;o apenas a localiza&a;ccedil;&a;atilde;o dos dados, mas tamb&a;eacute;m aspetos relacionados com o controlo das infraestruturas e dos servi&a;ccedil;os, as depend&a;ecirc;ncias tecnol&a;oacute;gicas e as condi&a;ccedil;&a;otilde;es jur&a;iacute;dicas aplic&a;aacute;veis.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:0}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:0}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;Cloud&a;nbsp;e Intelig&a;ecirc;ncia&a;nbsp;Artificial&a;nbsp;no setor p&a;uacute;blico&l;/span&g;&l;/strong&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;O CADA prev&a;ecirc; ainda mecanismos destinados a facilitar a ado&a;ccedil;&a;atilde;o de tecnologias de&a;nbsp;Cloud&a;nbsp;e Intelig&a;ecirc;ncia&a;nbsp;Artificial&a;nbsp;pelo setor p&a;uacute;blico.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;A Comiss&a;atilde;o pretende promover uma utiliza&a;ccedil;&a;atilde;o mais coordenada destas tecnologias nos Estados-Membros, tendo em conta aspetos como a seguran&a;ccedil;a, a soberania, a interoperabilidade e as depend&a;ecirc;ncias tecnol&a;oacute;gicas.&a;nbsp;Prev&a;ecirc; igualmente um quadro comum de contrata&a;ccedil;&a;atilde;o p&a;uacute;blica, destinado a refor&a;ccedil;ar a coordena&a;ccedil;&a;atilde;o entre administra&a;ccedil;&a;otilde;es e a mobilizar o seu poder de compra na aquisi&a;ccedil;&a;atilde;o de servi&a;ccedil;os de&a;nbsp;Cloud&a;nbsp;e IA.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;A proposta atribui tamb&a;eacute;m um papel relevante ao&a;nbsp;&l;/span&g;&l;strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;c&a;oacute;digo aberto&l;/span&g;&l;/strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;&a;nbsp;enquanto instrumento para&a;nbsp;refor&a;ccedil;ar a resili&a;ecirc;ncia,&a;nbsp;reduzir depend&a;ecirc;ncias&a;nbsp;tecnol&a;oacute;gicas e&a;nbsp;promover a&a;nbsp;interoperabilidade&a;nbsp;e a reutiliza&a;ccedil;&a;atilde;o de solu&a;ccedil;&a;otilde;es e componentes.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;Esta dimens&a;atilde;o articula-se com a Estrat&a;eacute;gia Europeia de C&a;oacute;digo Aberto, inclu&a;iacute;da no Pacote Europeu de Soberania Tecnol&a;oacute;gica.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:0}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:0}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;Portugal refor&a;ccedil;a a capacidade nacional de&a;nbsp;Cloud&a;nbsp;e centros de dados&l;/span&g;&l;/strong&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;A proposta europeia surge num momento em que Portugal est&a;aacute; igualmente a implementar medidas destinadas a desenvolver a capacidade das suas infraestruturas digitais e a refor&a;ccedil;ar a soberania e a resili&a;ecirc;ncia tecnol&a;oacute;gica.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;O&a;nbsp;&l;/span&g;&l;a href=\\\&q;https://digital.gov.pt/pt/estrategia-digital/plano-nacional-nuvem-soberana\\\&q;&g;&l;strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;Plano Nacional de Nuvem Soberana (PNNS)&l;/span&g;&l;/strong&g;&l;/a&g;&l;span data-contrast=\\\&q;none\\\&q;&g;&a;nbsp;foi aprovado pela&a;nbsp;&l;/span&g;&l;a href=\\\&q;https://diariodarepublica.pt/dr/detalhe/resolucao-conselho-ministros/102-2026-1126675659\\\&q;&g;&l;span data-contrast=\\\&q;none\\\&q;&g;Resolu&a;ccedil;&a;atilde;o do Conselho de Ministros n.&a;ordm; 102/2026, de 27 de maio&l;/span&g;&l;/a&g;&l;span data-contrast=\\\&q;none\\\&q;&g;. O plano estabelece uma estrat&a;eacute;gia para refor&a;ccedil;ar a soberania e a resili&a;ecirc;ncia digital do Estado, incluindo medidas relacionadas com o controlo e a prote&a;ccedil;&a;atilde;o de dados, sistemas e infraestruturas da Administra&a;ccedil;&a;atilde;o P&a;uacute;blica.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;O PNNS estabelece ainda um modelo de qualifica&a;ccedil;&a;atilde;o dos processos da Administra&a;ccedil;&a;atilde;o P&a;uacute;blica, considerando diferentes n&a;iacute;veis de criticidade e os correspondentes requisitos&a;nbsp;t&a;eacute;cnicos..&a;nbsp;A implementa&a;ccedil;&a;atilde;o envolve, entre outras entidades, a Ag&a;ecirc;ncia para a Reforma Tecnol&a;oacute;gica do Estado&a;nbsp;(ARTE), o Centro Nacional de&a;nbsp;Ciberseguran&a;ccedil;a, a ESPAP e a IP Telecom, com responsabilidades distintas na qualifica&a;ccedil;&a;atilde;o dos processos, na defini&a;ccedil;&a;atilde;o dos requisitos de soberania e seguran&a;ccedil;a, na contrata&a;ccedil;&a;atilde;o e no desenvolvimento da oferta nacional de nuvem soberana.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;Portugal disp&a;otilde;e tamb&a;eacute;m de um&a;nbsp;&l;/span&g;&l;a href=\\\&q;https://digital.gov.pt/pt/estrategia-digital/plano-nacional-de-centros-de-dados\\\&q;&g;&l;strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;Plano Nacional de Centros de Dados (PNCD)&l;/span&g;&l;/strong&g;&l;/a&g;&l;span data-contrast=\\\&q;none\\\&q;&g;, aprovado pela&a;nbsp;&l;/span&g;&l;a href=\\\&q;https://diariodarepublica.pt/dr/detalhe/resolucao-conselho-ministros/70-2026-1084345989\\\&q;&g;&l;span data-contrast=\\\&q;none\\\&q;&g;Resolu&a;ccedil;&a;atilde;o do Conselho de Ministros n.&a;ordm; 70/2026, de 13 de abril&l;/span&g;&l;/a&g;&l;span data-contrast=\\\&q;none\\\&q;&g;.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;O PNCD considera a capacidade computacional um ativo estrat&a;eacute;gico para a competitividade econ&a;oacute;mica, a transforma&a;ccedil;&a;atilde;o digital da Administra&a;ccedil;&a;atilde;o P&a;uacute;blica e a soberania digital. O plano estabelece medidas destinadas a promover o desenvolvimento de centros de dados no pa&a;iacute;s e a melhorar as condi&a;ccedil;&a;otilde;es para a instala&a;ccedil;&a;atilde;o destas infraestruturas.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;Entre as medidas previstas est&a;atilde;o a cria&a;ccedil;&a;atilde;o de zonas pr&a;eacute;-instaladas para centros de dados, a simplifica&a;ccedil;&a;atilde;o dos processos de licenciamento, o refor&a;ccedil;o da coordena&a;ccedil;&a;atilde;o institucional e a cria&a;ccedil;&a;atilde;o de um ponto &a;uacute;nico de contacto para investidores atrav&a;eacute;s da AICEP.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:0}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:0}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;Converg&a;ecirc;ncia entre as prioridades europeias e nacionais&l;/span&g;&l;/strong&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;As prioridades definidas no CADA apresentam pontos de contacto com as medidas previstas nos instrumentos nacionais, nomeadamente no que respeita ao desenvolvimento da capacidade computacional, &a;agrave;s infraestruturas digitais e &a;agrave; soberania tecnol&a;oacute;gica.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;Esta converg&a;ecirc;ncia n&a;atilde;o significa, contudo, que as iniciativas nacionais decorram da proposta europeia. O Plano Nacional de Nuvem Soberana e o Plano Nacional de Centros de Dados foram desenvolvidos e aprovados no &a;acirc;mbito das respetivas pol&a;iacute;ticas nacionais.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;A evolu&a;ccedil;&a;atilde;o do CADA poder&a;aacute;, ainda assim, assumir relev&a;acirc;ncia para Portugal, designadamente nas mat&a;eacute;rias relacionadas com a utiliza&a;ccedil;&a;atilde;o de servi&a;ccedil;os de&a;nbsp;Cloud&a;nbsp;e&a;nbsp;de&a;nbsp;Intelig&a;ecirc;ncia&a;nbsp;Artificial&a;nbsp;pela Administra&a;ccedil;&a;atilde;o P&a;uacute;blica, a avalia&a;ccedil;&a;atilde;o da soberania desses servi&a;ccedil;os e o desenvolvimento de capacidade computacional.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;A articula&a;ccedil;&a;atilde;o entre as pol&a;iacute;ticas nacionais e europeias poder&a;aacute; contribuir para uma maior coer&a;ecirc;ncia das abordagens adotadas nestas &a;aacute;reas, &a;agrave; medida que o quadro legislativo europeu for definido.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:0}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:0}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;Uma proposta&a;nbsp;da Comiss&a;atilde;o Europeia&l;/span&g;&l;/strong&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;O&a;nbsp;&l;/span&g;&l;a href=\\\&q;https://digital-strategy.ec.europa.eu/pt/policies/cloud-and-ai-development-act\\\&q;&g;&l;strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;Cloud&a;nbsp;and&a;nbsp;AI&a;nbsp;Development&a;nbsp;Act&l;/span&g;&l;/strong&g;&l;/a&g;&l;strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;&a;nbsp;&l;/span&g;&l;/strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;&a;nbsp;&a;eacute;&a;nbsp;uma proposta da Comiss&a;atilde;o Europeia que ser&a;aacute; apreciada no &a;acirc;mbito do processo legislativo ordin&a;aacute;rio, envolvendo o Parlamento Europeu e o Conselho.&a;nbsp;O procedimento legislativo&a;nbsp;&l;/span&g;&l;strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;2026/0138(COD)&l;/span&g;&l;/strong&g;&l;span data-contrast=\\\&q;none\\\&q;&g;&a;nbsp;encontra-se em curso e o conte&a;uacute;do da proposta poder&a;aacute; ser alterado durante as negocia&a;ccedil;&a;otilde;es entre as institui&a;ccedil;&a;otilde;es europeias.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;A proposta constitui, contudo, um desenvolvimento relevante da abordagem europeia &a;agrave; capacidade de computa&a;ccedil;&a;atilde;o, aos servi&a;ccedil;os de&a;nbsp;Cloud&a;nbsp;e &a;agrave; intelig&a;ecirc;ncia artificial. O enquadramento proposto procura articular o desenvolvimento de infraestruturas, a inova&a;ccedil;&a;atilde;o tecnol&a;oacute;gica, a efici&a;ecirc;ncia energ&a;eacute;tica, a utiliza&a;ccedil;&a;atilde;o de solu&a;ccedil;&a;otilde;es digitais pelo setor p&a;uacute;blico e a avalia&a;ccedil;&a;atilde;o da soberania dos servi&a;ccedil;os.&l;/span&g;&l;span data-ccp-props=\\\&q;{&a;quot;335559739&a;quot;:120}\\\&q;&g;&a;nbsp;&l;/span&g;&l;/p&g;\\n&l;p&g;&l;span data-contrast=\\\&q;none\\\&q;&g;Para Portugal, o acompanhamento deste processo ser&a;aacute; relevante no contexto da implementa&a;ccedil;&a;atilde;o do Plano Nacional de Nuvem Soberana e do Plano Nacional de Centros de Dados. A evolu&a;ccedil;&a;atilde;o do quadro europeu poder&a;aacute; contribuir para&a;nbsp;o&a;nbsp;estabelecimento&a;nbsp;de&a;nbsp;refer&a;ecirc;ncias comuns num dom&a;iacute;nio&a;nbsp;estrat&a;eacute;gico&a;nbsp;para a transforma&a;ccedil;&a;atilde;o digital da Administra&a;ccedil;&a;atilde;o P&a;uacute;blica, a competitividade econ&a;oacute;mica e o desenvolvimento da intelig&a;ecirc;ncia artificial.&l;/span&g;&l;/p&g;\&q;,\&q;css\&q;:null}],\&q;seo\&q;:{\&q;title\&q;:\&q;Cloud and AI Development Act: a nova proposta europeia para Cloud, IA e soberania digital \&q;,\&q;description\&q;:\&q;Comissão Europeia propõe reforçar os centros de dados, os serviços de Cloud e de IA.\&q;,\&q;image\&q;:{\&q;id\&q;:\&q;e21db9d0-b281-4c6a-a8be-51784df2fcfa\&q;,\&q;mimeType\&q;:\&q;image/jpeg\&q;,\&q;url\&q;:\&q;https://bo.digital.gov.pt/api/assets/etic/e21db9d0-b281-4c6a-a8be-51784df2fcfa/\&q;,\&q;thumbnailUrl\&q;:\&q;https://bo.digital.gov.pt/api/assets/etic/e21db9d0-b281-4c6a-a8be-51784df2fcfa?width=100&a;mode=Max\&q;,\&q;fileName\&q;:\&q;Cloud and AI Development Act_PT.jpg\&q;,\&q;fileHash\&q;:\&q;wD37KKfZLCPkPsnc/qSGre3jW+kHt5jpha384MIaysI=\&q;,\&q;fileType\&q;:\&q;jpg\&q;,\&q;metadata\&q;:{\&q;pixelWidth\&q;:1366,\&q;pixelHeight\&q;:860,\&q;imageQuality\&q;:79,\&q;description\&q;:\&q;JFIF File\&q;}}},\&q;created\&q;:\&q;2026-09-02T15:15:14.000Z\&q;,\&q;lastModified\&q;:\&q;2026-09-17T07:00:09.000Z\&q;},\&q;seeAlsoNews\&q;:[{\&q;title\&q;:\&q;Regulamento Europeu de Inteligência Artificial revisto: novos prazos e novas regras\&q;,\&q;slug\&q;:\&q;pt/noticias/regulamento-europeu-de-inteligencia-artificial-novos-prazos-e-novas-regras\&q;,\&q;teaser\&q;:\&q;A revisão do Regulamento Europeu de IA altera prazos e introduz novas regras.\&q;,\&q;image\&q;:[{\&q;id\&q;:\&q;7eb84033-1634-48d8-b367-5976e23393f2\&q;,\&q;mimeType\&q;:\&q;image/jpeg\&q;,\&q;url\&q;:\&q;https://bo.digital.gov.pt/api/assets/etic/7eb84033-1634-48d8-b367-5976e23393f2/\&q;,\&q;thumbnailUrl\&q;:\&q;https://bo.digital.gov.pt/api/assets/etic/7eb84033-1634-48d8-b367-5976e23393f2?width=100&a;mode=Max\&q;,\&q;fileName\&q;:\&q;Regulamento Europeu de Inteligência Artificial.jpg\&q;,\&q;fileHash\&q;:\&q;NKysoz1C3Y3mg1Ltrc1HnrCdg1aCWqoTEa7PSwV88+Y=\&q;,\&q;fileType\&q;:\&q;jpg\&q;,\&q;metadata\&q;:{\&q;pixelWidth\&q;:1366,\&q;pixelHeight\&q;:860,\&q;imageQuality\&q;:79,\&q;description\&q;:\&q;JFIF File\&q;}}],\&q;date\&q;:\&q;2026-09-10T00:00:00.000Z\&q;,\&q;readingTime\&q;:5,\&q;imageMobile\&q;:[{\&q;id\&q;:\&q;7eb84033-1634-48d8-b367-5976e23393f2\&q;,\&q;mimeType\&q;:\&q;image/jpeg\&q;,\&q;url\&q;:\&q;https://bo.digital.gov.pt/api/assets/etic/7eb84033-1634-48d8-b367-5976e23393f2/\&q;,\&q;thumbnailUrl\&q;:\&q;https://bo.digital.gov.pt/api/assets/etic/7eb84033-1634-48d8-b367-5976e23393f2?width=100&a;mode=Max\&q;,\&q;fileName\&q;:\&q;Regulamento Europeu de Inteligência Artificial.jpg\&q;,\&q;fileHash\&q;:\&q;NKysoz1C3Y3mg1Ltrc1HnrCdg1aCWqoTEa7PSwV88+Y=\&q;,\&q;fileType\&q;:\&q;jpg\&q;,\&q;metadata\&q;:{\&q;pixelWidth\&q;:1366,\&q;pixelHeight\&q;:860,\&q;imageQuality\&q;:79,\&q;description\&q;:\&q;JFIF File\&q;}}],\&q;body\&q;:\&q;\&q;,\&q;htmlFullWidth\&q;:null,\&q;alignment\&q;:null,\&q;category\&q;:{\&q;id\&q;:\&q;de5509e2-7817-47ce-a49a-e2f7fee5d4bd\&q;,\&q;name\&q;:\&q;legislacao\&q;,\&q;title\&q;:\&q;Legislação\&q;,\&q;status\&q;:\&q;PUBLISHED\&q;},\&q;tags\&q;:[\&q;Inteligência Artificial\&q;,\&q;IA\&q;,\&q;Ai ACT\&q;,\&q;União Europeia\&q;],\&q;additionalContents\&q;:null,\&q;sectionNews\