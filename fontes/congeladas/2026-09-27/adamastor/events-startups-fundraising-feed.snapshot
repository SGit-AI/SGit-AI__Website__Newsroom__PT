    <item>
      <title>Startup Guide Summit • 9/11/2026 • Lisbon</title>
      <link>https://summit.startupguide.com/?utm_source=adamastor.blog&amp;utm_medium=rss&amp;utm_campaign=rss_events_startups-fundraising</link>
      <guid isPermaLink="false">https://adamastor.blog/events#event-1136</guid>
      <pubDate>Mon, 20 Jul 2026 18:04:28 GMT</pubDate>
      <description>Startup Guide Summit 2026 returns — spotlighting top founders, ecosystems &amp; local heroes. Join 200+ leaders for an afternoon of inspiration, workshops &amp; networking at Casa do Impacto, in Lisbon.</description>
