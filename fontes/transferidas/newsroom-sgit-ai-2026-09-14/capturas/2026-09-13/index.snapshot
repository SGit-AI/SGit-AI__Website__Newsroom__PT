    <script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"When is Startup Summit Lisbon 2026?","acceptedAnswer":{"@type":"Answer","text":"Startup Summit Lisbon 2026 takes place on September 17–18, 2026."}},{"@type":"Question","name":"Where is Startup Summit held?","acceptedAnswer":{"@type":"Answer","text":"At Beato Innovation District, Av. Infante Dom Henrique 143, 1950-406 Lisbon, Portugal."}},{"@type":"Question","name":"How much do tickets cost?","acceptedAnswer":{"@type":"Answer","text":"General Pass starts at €49, Founder Pass from €99, Startup Booth from €199, Investor Pass from €199, VIP from €249. Prices rise in phases."}},{"@type":"Question","name":"Who is speaking at Startup Summit?","acceptedAnswer":{"@type":"Answer","text":"150+ speakers planned from 40+ countries — founders, investors and operators, including confirmed speakers Anmol Goel, Paulo Andrez, Stephanie Melodia and Ana Barjasic."}},{"@type":"Question","name":"Is Startup Summit worth attending?","acceptedAnswer":{"@type":"Answer","text":"It is curated for high-signal founder-investor matchmaking. The target audience is founders, operators, startup teams, angels, VC funds and ecosystem partners — built for qualified introductions and pitching opportunities for early-stage startups."}},{"@type":"Question","name":"What kind of European startup conference is Startup Summit?","acceptedAnswer":{"@type":"Answer","text":"Startup Summit is a founder-first European startup conference, intentionally curated and targeting 2,000+ founders, investors and operators — designed for qualified founder-investor connections rather than scale. Tickets start at €49."}},{"@type":"Question","name":"Who organises Startup Summit?","acceptedAnswer":{"@type":"Answer","text":"Founded and organised by Ricardo Pascual, who has run founder-focused events across Europe since 2019 under the StartUp Events brand."}},{"@type":"Question","name":"Can I exhibit 