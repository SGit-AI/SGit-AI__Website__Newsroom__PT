        letter-spacing: 0.14em; text-transform: uppercase;
        cursor: pointer;
      }
      #hero-static .hm-scroll svg { animation: hmBob 1.8s ease-in-out infinite; }
      @keyframes hmBob {
        0%, 100% { transform: translateY(0); }
