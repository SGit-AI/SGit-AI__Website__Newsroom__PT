      /* Promo strip — rainbow cycle */
      @keyframes hmPromoRainbowText {
        0%   { color: #FFCF00; }
        16%  { color: #FF8400; }
        33%  { color: #FF5A5A; }
        50%  { color: #FF78C1; }
        66%  { color: #8B7CFF; }
        83%  { color: #35D0FF; }
        100% { color: #FFCF00; }
      }
      @keyframes hmPromoRainbowBg {
        0%   { background: #FFCF00; border-color: #FFCF00; }
