        padding: 0.75rem 1rem;
        background: #141414;
        color: #FFCF00;
        border: 2px solid #FFCF00;
        border-radius: 9999px;
        font-family: 'Roboto', system-ui, sans-serif;
        font-weight: 900; font-size: 13px;
        letter-spacing: 0.06em; text-transform: uppercase;
        white-space: nowrap;
        opacity: 0;
        transition: transform 0.35s cubic-bezier(0.2, 0.9, 0.3, 1.2), opacity 0.25s ease;
        pointer-events: none;
      }
      #hm-promo-toast.is-visible { transform: translate(-50%, 0); opacity: 1; }
      #hm-promo-toast .hm-toast-check {
        display: inline-flex; align-items: center; justify-content: center;
        width: 18px; height: 18px;
        background: #FFCF00; color: #141414;
        border-radius: 9999px;
        font-size: 12px; font-weight: 900;
      }
      @keyframes hmPromoPulse {
        0%   { box-shadow: 0 0 0 0 rgba(255,207,0,0.85); }
        70%  { box-shadow: 0 0 0 10px rgba(255,207,0,0); }
        100% { box-shadow: 0 0 0 0 rgba(255,207,0,0); }
      }

      /* Primary CTA */
      #hero-static .hm-cta {
        position: relative; z-index: 2;
        display: flex; align-items: center; justify-content: center; gap: 0.6rem;
        text-align: center;
        width: 100%;
        padding: 1.15rem 1.35rem;
        background: #FFCF00;
        color: #141414;
        font-family: 'Roboto', system-ui, sans-serif;
        font-weight: 900; font-size: 1.02rem;
        text-transform: uppercase; letter-spacing: 0.02em;
        text-decoration: none;
        border-radius: 18px;
        box-shadow: 0 14px 30px -14px rgba(255,207,0,0.6);
        transition: transform 150ms ease, background 150ms ease;
