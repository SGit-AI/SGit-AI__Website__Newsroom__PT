  <body>
    <!-- Metricool tracking pixel — deferred until after window.onload so it never blocks LCP or eats bandwidth on first paint -->
    <img aria-hidden="true" data-deferred-tracker="true" data-src="https://tracker.metricool.com/c3po.jpg?hash=4c824e9344097ca76a273471126b5e20" alt="" width="1" height="1" style="position:absolute;width:1px;height:1px;opacity:0;pointer-events:none;" />
    <script>
      window.addEventListener('load', function () {
        document.querySelectorAll('img[data-deferred-tracker]').forEach(function (img) {
          var src = img.getAttribute('data-src');
          if (src) img.src = src;
        });
      });
    </script>
    <style>
      /* ============================================================
         CRITICAL CSS — inlined so the static hero paints instantly
         (LCP element) without waiting for the main index-*.css bundle.
         Scoped to #hero-static so React sections below are unaffected.
         ============================================================ */
      @font-face {
        font-family: 'Big Shoulders Display';
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src: url('/fonts/big-shoulders-display/latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      html, body { margin: 0; }
      body { font-family: system-ui, -apple-system, 'Segoe UI', sans-serif; }
      /* Scope hero pre-hydration colors so admin/other routes aren't tinted. */
      #hero-static { color: #fff;
        position: relative;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        overflow: hidden;
        background: #141414; }
      #hero-static .hero-bg { position: absolute; inset: 0; }
      #hero-static .hero-bg img { position: absolute; inset: 0; width: 100%; height: 100%; -o-object-fit: cover; object-fit: cover; }
      #hero-static .hero-video {
        position: absolute; inset: 0; width: 100%; height: 100%; -o-object-fit: cover; object-fit: cover;
        opacity: 0; transition: opacity 600ms ease-in;
        display: block;
      }
      #hero-static .hero-video.is-ready { opacity: 1; }
      @media (prefers-reduced-motion: reduce) {
        #hero-static .hero-video { display: none !important; }
      }
      #hero-static .hero-overlay-1 { position: absolute; inset: 0; background: rgba(20,20,20,0.30); }
      #hero-static .hero-overlay-2 { position: absolute; inset: 0; background: linear-gradient(to right, rgba(20,20,20,0.85), rgba(20,20,20,0.45) 50%, transparent); }
      #hero-static .hero-overlay-3 { position: absolute; inset: 0; background: linear-gradient(to top, rgba(20,20,20,0.70), transparent 50%, transparent); }

      #hero-static .hero-inner {
        position: relative;
        z-index: 10;
        width: 100%;
        max-width: 80rem;
        margin: 0 auto;
        padding: 8rem 1rem 4rem;
        flex: 1;
        display: flex;
        flex-direction: column;
      }
      #hero-static .hero-logo-wrap { width: 100%; display: flex; justify-content: center; }
      #hero-static .hero-logo { width: 97px; max-width: 32vw; height: auto; }
      #hero-static .hero-content {
        margin-top: 2.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      #hero-static .hero-block {
        max-width: 950px;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
      }

      #hero-static .sr-only {
        position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
        overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
      }

      /* Live pill */
      #hero-static .hero-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.375rem 0.875rem;
        border-radius: 9999px;
        margin-bottom: 1.5rem;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.15);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
      }
      #hero-static .hero-pill .dot-wrap { position: relative; display: inline-flex; width: 0.5rem; height: 0.5rem; }
      #hero-static .hero-pill .dot-ping {
        position: absolute; inset: 0;
        border-radius: 9999px;
        background: #1951FF;
        opacity: 0.75;
        animation: hero-ping 1.4s cubic-bezier(0,0,0.2,1) infinite;
      }
      #hero-static .hero-pill .dot-core {
        position: relative;
        display: inline-flex;
        width: 0.5rem; height: 0.5rem;
        border-radius: 9999px;
        background: #1951FF;
      }
      #hero-static .hero-pill .pill-text {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        color: rgba(255,255,255,0.80);
      }
      @keyframes hero-ping {
        75%, 100% { transform: scale(2); opacity: 0; }
      }
      @media (prefers-reduced-motion: reduce) {
        #hero-static .hero-pill .dot-ping { animation: none; }
      }

      /* Hero headline (visually H1, semantic div to keep a single <h1> per
         document — the semantic H1 lives in the noscript block / React tree). */
      #hero-static .hero-h1 {
        font-family: 'Big Shoulders Display', Oswald, 'Arial Narrow', system-ui, sans-serif;
        font-weight: 700;
        color: #fff;
        font-size: 2.25rem;
        line-height: 0.95;
        letter-spacing: -0.02em;
        text-wrap: balance;
        margin: 0 0 1.5rem;
      }
      #hero-static .hero-h1 .h1-red {
        display: block;
        margin-top: 0.25rem;
        color: #1951FF;
      }

      /* Subheading */
      #hero-static .hero-sub {
        font-size: 1rem;
        color: rgba(255,255,255,0.90);
        line-height: 1.625;
        max-width: 680px;
        margin: 0 0 2rem;
      }

      /* CTA row */
      #hero-static .hero-cta-row {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        width: 100%;
      }
      #hero-static .hero-cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 3.5rem;
        padding: 0 2rem;
        border-radius: 9999px;
        font-size: 1rem;
        font-weight: 500;
        text-decoration: none;
        white-space: nowrap;
        transition: transform 200ms ease, box-shadow 200ms ease, background 200ms ease;
      }
      #hero-static .hero-cta-primary {
        background: #FFCF00;
        color: #1a1a1a;
        box-shadow: 0 20px 25px -5px rgba(255, 207, 0, 0.40), 0 8px 10px -6px rgba(255, 207, 0, 0.40);
      }
      #hero-static .hero-cta-primary:hover { transform: translateY(-2px); box-shadow: 0 25px 50px -12px rgba(255, 207, 0, 0.50); }
      #hero-static .hero-cta-primary .arrow { margin-left: 0.5rem; width: 20px; height: 20px; }
      #hero-static .hero-cta-secondary {
        display: none;
        background: rgba(255,255,255,0.05);
        color: #fff;
        border: 1px solid rgba(255,255,255,0.30);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
      }
      #hero-static .hero-cta-secondary:hover { background: rgba(255,255,255,0.15); transform: translateY(-2px); }

      /* Microcopy */
      #hero-static .hero-microcopy {
        margin: 1.25rem 0 0;
        font-size: 0.875rem;
        color: rgba(255,255,255,0.70);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        letter-spacing: 0.025em;
      }

      /* Breakpoint: sm (640px) — reveal secondary CTA in a row */
      @media (min-width: 640px) {
        #hero-static .hero-logo { width: 122px; }
        #hero-static .hero-h1 { font-size: 3rem; }
        #hero-static .hero-sub { font-size: 1.125rem; }
        #hero-static .hero-cta-row { flex-direction: row; gap: 1rem; width: auto; }
        #hero-static .hero-cta-secondary { display: inline-flex; }
        #hero-static .hero-cta { font-size: 1.125rem; }

      }
      /* Breakpoint: md (768px) */
      @media (min-width: 768px) {
        #hero-static .hero-inner { padding: 11rem 2rem 5rem; }
        #hero-static .hero-logo { width: 154px; }
        #hero-static .hero-content { margin-top: 4rem; }
        #hero-static .hero-h1 { font-size: 3.75rem; }
        #hero-static .hero-sub { font-size: 1.25rem; }
      }
      /* Breakpoint: lg (1024px) */
      @media (min-width: 1024px) {
        #hero-static .hero-logo { width: 178px; }
        #hero-static .hero-h1 { font-size: 4.5rem; }
      }

      /* ============================================================
         MOBILE-ONLY "Blueprint Record Breaker" hero
         Replaces the standard hero on ≤768px, hides on desktop.
         ============================================================ */
      #hero-static .hero-mobile { display: none; }
      @media (max-width: 768px) {
        #hero-static { min-height: 100svh; }
        #hero-static .hero-inner { display: none !important; }
        #hero-static .hero-mobile { display: flex; }
        /* Darker scrim over the video so the hero copy stays legible */
        #hero-static .hero-overlay-1 { background: rgba(20,20,20,0.55); }
        #hero-static .hero-overlay-2 { background: linear-gradient(to bottom, rgba(20,20,20,0.35), rgba(20,20,20,0.75)); }
        #hero-static .hero-overlay-3 { background: linear-gradient(to top, rgba(20,20,20,0.85), transparent 55%); }
