    <!-- Preconnect to font origins so the browser opens TLS connections in parallel with HTML parse -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Metricool tracker: warm the connection early, actual pixel loads after window.onload -->
    <link rel="preconnect" href="https://tracker.metricool.com" crossorigin />
    <link rel="dns-prefetch" href="https://tracker.metricool.com" />

    <!-- Big Shoulders Display is self-hosted (see @font-face in src/index.css) so titles
         never fall back to Impact when Google Fonts is blocked (Brave, adblockers, corp networks).
         Preload the latin subset so the first paint uses the real face, not the fallback. -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/big-shoulders-display/latin.woff2" crossorigin />

    <!-- Preload the LCP hero poster for both mobile and desktop -->
    <link rel="preload" as="image" href="/__l5e/assets-v1/133f5ca1-fd0d-4812-88be-21ee53017da9/hero-mobile-poster.webp" media="(max-width: 768px)" fetchpriority="high" />
    <link rel="preload" as="image" href="/__l5e/assets-v1/bfb21d41-8eb9-472e-b22f-c6fbf9d18c66/hero-desktop-poster.webp" media="(min-width: 769px)" fetchpriority="high" />

    <!-- Roboto / Roboto Mono still loaded from Google Fonts (body copy tolerates the swap). -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&family=Roboto+Mono:wght@400;500;700&display=swap" media="print" onload="this.media='all'" />

    
    <!-- Default title/meta managed by react-helmet-async per page -->
    
    <!-- Canonical injected per-route by the prerender plugin and react-helmet-async (SEO component). Do NOT add a hardcoded canonical here — it would duplicate the per-route one during SPA navigation. -->
    <meta name="msvalidate.01" content="5E3B581134F736773AFD09F83D8582BE" />

    <!-- Robots / indexing hints -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Open Graph (Facebook, LinkedIn, WhatsApp, iMessage, Slack) -->
    <!-- hreflang alternates for language targeting -->
    <!-- Twitter / X -->
    <!-- Static JSON-LD for crawlers -->
    <!-- Apollo.io tracker: loaded at runtime after cookie consent (see src/lib/consent.ts) -->
    <script type="module" crossorigin src="/assets/index-Lgeca2QE.js"></script>
    <link rel="preload" as="style" crossorigin href="/assets/index-oqrbFuV7.css" onload="this.onload=null;this.rel='stylesheet'"><noscript><link rel="stylesheet" crossorigin href="/assets/index-oqrbFuV7.css"></noscript>
