  <body>
    <!-- Metricool tracking pixel — deferred until after window.onload so it never blocks LCP or eats bandwidth on first paint -->
    <img aria-hidden="true" data-deferred-tracker="true" data-src="https://tracker.metricool.com/c3po.jpg?hash=4c824e9344097ca76a273471126b5e20" alt="" width="1" height="1" style="position:absolute;width:1px;height:1px;opacity:0;pointer-events:none;" />
    <script>
      window.addEventListener('load', function () {
        document.querySelectorAll('img[data-deferred-tracker]').forEach(function (img) {
          var src = img.getAttribute('data-src');
          if (src) img.src = src;
        });
      });
    </script>
    <!-- Static hero: raw HTML, rendered before React parses/mounts, so Chrome
         credits this H1 paint as LCP. Hidden on non-homepage routes by the
         one-liner script directly below (and by App.tsx on client-side nav). -->
    <script>
      /* Hide the static hero when a non-homepage route was requested (direct
         hit to /agenda, /tickets, etc.). This is not a router / CTA script —
         it only toggles display of a decorative block. React re-toggles on
         client-side route changes via a useEffect in App.tsx. */
      (function(){var p=location.pathname;if(p!=='/'&&p!=='/index.html'){var h=document.getElementById('hero-static');if(h)h.style.display='none';}})();

      /* "20% Off" chip → persist SPECIAL20 promo, show toast, then hand off to /tickets?ref=SPECIAL20.
         The promo stays in localStorage until we clear it, so the site can auto-apply on return visits. */
      (function(){
        var btn = document.getElementById('hm-promo-apply');
        var toast = document.getElementById('hm-promo-toast');
        if (!btn) return;
        btn.addEventListener('click', function(e){
          e.preventDefault();
          e.stopPropagation();
          try {
            localStorage.setItem('ss_promo_code', 'SPECIAL20');
            localStorage.setItem('ss_promo_code_at', String(Date.now()));
          } catch (_) {}
          if (toast) {
            toast.classList.add('is-visible');
          }
          if (window.dataLayer) {
            window.dataLayer.push({ event: 'promo_apply_click', promo_code: 'SPECIAL20', source: 'mobile_hero' });
          }
          setTimeout(function(){
            window.location.href = '/tickets?ref=SPECIAL20';
          }, 900);
        });
      })();

      /* Mobile hero daily variant tracking. We ship one new mobile hero per
         day this week and compare day-over-day, so we just stamp the variant
         id on the document and report impressions/clicks to the dataLayer. */
      (function(){
        try {
          if (!window.matchMedia('(max-width: 767px)').matches) return;
          var hero = document.querySelector('#hero-static .hero-mobile');
          if (!hero) return;
          var v = hero.getAttribute('data-hero-variant') || 'unknown';
          document.documentElement.setAttribute('data-hero-variant', v);

          if (window.dataLayer) {
            window.dataLayer.push({ event: 'hero_variant_shown', variant: v, surface: 'mobile' });
          }
          var push = function(source){
            if (window.dataLayer) {
              window.dataLayer.push({ event: 'hero_variant_cta_click', variant: v, surface: 'mobile', source: source });
            }
          };
          var cta = hero.querySelector('.hm-cta');
          if (cta) cta.addEventListener('click', function(){ push('primary_cta'); });
          var tap = hero.querySelector('.hm-tap-anywhere');
          if (tap) tap.addEventListener('click', function(){ push('tap_anywhere'); });
        } catch (_) {}
      })();

      /* Scroll cue — ads now land on the homepage, so nudge people into the
         content below the fold instead of bouncing on the first screen. */
      (function(){
        var btn = document.getElementById('hm-scroll-cue');
        if (!btn) return;
        btn.addEventListener('click', function(e){
          e.preventDefault();
          e.stopPropagation();
          var hero = document.getElementById('hero-static');
          var top = hero ? hero.getBoundingClientRect().bottom + window.scrollY : window.innerHeight;
          window.scrollTo({ top: top, behavior: 'smooth' });
          if (window.dataLayer) window.dataLayer.push({ event: 'hero_scroll_cue_click', surface: 'mobile' });
        });
      })();


      /* Lazy-attach the hero video on desktop only, after the poster paints,
         so it never blocks LCP and mobile devices never download the MP4. */
      (function(){
        try {
          var p = location.pathname;
          if (p !== '/' && p !== '/index.html') return;
          var rm = window.matchMedia('(prefers-reduced-motion: reduce)');
          if (rm.matches) return;
          var v = document.querySelector('#hero-static .hero-video');
          if (!v) return;
          var start = function(){
            if (v.dataset.loaded) return;
            v.dataset.loaded = '1';
            var src = document.createElement('source');
            src.src = '/__l5e/assets-v1/fc52f4b0-f8a0-4f53-9785-0d8d002c4fb5/hero-event-video.mp4';
            src.type = 'video/mp4';
            v.appendChild(src);
            v.load();
            v.addEventListener('playing', function(){ v.classList.add('is-ready'); }, { once: true });
            var pl = v.play();
            if (pl && pl.catch) pl.catch(function(){});
          };
          if ('requestIdleCallback' in window) {
            requestIdleCallback(start, { timeout: 1500 });
          } else {
            setTimeout(start, 800);
          }
        } catch(e){}
      })();
    </script>
    <div id="root"></div>


    
