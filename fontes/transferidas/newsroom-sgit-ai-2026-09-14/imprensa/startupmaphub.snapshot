<style>
  .bn-footer {
    background: linear-gradient(135deg, var(--brand-deep) 0%, #061116 100%);
    position: relative;
    overflow: hidden;
    color: #fff;
    font-family: 'Outfit', sans-serif;
  }

  .bn-footer::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -20%;
    width: 80%;
    height: 200%;
    background: radial-gradient(circle, rgba(45, 212, 191, 0.08) 0%, transparent 60%);
    pointer-events: none;
  }
  
  .bn-footer::after {
    content: '';
    position: absolute;
    bottom: -50%;
    right: -20%;
    width: 80%;
    height: 200%;
    background: radial-gradient(circle, rgba(14, 165, 233, 0.08) 0%, transparent 60%);
    pointer-events: none;
  }

  .bn-footer-badge {
    display: inline-block;
    background: linear-gradient(135deg, #2dd4bf 0%, #0ea5e9 100%);
    color: #000;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 6px 14px;
    border-radius: 20px;
    box-shadow: 0 4px 12px rgba(45, 212, 191, 0.3);
  }

  .bn-footer-title {
    color: #fff;
    letter-spacing: -0.02em;
    text-shadow: 0 2px 10px rgba(0,0,0,0.5);
  }

  .bn-footer-text {
    color: rgba(255, 255, 255, 0.8);
    font-family: 'Proxima Nova', sans-serif;
  }

  .bn-footer-cta {
    color: #12222a;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .bn-footer-cta:hover {
    background: #fff;
    color: #000;
    transform: translateY(-4px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.2), 0 0 15px rgba(255,255,255,0.2);
  }

  .footer-links a {
    transition: color 0.2s;
  }
  .footer-links a:hover {
