<script>
// Use event delegation for Turbo compatibility (handles initial load + navs)
document.addEventListener('click', function(e) {
  
  // 1. Copy Link Logic
  var copyBtn = e.target.closest('[data-copy-link]');
  if (copyBtn) {
    var url = copyBtn.getAttribute("data-copy-link");
    function showCopied() {
      var original = copyBtn.innerHTML;
      copyBtn.innerHTML = '<i class="bi bi-check2"></i>';
      setTimeout(function() { copyBtn.innerHTML = original; }, 2000);
    }

    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(url).then(showCopied);
    } else {
      var textarea = document.createElement("textarea");
      textarea.value = url;
      textarea.style.position = "fixed";
      document.body.appendChild(textarea);
      textarea.select();
      try { document.execCommand("copy"); } catch (e) {}
      document.body.removeChild(textarea);
      showCopied();
    }
  }

  // 2. Save as Image Logic
  var saveBtn = e.target.closest('#btn-save-image');
  if (saveBtn) {
    if (saveBtn.disabled) return;
    
    console.log("Save Image clicked");
    var originalText = saveBtn.innerHTML;
    saveBtn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Saving...';
    saveBtn.disabled = true;

    var card = document.getElementById('share-card');
    if (!card) {
      console.error("Share card element not found");
      alert("Error: Share card template missing.");
      saveBtn.innerHTML = originalText;
      saveBtn.disabled = false;
      return;
    }
    
    if (typeof html2canvas === 'undefined') {
       console.error("html2canvas is undefined");
       alert("Library not loaded. Please wait a moment or refresh.");
       saveBtn.innerHTML = originalText;
       saveBtn.disabled = false;
       return;
    }

    // Small timeout to allow UI update
    setTimeout(function() {
      html2canvas(card, {
        scale: 2, 
        useCORS: true, 
        backgroundColor: "#ffffff",
        logging: true // Enable logging for debug
      }).then(function(canvas) {
        console.log("Canvas generated");
        var link = document.createElement('a');
        link.download = "startup-map-event-startup-summit-lisbon-2026.png";
        link.href = canvas.toDataURL("image/png");
        link.click();
        
        saveBtn.innerHTML = originalText;
        saveBtn.disabled = false;
      }).catch(function(err){
        console.error("html2canvas error:", err);
        alert("Detailed Error: " + err.message);
        saveBtn.innerHTML = "Error";
        setTimeout(function() { saveBtn.innerHTML = originalText; saveBtn.disabled = false; }, 2000);
      });
    }, 100);
  }
});
</script>


