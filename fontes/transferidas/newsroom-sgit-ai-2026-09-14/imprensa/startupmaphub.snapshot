    <!-- Brand palette + nav/footer styling -->
    <style>
      :root{
        --nav-offset: 56px;
        --brand-teal: #008080;
        --brand-primary: #008080;
        --brand-deep: #1B3A4B;
        --brand-ink:#12222A;
      }
      body {
        font-family: 'Proxima Nova', sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      .min-w-0 { min-width: 0; }

      .nav-gradient{
        background: linear-gradient(135deg, var(--brand-teal) 0%, var(--brand-deep) 100%);
        border-bottom: none;
      }
      .nav-gradient .navbar-brand,
      .nav-gradient .nav-link{
        color:#fff;
        white-space: nowrap;
      }
      .nav-gradient .nav-link:hover{ color:#f5faff; }
      .nav-gradient .navbar-toggler{ border-color:rgba(255,255,255,.35); }
      .nav-gradient .navbar-toggler-icon{ filter: invert(1); }

      /* Active link */
      .nav-gradient .nav-link.active{
        color:#fff;
        position:relative;
      }
      .nav-gradient .nav-link.active::after{
        content:"";
        position:absolute;
        left:.5rem; right:.5rem; bottom:-.35rem;
        height:2px; border-radius:2px;
        background:rgba(255,255,255,.9);
      }

      /* Light ghost button for navbar */
      .btn-ghost-light{
        background:transparent;border:1px solid rgba(255,255,255,.35);color:#fff;
      }
      .btn-ghost-light:hover{ background:rgba(255,255,255,.08); border-color:#fff; color:#fff; }

      /* Footer */
      .footer-accent{ background: linear-gradient(135deg, var(--brand-teal) 0%, var(--brand-deep) 100%); }
      .footer-dark{ background:#0e1a20; color:#c7d0d3; }
      .footer-dark a{ color:#c7d0d3; text-decoration:none; }
      .footer-dark a:hover{ color:#ffffff; }
      /* Opt-in per page: hide the footer on mobile only. */
      @media (max-width: 767.98px){ .footer--hide-mobile{ display:none; } }

      .sticky-filters { position: sticky; top: var(--nav-offset); z-index: 1020; }
      thead.sticky-top th { top: var(--nav-offset); } /* table header under navbar */

    </style>

    

