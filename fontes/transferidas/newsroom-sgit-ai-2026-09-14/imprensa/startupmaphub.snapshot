<style>
  .hero-mini{background:linear-gradient(135deg,#008080 0%,#1B3A4B 100%);color:#fff;}
  .aura{position:relative}
  .aura::before{content:"";position:absolute;inset:-2px;z-index:0;border-radius:1rem;background:conic-gradient(from 180deg at 50% 50%,#00b3b3,#1B3A4B,#00b3b3);filter:blur(18px);opacity:.25}
  .aura>.content{position:relative;z-index:1}

  /* Premium Guide Enhancement */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1.5rem;
    margin: 2rem 0;
  }
  .metric-card {
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(0, 128, 128, 0.1);
    border-radius: 1.25rem;
    padding: 1.5rem;
    text-align: center;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
  }
  .metric-card:hover { 
    transform: translateY(-5px);
    background: #fff;
    border-color: #008080;
    box-shadow: 0 10px 25px rgba(0, 128, 128, 0.1);
  }
  .metric-value { font-size: 1.75rem; font-weight: 800; color: #1B3A4B; line-height: 1.2; margin-bottom: 0.25rem; }
  .metric-label { font-size: 0.85rem; color: #6c757d; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; }

  .timeline-expert { position: relative; padding-left: 2rem; border-left: 2px solid #e9ecef; }
  .timeline-item-ex { position: relative; padding-bottom: 2.5rem; }
  .timeline-item-ex::before {
    content: "";
    position: absolute;
    left: calc(-2rem - 6px);
    top: 0;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #008080;
    border: 3px solid #fff;
    box-shadow: 0 0 0 2px #008080;
  }
  .pro-con-card { border-radius: 1rem; border: none; height: 100%; transition: transform 0.2s; }
  .pro-con-card:hover { transform: scale(1.02); }
  .verdict-box {
    background: linear-gradient(135deg, #1B3A4B 0%, #008080 100%);
    color: #fff;
    border-radius: 1.5rem;
    padding: 2rem;
    position: relative;
    overflow: hidden;
  }
  .verdict-box::after {
    content: "\F272"; /* bi-award */
    font-family: bootstrap-icons;
    position: absolute;
    right: -20px;
    bottom: -20px;
    font-size: 8rem;
    opacity: 0.1;
  }
</style>




<section class="hero-mini py-4 border-bottom">
  <div class="container d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
    <div>
      <h1 class="h3 fw-semibold mb-1">Startup Summit Lisbon 2026</h1>
      <div class="small opacity-75">
        <span class="badge bg-light text-dark me-2">Upcoming</span>
          September 17, 2026
           – September 18, 2026
         • Unicorn Factory - Beato Innovation District, Avenida Infante Dom Henrique 143, Lisboa, 1950-406, Lisbon, Portugal
      </div>
    </div>

    <div class="d-flex flex-column align-items-end gap-2">
      <!-- Share actions -->
      <div class="d-flex flex-wrap gap-2 align-items-center small justify-content-end">
        <span class="text-white opacity-75 me-1">Share:</span>

        <button type="button" class="btn btn-outline-light btn-sm" data-copy-link="https://startupmaphub.com/events/startup-summit-lisbon-2026?utm_source=share&amp;utm_medium=copy&amp;utm_campaign=event" aria-label="Copy Link">
          <i class="bi bi-clipboard"></i>
        </button>

        <!-- Save as Image -->
        <button type="button" class="btn btn-light btn-sm fw-semibold text-dark" id="btn-save-image">
          <i class="bi bi-card-image me-1"></i>Download details
        </button>
      </div>
    </div>
  </div>
</section>


<div class="container py-4">
  
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3 p-md-4">
      

      
<div class="pro-conversion-area my-5 py-4">
  <div class="row g-4">
    
    <div class="col-md-6">
      <div class="conversion-card pitch-deck-card h-100 p-4 rounded-4 shadow-lg border-0 aura position-relative overflow-hidden">
        <div class="content position-relative z-1 d-flex flex-column h-100">
          <div class="d-flex align-items-center justify-content-between mb-3">
            <span class="badge bg-dark text-light text-uppercase fw-bold p-2 " style="font-size: 0.7rem; letter-spacing: 0.5px;">
              Pitch Deck
            </span>
          </div>

          <h3 class="h4 fw-bold text-white mb-3">
            Raising Capital at Startup Summit Lisbon 2026?
          </h3>

          <p class="text-white mb-4 flex-grow-1" style="font-size: 0.95rem; line-height: 1.6;">
            Don't walk into meetings with a generic deck. See what's included in the full package.
          </p>

          <div class="mt-auto">
            <a class="btn btn-light btn-lg rounded-pill px-4 fw-bold shadow-sm d-inline-flex align-items-center gap-2 w-100 justify-content-center" data-track="event_conversion_click" data-type="pitch_deck" data-event="Startup Summit Lisbon 2026" href="/pricing">
              View Full Pricing Packages <i class="bi bi-arrow-right"></i>
</a>          </div>
        </div>

      </div>
    </div>

    <div class="col-md-6">
      <div class="conversion-card concierge-card h-100 p-4 rounded-4 shadow-lg border-0 aura position-relative overflow-hidden">
        <div class="content position-relative z-1 d-flex flex-column h-100">
          <div class="d-flex align-items-center justify-content-between mb-3">
            <span class="badge bg-dark text-light text-uppercase fw-bold p-2 " style="font-size: 0.7rem; letter-spacing: 0.5px;">
              Application Drafting
            </span>
          </div>

          <h3 class="h4 fw-bold text-white mb-3">
            Your Next Application, Half-Written.
          </h3>

          <p class="text-white mb-4 flex-grow-1" style="font-size: 0.95rem; line-height: 1.6;">
            Skip the 4-hour draft. We generate answers for Baobab, Antler, and 30+ programs directly from your pitch deck — one account, one package.
          </p>

          <div class="mt-auto">
            <a class="btn btn-warning btn-lg rounded-pill px-4 fw-bold shadow-sm d-inline-flex align-items-center gap-2 w-100 justify-content-center" data-track="event_conversion_click" data-type="application_assistant" data-event="Startup Summit Lisbon 2026" href="/pricing">
              View Full Pricing Packages <i class="bi bi-magic"></i>
</a>          </div>
        </div>

      </div>
    </div>

  </div>
</div>

<style>
  .pro-conversion-area {
    --pitch-gradient: linear-gradient(135deg, #008080 0%, #1B3A4B 100%);
    --concierge-gradient: linear-gradient(135deg, #1B3A4B 0%, #2c3e50 100%);
  }

  .conversion-card {
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease;
    min-height: 320px;
  }

  .conversion-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 30px 60px rgba(0,0,0,0.3);
  }

  .pitch-deck-card {
    background: var(--pitch-gradient);
    border: 1px solid rgba(255,255,255,0.1) !important;
  }

  .concierge-card {
    background: var(--concierge-gradient);
    border: 1px solid rgba(255,255,255,0.1) !important;
  }

  /* Refine Aura for cards */
  .conversion-card.aura::before {
    opacity: 0.1;
    filter: blur(25px);
  }

  .conversion-card .btn-light {
    color: #008080 !important;
  }

  .conversion-card .btn-warning {
    background-color: #f1c40f !important;
    border: none;
    color: #1B3A4B !important;
  }

  /* Concierge Slide-in Widget (Phase 3) */
  .concierge-slide-in {
    position: fixed;
    bottom: 30px;
    right: -400px;
    width: 320px;
    background: white;
    box-shadow: 0 15px 40px rgba(0,0,0,0.2);
    border-radius: 20px;
    z-index: 1050;
    transition: right 0.6s cubic-bezier(0.77, 0, 0.175, 1);
  }

  .concierge-slide-in.show {
    right: 30px;
  }
</style>

<div id="conciergeSlideIn" class="concierge-slide-in p-3 d-none d-md-block border">
  <div class="d-flex align-items-start gap-3">
    <div class="bg-primary bg-opacity-10 text-primary p-2 rounded-circle">
      <i class="bi bi-lightning-charge-fill"></i>
    </div>
    <div>
      <div class="d-flex justify-content-between align-items-center mb-1">
        <h6 class="fw-bold mb-0">Event Special</h6>
        <button type="button" class="btn-close small" style="font-size: 0.6rem;" onclick="document.getElementById('conciergeSlideIn').classList.remove('show')"></button>
      </div>
      <p class="small text-muted mb-2">
        Apply to programs like Baobab or Antler in minutes. Get your first draft for <strong>Startup Summit Lisbon 2026</strong> readiness.
      </p>
      <a class="btn btn-primary btn-sm rounded-pill px-3 fw-bold" data-track="event_conversion_click" data-type="concierge_widget" data-event="Startup Summit Lisbon 2026" href="/pricing">View Full Pricing Packages</a>
    </div>
  </div>
</div>

